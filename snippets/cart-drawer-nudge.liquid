{%- comment -%}
  Next-tier nudge under a one-time bundle row of the cart drawer. Shown only when the next tier up
  (Theme settings → Bundle tiers) costs the same as the bottles in the cart or less, so stopping
  short of it buys nothing: 2 bottles cost what 3 do (Buy 2, Get 1 Free), 4 what 6 do, and 5 cost
  more than 6. The copy is built from the tier and the predicted prices
  (snippets/bundle-tier-price.liquid); the button tops the row up to the tier and never acts on
  its own.

  quantity     bottles in the row
  unit         the row's one-time price per bottle (cents)
  order_keep   what an order-level percentage code leaves, in parts per million (1000000 = no
               code): a code like EXTRA10 takes the same share off the bottles added, so the
               saving quoted is what the order total actually drops by
  free_one, free_many, save, button   copy from the drawer's settings; {count} is the bottles to
               add, {amount} the saving, {total} the tier's bottle count
{%- endcomment -%}
{%- liquid
  assign next_total = 0
  for slot in (1..4)
    assign slot_key = 'bundle_tier_' | append: slot
    assign paid_key = slot_key | append: '_paid'
    assign free_key = slot_key | append: '_free'
    assign slot_paid = settings[paid_key] | default: 0
    assign slot_free = settings[free_key] | default: 0
    assign slot_total = slot_paid | plus: slot_free
    if slot_paid > 0 and slot_total > quantity
      if next_total == 0 or slot_total < next_total
        assign next_total = slot_total
      endif
    endif
  endfor
  assign nudge_text = ''
  if next_total > 0
    capture now_price
      render 'bundle-tier-price', quantity: quantity, unit: unit
    endcapture
    capture next_price
      render 'bundle-tier-price', quantity: next_total, unit: unit
    endcapture
    assign now_price = now_price | plus: 0
    assign next_price = next_price | plus: 0
    assign extra = next_total | minus: quantity
    if next_price == now_price
      if extra == 1
        assign nudge_text = free_one | replace: '{count}', extra
      else
        assign nudge_text = free_many | replace: '{count}', extra
      endif
    elsif next_price < now_price
      assign saving = now_price | minus: next_price | times: order_keep | plus: 500000 | divided_by: 1000000
      assign saving_money = saving | money
      assign nudge_text = save | replace: '{count}', extra | replace: '{amount}', saving_money
    endif
    assign nudge_button = button | replace: '{total}', next_total
  endif
-%}
{%- if nudge_text != blank -%}
<div class="line-item__nudge" data-cart-nudge>
  <p class="line-item__nudge-text">{{ nudge_text }}</p>
  <button type="button" class="line-item__nudge-button" data-cart-group-fill="{{ next_total }}">{{ nudge_button }}</button>
</div>
{%- endif -%}
