{%- comment -%}
  Button for the comparison advertorial, with an optional italic line above it and a guarantee
  line below it. Links that contain # scroll to that anchor on the page.
  {% render 'adv-cta', label: 'Shop now', url: '#shop', lead: 'Still reading?', note: '30-day money-back guarantee', attrs: block.shopify_attributes %}
{%- endcomment -%}
{%- assign href = url | default: '#shop' -%}
<div class="adv-cta{% if class != blank %} {{ class }}{% endif %}" {{ attrs }}>
  {%- if lead != blank -%}<p class="adv-cta__lead">{{ lead }}</p>{%- endif -%}
  <a class="adv-btn" href="{{ href }}"{% if href contains '#' %} data-scroll-to="{{ href | split: '#' | last }}"{% endif %}>{{ label }}</a>
  {%- if note != blank -%}
    <p class="adv-cta__note">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 4 5v6c0 5.1 3.4 9.5 8 11 4.6-1.5 8-5.9 8-11V5l-8-3Zm-1.1 14.2-3.6-3.6 1.4-1.4 2.2 2.2 4.9-4.9 1.4 1.4-6.3 6.3Z"/></svg>
      <span>{{ note }}</span>
    </p>
  {%- endif -%}
</div>
