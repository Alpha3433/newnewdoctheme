{%- comment -%}
  Soft tile with a bottle outline, shown in place of a product photo until one is uploaded.
  {% render 'adv-placeholder', label: 'Rosemary oil serum', tone: 2 %}   tone: 1 to 4
{%- endcomment -%}
<div class="adv-ph adv-ph--{{ tone | default: 1 }}" role="img" aria-label="{{ label | escape }}">
  <svg viewBox="0 0 40 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="15" y="2" width="10" height="12" rx="4"/><path d="M13 14h14v7H13z"/><rect x="7" y="21" width="26" height="40" rx="7"/><path d="M7 37h26"/></svg>
  {%- if label != blank -%}<span>{{ label }}</span>{%- endif -%}
</div>
