<div class="product-card">
  <a class="product-card__media" href="{{ routes.root_url }}#shop" data-scroll-to="shop">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 1000px) 25vw, 50vw', alt: product.featured_image.alt | escape }}
    {%- endif -%}
  </a>
  <a class="product-card__title" href="{{ routes.root_url }}#shop" data-scroll-to="shop">{{ product.title }}</a>
  <div class="product-card__price">
    {% render 'money', amount: product.price %}
    {%- if product.compare_at_price > product.price -%}<s>{% render 'money', amount: product.compare_at_price %}</s>{%- endif -%}
  </div>
</div>
