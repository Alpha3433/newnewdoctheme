<!doctype html>
{% capture text_direction %}{% render 'text-direction' %}{% endcapture -%}
<html lang="{{ request.locale.iso_code }}" dir="{{ text_direction }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {%- if text_direction == 'rtl' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap">
  {%- endif %}
  {{ 'critical.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {%- if text_direction == 'rtl' %}
  {{ 'rtl.css' | asset_url | stylesheet_tag }}
  {%- endif %}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main class="password-page">
    {{ content_for_layout }}
  </main>
</body>
</html>
