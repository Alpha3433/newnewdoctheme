<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}" dir="ltr" data-froya-nav="b">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#1f1f1f">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Caveat:wght@400..700&display=swap">

  {{ 'critical.css' | asset_url | stylesheet_tag }}
  {{ 'blaze.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'sections-inline.css' | asset_url | stylesheet_tag }}
  {{ 'sections.css' | asset_url | stylesheet_tag }}

  <script>
    window.Shopify = window.Shopify || {};
    window.Shopify.routes = window.Shopify.routes || {};
    window.Shopify.routes.root = '{{ routes.root_url }}';
    window.theme = { moneyFormat: {{ shop.money_format | json }} };
  </script>

  {{ content_for_header }}
</head>

<body class="no-focus-outline features--image-zoom template-{{ request.page_type | handle }}{% if template.suffix %} template-{{ request.page_type | handle }}--{{ template.suffix | handle }}{% endif %}">
  {% render 'froya-svg-defs' %}

  {% sections 'header-group' %}

  <div id="main" class="anchor" role="main">
    {{ content_for_layout }}
  </div>

  {% sections 'footer-group' %}

  <script src="{{ 'blaze-slider.min.js' | asset_url }}" defer></script>
  <script src="{{ 'main.js' | asset_url }}" defer></script>
</body>
</html>
