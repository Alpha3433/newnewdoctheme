<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}" dir="ltr" data-froya-nav="b" data-country="{{ localization.country.iso_code }}" data-currency="{{ localization.country.currency.iso_code }}">
<head>
  <meta charset="utf-8">
  {%- comment -%}
    The store sells from the home page only, so product pages (reached from Google Shopping, order
    emails, the Shop app…) send the visitor straight to the home page. A theme cannot answer with a
    real 301 and Shopify's URL redirects only cover paths that no longer exist, so this is a meta
    refresh backed by a script; skipped in the theme editor so the product template stays editable.
  {%- endcomment -%}
  {%- if template.name == 'product' and settings.redirect_product_pages and request.design_mode == false -%}
    {%- assign home_url = shop.url | append: routes.root_url -%}
    <meta http-equiv="refresh" content="0; url={{ home_url }}">
    <script>window.location.replace({{ home_url | json }});</script>
  {%- endif -%}
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#1f1f1f">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Caveat:wght@400..700&display=swap">

  {{ 'critical.css' | asset_url | stylesheet_tag }}
  {{ 'blaze.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'sections-inline.css' | asset_url | stylesheet_tag }}
  {{ 'sections.css' | asset_url | stylesheet_tag }}

  <script>
    window.Shopify = window.Shopify || {};
    window.Shopify.routes = window.Shopify.routes || {};
    window.Shopify.routes.root = '{{ routes.root_url }}';
    window.theme = { moneyFormat: {{ shop.money_format | json }} };
  </script>

  {{ content_for_header }}
</head>

<body class="no-focus-outline features--image-zoom template-{{ request.page_type | handle }}{% if template.suffix %} template-{{ request.page_type | handle }}--{{ template.suffix | handle }}{% endif %}">
  {% render 'froya-svg-defs' %}

  {% sections 'header-group' %}

  <div id="main" class="anchor" role="main">
    {{ content_for_layout }}
  </div>

  {% sections 'footer-group' %}

  {%- comment -%}
    Shopify only pre-selects a visitor's country on Shopify Plus. On every other plan the storefront
    opens in the primary market's default country, so a shopper abroad sees the wrong currency until
    checkout asks for an address. assets/main.js asks Shopify which country it detects for this
    visitor (browsing_context_suggestions.json, Shopify's own GeoIP) and submits this form once so the
    buy box, cart and checkout all start in the local currency. The select lists every country the
    store sells to, so a detected country the store does not serve is simply ignored.
  {%- endcomment -%}
  {%- if settings.auto_localize and localization.available_countries.size > 1 and request.design_mode == false -%}
    <div hidden>
      {%- form 'localization', id: 'localization_form_auto', data-current-country: localization.country.iso_code -%}
        <select name="country_code" aria-hidden="true" tabindex="-1">
          {%- for country in localization.available_countries -%}
            <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }}</option>
          {%- endfor -%}
        </select>
      {%- endform -%}
    </div>
  {%- endif -%}

  <script src="{{ 'blaze-slider.min.js' | asset_url }}" defer></script>
  <script src="{{ 'main.js' | asset_url }}" defer></script>
</body>
</html>
