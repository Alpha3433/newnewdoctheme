    "backed-by-science": {
      "type": "froya-backed-by-science",
      "settings": {},
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Blocks DHT At The Follicle",
            "text": "Pumpkin seed oil is rich in phytosterols shown to inhibit 5-alpha-reductase, the enzyme that turns testosterone into DHT: the hormone that shrinks follicles in female pattern hair loss.",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Frame_41_2x_a1754f28-b6a2-4e98-b12c-c6525d643a78_svg.png"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Wakes Up Dormant Follicles",
            "text": "Our Caffeine Complex counteracts DHT’s suppression of follicle growth and has been shown to prolong the anagen (growth) phase in female hair follicles.",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Frame_41_2x_a1754f28-b6a2-4e98-b12c-c6525d643a78.svg_6.png"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Boosts Blood Flow To The Root",
            "text": "Caffeine plus a 60-second scalp massage stimulates microcirculation, so oxygen and nutrients reach the follicles that have been starved of them.",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Frame_41_2x_a1754f28-b6a2-4e98-b12c-c6525d643a78.svg_7.png"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Strengthens Every Strand",
            "text": "Omega-3, 6 and 9 fatty acids, zinc and vitamin E nourish the hair shaft and cut breakage, so the hair you grow is hair you keep.",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Frame_41_2x_a1754f28-b6a2-4e98-b12c-c6525d643a78.svg_3.png"
          }
        },
        "step_5": {
          "type": "step",
          "settings": {
            "title": "Calms An Irritated Scalp",
            "text": "Anti-inflammatory tocopherols and carotenoids soothe itching, dryness and inflammation, giving follicles the healthy environment they need to grow.",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Frame_41_2x_a1754f28-b6a2-4e98-b12c-c6525d643a78.svg_4.png"
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3",
        "step_4",
        "step_5"
      ]
    },
    "clinical-trial": {
      "type": "froya-clinical-trial",
      "settings": {},
      "blocks": {
        "intro_1": {
          "type": "intro",
          "settings": {
            "text": "Elaren is built on the two most-studied natural hair growth actives. Here is what independent, peer-reviewed research found:",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Screenshot_2025-12-18_at_1.11.35_PM_1.png"
          }
        },
        "stat_1": {
          "type": "stat",
          "settings": {
            "value": "+40%",
            "width": 40,
            "title": "HAIR COUNT",
            "text": "Pumpkin seed oil increased hair count by 40% over 24 weeks in a randomised, placebo-controlled trial."
          }
        },
        "stat_2": {
          "type": "stat",
          "settings": {
            "value": "≈ 5% MINOXIDIL",
            "width": 90,
            "title": "CAFFEINE VS MINOXIDIL",
            "text": "In a 6-month clinical study, a topical caffeine liquid was statistically non-inferior to 5% minoxidil at increasing growth-phase hairs."
          }
        },
        "stat_3": {
          "type": "stat",
          "settings": {
            "value": "5 MINUTES",
            "width": 100,
            "title": "FOLLICLE PENETRATION",
            "text": "Caffeine applied to the scalp was detected in the bloodstream within 5 minutes, showing it is absorbed straight through the hair follicle."
          }
        },
        "note_1": {
          "type": "note",
          "settings": {
            "text": "*Studies cited were conducted on the ingredients (oral pumpkin seed oil supplementation, Cho et al. 2014; topical caffeine, Dhurat et al. 2017 and Otberg et al. 2008), not on Elaren’s finished formula. Individual results vary. Hair grows in cycles: most women notice less shedding first, with visible density changes typically taking 3–6 months of consistent use. Not seeing progress? Contact us within 90 days for a full refund."
          }
        }
      },
      "block_order": [
        "intro_1",
        "stat_1",
        "stat_2",
        "stat_3",
        "note_1"
      ]
    },
