    "clinical-trial": {
      "type": "froya-clinical-trial",
      "blocks": {
        "intro_1": {
          "type": "intro",
          "settings": {
            "text": "Elaren is built on the two most-studied natural hair growth actives. Here is what independent, peer-reviewed research found:",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Screenshot_2025-12-18_at_1.11.35_PM_1.png"
          }
        },
        "stat_1": {
          "type": "stat",
          "settings": {
            "value": "+40%",
            "width": 40,
            "title": "HAIR COUNT",
            "text": "Pumpkin seed oil increased hair count by 40% over 24 weeks in a randomised, placebo-controlled trial."
          }
        },
        "stat_2": {
          "type": "stat",
          "settings": {
            "value": "≈ 5% MINOXIDIL",
            "width": 90,
            "title": "CAFFEINE VS MINOXIDIL",
            "text": "In a 6-month clinical study, a topical caffeine liquid was statistically non-inferior to 5% minoxidil at increasing growth-phase hairs."
          }
        },
        "stat_3": {
          "type": "stat",
          "settings": {
            "value": "5 MINUTES",
            "width": 100,
            "title": "FOLLICLE PENETRATION",
            "text": "Caffeine applied to the scalp was detected in the bloodstream within 5 minutes, showing it is absorbed straight through the hair follicle."
          }
        },
        "note_1": {
          "type": "note",
          "settings": {
            "text": "*Studies cited were conducted on the ingredients (oral pumpkin seed oil supplementation, Cho et al. 2014; topical caffeine, Dhurat et al. 2017 and Otberg et al. 2008), not on Elaren’s finished formula. Individual results vary. Hair grows in cycles: most women notice less shedding first, with visible density changes typically taking 3–6 months of consistent use. Not seeing progress? Contact us within 90 days for a full refund."
          }
        }
      },
