    "backed-by-science": {
      "type": "froya-backed-by-science",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Blocks DHT At The Follicle",
            "text": "Pumpkin seed oil is rich in phytosterols shown to inhibit 5-alpha-reductase, the enzyme that turns testosterone into DHT: the hormone that shrinks follicles in female pattern hair loss.",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Frame_41_2x_a1754f28-b6a2-4e98-b12c-c6525d643a78_svg.png"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Wakes Up Dormant Follicles",
            "text": "Our Caffeine Complex counteracts DHT’s suppression of follicle growth and has been shown to prolong the anagen (growth) phase in female hair follicles.",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Frame_41_2x_a1754f28-b6a2-4e98-b12c-c6525d643a78.svg_6.png"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Boosts Blood Flow To The Root",
            "text": "Caffeine plus a 60-second scalp massage stimulates microcirculation, so oxygen and nutrients reach the follicles that have been starved of them.",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Frame_41_2x_a1754f28-b6a2-4e98-b12c-c6525d643a78.svg_7.png"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Strengthens Every Strand",
            "text": "Omega-3, 6 and 9 fatty acids, zinc and vitamin E nourish the hair shaft and cut breakage, so the hair you grow is hair you keep.",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Frame_41_2x_a1754f28-b6a2-4e98-b12c-c6525d643a78.svg_3.png"
          }
        },
        "step_5": {
          "type": "step",
          "settings": {
            "title": "Calms An Irritated Scalp",
            "text": "Anti-inflammatory tocopherols and carotenoids soothe itching, dryness and inflammation, giving follicles the healthy environment they need to grow.",
            "icon_fallback": "https://froyaorganics.com/cdn/shop/files/Frame_41_2x_a1754f28-b6a2-4e98-b12c-c6525d643a78.svg_4.png"
          }
        }
      },
