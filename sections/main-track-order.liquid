{% comment %}
  Track your order – the store's one delivery hub (templates/page.track-order.json), laid out in the
  landing page's style: a cream hero with the tracking-number lookup, the shopper's orders (or a
  sign-in card), the delivery journey as a numbered timeline, the FAQ accordion and a help card.
  * Tracking number lookup: opens the carrier whose prefix matches (Carrier blocks), otherwise the
    universal tracker from Theme settings → Order tracking. A link such as
    /pages/track-order?tracking=YT123… (from the shipping confirmation email) fills the number in.
  * Signed-in customers see their recent orders with a progress tracker and every tracking number;
    everyone else gets a sign-in button that brings them back here.
  * Highlights, delivery timeline steps, questions and the help card are blocks/settings in the
    theme editor.
{% endcomment %}
{%- liquid
  assign carriers = section.blocks | where: 'type', 'carrier'
  assign highlights = section.blocks | where: 'type', 'highlight'
  assign steps = section.blocks | where: 'type', 'step'
  assign questions = section.blocks | where: 'type', 'question'
  assign universal = settings.universal_tracker_url | default: 'https://t.17track.net/en#nums={number}'
  assign login_url = routes.account_login_url
  if login_url contains '?'
    assign login_url = login_url | append: '&'
  else
    assign login_url = login_url | append: '?'
  endif
  assign login_url = login_url | append: 'return_url=' | append: request.path
-%}
<div class="s-track" data-track data-anchor="track" id="track">
  <section class="s-track__hero">
    <div class="s-track__hero-inner">
      <header class="s-track__intro">
        {%- if section.settings.eyebrow != blank -%}<p class="s-track__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 class="s-track__title">{{ section.settings.title | default: page.title }}</h1>
        {%- if section.settings.subtitle != blank -%}<p class="s-track__subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
      </header>

      <div class="s-track__lookup">
        <h2 class="s-track__lookup-title">{{ section.settings.lookup_title }}</h2>
        {%- if section.settings.lookup_text != blank -%}<p class="s-track__lookup-text">{{ section.settings.lookup_text }}</p>{%- endif -%}
        <form class="s-track__form" data-track-form novalidate>
          <label class="s-track__label" for="TrackNumber-{{ section.id }}">{{ section.settings.input_label }}</label>
          <input class="s-track__input" id="TrackNumber-{{ section.id }}" name="tracking" type="text" inputmode="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="{{ section.settings.placeholder | escape }}" required>
          <button class="custom-button s-track__submit" type="submit">{{ section.settings.button_label }}</button>
          <p class="s-track__message" data-track-message role="status" aria-live="polite" hidden></p>
        </form>
        {%- if section.settings.lookup_note != blank -%}
          <p class="s-track__lookup-note">
            <svg aria-hidden="true" fill="none" viewBox="0 0 24 24"><path d="M1.5 5.5h12v10h-12zM13.5 9h4.5l3.5 3.5v3h-8M6 18.5a2 2 0 1 0 0-.01M17 18.5a2 2 0 1 0 0-.01" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/></svg>
            <span>{{ section.settings.lookup_note }}</span>
          </p>
        {%- endif -%}
      </div>

      {%- if highlights.size > 0 -%}
        <ul class="s-track__highlights" role="list">
          {%- for block in highlights -%}
            <li class="s-track__highlight" {{ block.shopify_attributes }}>
              <span class="s-track__highlight-icon" aria-hidden="true"><svg fill="none" viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/></svg></span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>

  <section class="s-track__account">
    <div class="s-track__container">
      {%- if customer -%}
        {%- liquid
          assign customer_name = customer.first_name | default: customer.email
          assign signed_in_line = section.settings.signed_in_text | replace: '{name}', customer_name
        -%}
        <header class="s-track__account-head">
          <div>
            <h2 class="s-track__account-title">{{ section.settings.orders_title }}</h2>
            <p class="s-track__account-text">{{ signed_in_line }}</p>
          </div>
          {%- if customer.orders.size > 0 -%}<a class="s-track__account-all" href="{{ routes.account_url }}">{{ section.settings.all_orders_label }}</a>{%- endif -%}
        </header>
        {%- if customer.orders.size > 0 -%}
          <ul class="s-track__orders" role="list">
            {%- for order in customer.orders limit: section.settings.orders_limit -%}
              <li class="s-track__order">
                <div class="s-track__order-head">
                  <a class="s-track__order-name" href="{{ order.customer_url }}">{{ order.name }}</a>
                  <span class="s-track__order-meta">{{ order.created_at | date: '%b %d, %Y' }}</span>
                </div>
                {%- render 'order-tracking', order: order -%}
                {%- if order.order_status_url != blank -%}<a class="s-track__order-status" href="{{ order.order_status_url }}">{{ section.settings.status_page_label }}</a>{%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="s-track__account-empty">{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      {%- else -%}
        <div class="s-track__signin">
          <span class="s-track__signin-icon" aria-hidden="true"><svg fill="none" viewBox="0 0 24 24"><path d="M3 7.5l9-4.5 9 4.5v9L12 21l-9-4.5zM3 7.5l9 4.5 9-4.5M12 12v9" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/></svg></span>
          <div class="s-track__signin-content">
            <h2 class="s-track__account-title">{{ section.settings.account_title }}</h2>
            {%- if section.settings.account_text != blank -%}<p class="s-track__account-text">{{ section.settings.account_text }}</p>{%- endif -%}
          </div>
          <a class="s-track__outline-button" href="{{ login_url }}">{{ section.settings.account_button }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- if steps.size > 0 -%}
  <section class="s-track__journey" aria-labelledby="s-track-steps-{{ section.id }}">
    <div class="s-track__container">
      <header class="s-track__section-head">
        {%- if section.settings.steps_eyebrow != blank -%}<p class="s-track__section-eyebrow">{{ section.settings.steps_eyebrow }}</p>{%- endif -%}
        <h2 class="s-track__section-title" id="s-track-steps-{{ section.id }}">{{ section.settings.steps_title }}</h2>
        {%- if section.settings.steps_subtitle != blank -%}<p class="s-track__section-subtitle">{{ section.settings.steps_subtitle }}</p>{%- endif -%}
      </header>
      <ol class="s-track__steps" role="list" style="--track-steps: {{ steps.size }};">
        {%- for block in steps -%}
          <li class="s-track__step" {{ block.shopify_attributes }}>
            <span class="s-track__step-num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div class="s-track__step-body">
              <p class="s-track__step-title">{{ block.settings.title }}</p>
              <div class="s-track__step-text">{{ block.settings.text }}</div>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>
  {%- endif -%}

  {%- if questions.size > 0 -%}
  <section class="s-faq s-track__faq" aria-labelledby="s-track-faq-{{ section.id }}">
    <div class="s-faq__container">
      <header class="s-track__section-head">
        {%- if section.settings.faq_eyebrow != blank -%}<p class="s-track__section-eyebrow">{{ section.settings.faq_eyebrow }}</p>{%- endif -%}
        <h2 class="s-track__section-title" id="s-track-faq-{{ section.id }}">{{ section.settings.faq_title }}</h2>
      </header>
      <div class="s-faq__list">
        {%- for block in questions -%}
          <details class="s-faq__item" {{ block.shopify_attributes }}>
            <summary class="s-faq__question">
              <span aria-hidden="true" class="s-faq__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="s-faq__question-text">{{ block.settings.question }}</span>
              <span aria-hidden="true" class="s-faq__icon"></span>
            </summary>
            <div class="s-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- if page.content != blank -%}<div class="s-track__container"><div class="rte s-track__page-content">{{ page.content }}</div></div>{%- endif -%}

  {%- if section.settings.help_title != blank or section.settings.help_text != blank -%}
  <section class="s-track__help-wrap">
    <div class="s-track__help">
      <span class="s-track__help-icon" aria-hidden="true"><svg fill="none" viewBox="0 0 24 24"><path d="M3 5.5h18v13H3zM3.5 6l8.5 7 8.5-7" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/></svg></span>
      <div class="s-track__help-content">
        {%- if section.settings.help_title != blank -%}<h2 class="s-track__help-title">{{ section.settings.help_title }}</h2>{%- endif -%}
        {%- if section.settings.help_text != blank -%}<div class="s-track__help-text">{{ section.settings.help_text }}</div>{%- endif -%}
      </div>
      {%- if section.settings.help_email != blank and section.settings.help_button != blank -%}
        <a class="custom-button s-track__help-button" href="mailto:{{ section.settings.help_email }}">{{ section.settings.help_button }}</a>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  <script type="application/json" data-track-config>
    {
      "universal": {{ universal | json }},
      "opening": {{ section.settings.opening_text | json }},
      "fallback": {{ section.settings.fallback_label | json }},
      "invalid": {{ section.settings.invalid_text | json }},
      "carriers": [
        {%- for block in carriers -%}
          { "name": {{ block.settings.name | json }}, "prefixes": {{ block.settings.prefixes | upcase | remove: ' ' | split: ',' | json }}, "url": {{ block.settings.url | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</div>

{% schema %}
{
  "name": "Track your order",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Order tracking" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Where’s My <em>Order?</em>", "info": "Italic words get the landing page's accent. Leave empty to use the page title." },
    { "type": "textarea", "id": "subtitle", "label": "Subheading", "default": "Every Elaren order ships with tracking. Pop your tracking number in to follow your parcel, or sign in to see all your orders in one place." },
    { "type": "paragraph", "content": "The ticked lines under the subheading are \"Highlight\" blocks." },
    { "type": "header", "content": "Tracking number lookup" },
    { "type": "text", "id": "lookup_title", "label": "Title", "default": "Track your parcel" },
    { "type": "textarea", "id": "lookup_text", "label": "Text", "default": "You’ll find your tracking number in your shipping confirmation email from us." },
    { "type": "text", "id": "input_label", "label": "Field label", "default": "Tracking number" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "e.g. YT0000000000000000" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "TRACK MY PARCEL" },
    { "type": "text", "id": "lookup_note", "label": "Note under the button", "default": "Live tracking opens in a new tab – no account needed." },
    { "type": "text", "id": "opening_text", "label": "Message after tracking", "default": "Opening {carrier} tracking for {number}.", "info": "{carrier} and {number} are filled in." },
    { "type": "text", "id": "fallback_label", "label": "Link when the new tab doesn’t open", "default": "Didn’t open? Tap here" },
    { "type": "text", "id": "invalid_text", "label": "Invalid number message", "default": "Please enter your tracking number (letters and numbers only)." },
    { "type": "header", "content": "Signed-out customers" },
    { "type": "text", "id": "account_title", "label": "Title", "default": "See all your orders" },
    { "type": "textarea", "id": "account_text", "label": "Text", "default": "Sign in with the email you ordered with to see every order, its status and its tracking in one place." },
    { "type": "text", "id": "account_button", "label": "Button label", "default": "SIGN IN" },
    { "type": "header", "content": "Signed-in customers" },
    { "type": "text", "id": "orders_title", "label": "Title", "default": "Your recent orders" },
    { "type": "text", "id": "signed_in_text", "label": "Text", "default": "Hi {name}, here’s where your orders are.", "info": "{name} is the customer’s first name." },
    { "type": "range", "id": "orders_limit", "label": "Orders to show", "min": 1, "max": 10, "step": 1, "default": 4 },
    { "type": "text", "id": "status_page_label", "label": "Order status page link", "default": "Full delivery details" },
    { "type": "text", "id": "all_orders_label", "label": "All orders link", "default": "View all orders" },
    { "type": "header", "content": "Delivery timeline" },
    { "type": "text", "id": "steps_eyebrow", "label": "Eyebrow", "default": "From our door to yours" },
    { "type": "inline_richtext", "id": "steps_title", "label": "Title", "default": "What Happens <em>After You Order</em>" },
    { "type": "textarea", "id": "steps_subtitle", "label": "Subheading", "default": "Every step your parcel takes on its way to you, and what to expect at each one." },
    { "type": "header", "content": "Questions" },
    { "type": "text", "id": "faq_eyebrow", "label": "Eyebrow", "default": "Questions, answered" },
    { "type": "inline_richtext", "id": "faq_title", "label": "Title", "default": "Delivery Questions" },
    { "type": "header", "content": "Help card" },
    { "type": "text", "id": "help_title", "label": "Title", "default": "Still need a hand?" },
    { "type": "richtext", "id": "help_text", "label": "Text", "default": "<p>Email us with your order number and a real person will reply within one business day.</p>" },
    { "type": "text", "id": "help_button", "label": "Button label", "default": "EMAIL OUR TEAM" },
    { "type": "text", "id": "help_email", "label": "Email address", "default": "support@shopelaren.com", "info": "The button opens an email to this address. Leave empty to hide the button." }
  ],
  "blocks": [
    {
      "type": "carrier",
      "name": "Carrier",
      "settings": [
        { "type": "paragraph", "content": "Tracking numbers that start with one of these prefixes open this carrier’s own tracking page. Every other number opens the universal tracker (Theme settings → Order tracking)." },
        { "type": "text", "id": "name", "label": "Carrier name", "default": "YunExpress" },
        { "type": "text", "id": "prefixes", "label": "Tracking number prefixes", "default": "YT", "info": "Comma separated, e.g. YT, SYRM" },
        { "type": "text", "id": "url", "label": "Tracking link", "default": "https://www.yuntrack.com/Track/Detail/{number}", "info": "{number} is replaced by the tracking number." }
      ]
    },
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Tracking on every order" }
      ]
    },
    {
      "type": "step",
      "name": "Timeline step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Order placed" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Your confirmation email arrives straight away.</p>" }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "My tracking hasn’t updated for a few days" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Parcels are often scanned only when they change hands, so a few quiet days in transit are normal.</p>" }
      ]
    }
  ]
}
{% endschema %}
