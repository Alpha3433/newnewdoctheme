{%- assign current_variant = product.selected_or_first_available_variant -%}
<div class="page-width">
  <div class="product-page">
    <div class="product-page__media">
      {%- for media in product.media limit: 6 -%}
        {%- if media.media_type == 'image' -%}
          {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 768px) 50vw, 100vw' }}
        {%- else -%}
          {{ media | media_tag: image_size: '1200x' }}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="product-page__info">
      <h1 class="product-page__title">{{ product.title }}</h1>
      <div class="product-page__price" data-price>
        {{ current_variant.price | money }}
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s>{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
      </div>

      {%- form 'product', product, class: 'product-form' -%}
        {%- unless product.has_only_default_variant -%}
          <div class="form-field">
            <label for="variant-{{ section.id }}">{{ product.options | join: ' / ' }}</label>
            <select id="variant-{{ section.id }}" name="id">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }} – {{ variant.price | money }}{% unless variant.available %} ({{ 'products.product.sold_out' | t }}){% endunless %}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- endunless -%}

        <div class="form-field">
          <label for="quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
          <input type="number" id="quantity-{{ section.id }}" name="quantity" value="1" min="1">
        </div>

        <div class="product-form__buttons">
          <button type="submit" class="custom-button" {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
          </button>
        </div>
      {%- endform -%}

      <div class="rte" style="margin-top: 28px;">{{ product.description }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
