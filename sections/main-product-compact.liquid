{%- comment -%}
  A short, self-contained product page for products that are sold on their own page rather than
  from the landing page's buy box (the Pumpkin Seed Oil Capsules today). Assign a product to
  `templates/product.capsules.json` (Products → Theme template) to use it: products on a custom
  template skip the home-page redirect in layout/theme.liquid, and the cart drawer links to them.

  Gallery, size buttons, quantity and Add to cart. The form carries `js-ajax-add`, so main.js adds
  it in place and opens the cart drawer, exactly like the buy box. Text lives in the section
  settings and in the Expandable detail / Pairs with blocks.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign option_suffix = section.settings.option_suffix
  assign image_count = 0
  for media in product.media
    if media.media_type == 'image'
      assign image_count = image_count | plus: 1
    endif
  endfor
-%}
<div class="compact-pdp" data-compact-pdp style="--compact-pdp-bg: {{ section.settings.background }};">
  <div class="compact-pdp__inner">
    <div class="compact-pdp__media">
      <div class="compact-pdp__stage" data-stage>
        {%- assign slide_index = 0 -%}
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            {%- liquid
              assign slide_alt = media.alt | default: product.title
              assign slide_loading = 'lazy'
              if slide_index == 0
                assign slide_loading = 'eager'
              endif
            -%}
            <div class="compact-pdp__slide{% if slide_index == 0 %} is-active{% endif %}" data-slide="{{ slide_index }}">
              {{ media | image_url: width: 1200 | image_tag: loading: slide_loading, widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 900px) 46vw, 100vw', alt: slide_alt }}
            </div>
            {%- assign slide_index = slide_index | plus: 1 -%}
          {%- endif -%}
        {%- else -%}
          <div class="compact-pdp__slide is-active compact-pdp__slide--empty"></div>
        {%- endfor -%}
      </div>
      {%- if image_count > 1 -%}
        <div class="compact-pdp__thumbs">
          {%- assign thumb_index = 0 -%}
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <button type="button" class="compact-pdp__thumb{% if thumb_index == 0 %} is-active{% endif %}" data-thumb="{{ thumb_index }}" aria-label="Show image {{ thumb_index | plus: 1 }} of {{ image_count }}">
                {{ media | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
              </button>
              {%- assign thumb_index = thumb_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="compact-pdp__info">
      {%- if section.settings.eyebrow != blank -%}
        <p class="compact-pdp__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="compact-pdp__title">{{ product.title }}</h1>

      {%- liquid
        assign current_save = ''
        if current_variant.compare_at_price > current_variant.price
          assign current_save = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
        endif
      -%}
      <div class="compact-pdp__price" data-price-wrap>
        <span class="compact-pdp__price-now" data-price>{{ current_variant.price | money }}</span>
        <s class="compact-pdp__price-was" data-compare{% if current_save == '' %} hidden{% endif %}>{{ current_variant.compare_at_price | money }}</s>
        {%- if section.settings.save_label != blank -%}
          <span class="compact-pdp__save" data-save-tag data-save-label="{{ section.settings.save_label | escape }}"{% if current_save == '' %} hidden{% endif %}>{{ section.settings.save_label | replace: '{percent}', current_save }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.intro != blank -%}
        <div class="compact-pdp__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
      {%- if product.description != blank -%}
        <div class="compact-pdp__intro rte">{{ product.description }}</div>
      {%- endif -%}

      {%- form 'product', product, class: 'compact-pdp__form js-ajax-add', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          <fieldset class="compact-pdp__options">
            <legend class="compact-pdp__label">{{ product.options.first }}</legend>
            <div class="compact-pdp__option-list">
              {%- for variant in product.variants -%}
                {%- capture variant_compare -%}{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}{%- endcapture -%}
                <button
                  type="button"
                  class="compact-pdp__option{% if variant.id == current_variant.id %} is-selected{% endif %}{% unless variant.available %} is-unavailable{% endunless %}"
                  data-variant="{{ variant.id }}"
                  data-price="{{ variant.price | money | escape }}"
                  data-compare="{{ variant_compare | strip | escape }}"
                  data-available="{{ variant.available }}"
                  aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                >
                  <span class="compact-pdp__option-name">{{ variant.title }}{{ option_suffix }}</span>
                  <span class="compact-pdp__option-price">{% if variant.available %}{{ variant.price | money }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                </button>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endunless -%}

        {%- if section.settings.deal_note != blank -%}
          <div class="compact-pdp__deal">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 21V7M12 7H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7z"/></svg>
            <div class="compact-pdp__deal-text">{{ section.settings.deal_note }}</div>
          </div>
        {%- endif -%}

        <div class="compact-pdp__buy">
          <div class="compact-pdp__qty">
            <button type="button" class="compact-pdp__qty-btn" data-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" class="compact-pdp__qty-input" data-qty aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" class="compact-pdp__qty-btn" data-qty-step="1" aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" class="custom-button compact-pdp__add" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
            <span data-add-label data-label-add="{{ section.settings.add_label | escape }}" data-label-sold="{{ 'products.product.sold_out' | t | escape }}">
              {%- if current_variant.available -%}{{ section.settings.add_label }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
            </span>
          </button>
        </div>
      {%- endform -%}

      {%- assign perks = section.settings.perks | newline_to_br | split: '<br />' -%}
      {%- if section.settings.perks != blank -%}
        <ul class="compact-pdp__perks">
          {%- for perk in perks -%}
            {%- assign perk_text = perk | strip -%}
            {%- if perk_text != blank -%}
              <li>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{{ perk_text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="compact-pdp__blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'detail' -%}
                <details class="compact-pdp__detail" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                  <summary class="compact-pdp__detail-title">
                    <span>{{ block.settings.title }}</span>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                  </summary>
                  <div class="compact-pdp__detail-body rte">{{ block.settings.text }}</div>
                </details>
              {%- when 'pairing' -%}
                {%- liquid
                  assign pair_product = block.settings.product
                  assign pair_url = block.settings.link
                  if pair_url == blank
                    assign pair_url = routes.root_url | append: '#shop'
                  endif
                -%}
                <a class="compact-pdp__pair" href="{{ pair_url }}" {{ block.shopify_attributes }}>
                  {%- if pair_product.featured_image != blank -%}
                    {{ pair_product.featured_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: class: 'compact-pdp__pair-image', loading: 'lazy', alt: '' }}
                  {%- endif -%}
                  <span class="compact-pdp__pair-text">
                    {%- if block.settings.heading != blank -%}<span class="compact-pdp__pair-heading">{{ block.settings.heading }}</span>{%- endif -%}
                    {%- if pair_product != blank -%}<span class="compact-pdp__pair-title">{{ pair_product.title }}</span>{%- endif -%}
                    {%- if block.settings.text != blank -%}<span class="compact-pdp__pair-copy">{{ block.settings.text }}</span>{%- endif -%}
                    {%- if block.settings.link_label != blank -%}<span class="compact-pdp__pair-link">{{ block.settings.link_label }} &rarr;</span>{%- endif -%}
                  </span>
                </a>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .compact-pdp { background: var(--compact-pdp-bg, var(--brand-cream)); }
  .compact-pdp__inner {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px;
    max-width: 1120px; margin: 0 auto; padding: 24px 20px 48px;
  }
  .compact-pdp__media { min-width: 0; }
  .compact-pdp__stage { position: relative; aspect-ratio: 1 / 1; border-radius: 14px; overflow: hidden; background: #fff; }
  .compact-pdp__slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .25s ease; }
  .compact-pdp__slide.is-active { opacity: 1; visibility: visible; }
  .compact-pdp__slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .compact-pdp__thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
  .compact-pdp__thumb { flex: 0 0 64px; height: 64px; padding: 0; border: 2px solid transparent; border-radius: 8px; overflow: hidden; background: #fff; cursor: pointer; }
  .compact-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .compact-pdp__thumb.is-active { border-color: var(--brand-ink); }
  .compact-pdp__info { min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .compact-pdp__eyebrow { margin: 0; font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brand-mauve-dark); }
  .compact-pdp__title { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: 28px; line-height: 1.2; text-wrap: balance; }
  .compact-pdp__price { display: flex; align-items: baseline; gap: 10px; }
  .compact-pdp__price-now { font-size: 22px; font-weight: 700; }
  .compact-pdp__price-was { font-size: 16px; color: var(--brand-strike); }
  .compact-pdp__intro { font-size: 16px; }
  .compact-pdp__intro p:last-child { margin-bottom: 0; }
  .compact-pdp__form { display: flex; flex-direction: column; gap: 14px; margin: 4px 0 0; }
  .compact-pdp__options { border: 0; margin: 0; padding: 0; min-width: 0; }
  .compact-pdp__label { padding: 0; margin: 0 0 8px; font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .compact-pdp__option-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; }
  .compact-pdp__option {
    display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 12px 14px;
    border: 1.5px solid var(--brand-line); border-radius: 10px; background: #fff; color: var(--brand-ink);
    font: inherit; text-align: left; cursor: pointer; transition: border-color .15s ease, box-shadow .15s ease;
  }
  .compact-pdp__option:hover { border-color: var(--brand-mauve); }
  .compact-pdp__option.is-selected { border-color: var(--brand-ink); box-shadow: inset 0 0 0 1px var(--brand-ink); }
  .compact-pdp__option.is-unavailable { opacity: 0.55; }
  .compact-pdp__option-name { font-size: 16px; font-weight: 600; }
  .compact-pdp__option-price { font-size: 14px; }
  .compact-pdp__buy { display: flex; gap: 10px; align-items: stretch; }
  .compact-pdp__qty { display: flex; align-items: center; border: 1.5px solid var(--brand-line); border-radius: 4px; background: #fff; }
  .compact-pdp__qty-btn { width: 40px; height: 100%; min-height: 52px; border: 0; background: none; font-size: 20px; line-height: 1; color: var(--brand-ink); cursor: pointer; }
  .compact-pdp__qty-input { width: 44px; border: 0; background: none; text-align: center; font: inherit; font-size: 16px; -moz-appearance: textfield; appearance: textfield; }
  .compact-pdp__qty-input::-webkit-outer-spin-button, .compact-pdp__qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .compact-pdp__add { flex: 1 1 auto; min-height: 54px; }
  .compact-pdp__add[disabled] { opacity: 0.55; cursor: not-allowed; }
  .compact-pdp__perks { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 14px; }
  .compact-pdp__perks li { display: flex; gap: 8px; align-items: flex-start; }
  .compact-pdp__perks svg { flex: 0 0 auto; margin-top: 2px; color: var(--brand-green); }
  .compact-pdp__blocks { display: flex; flex-direction: column; margin-top: 6px; border-top: 1px solid var(--brand-line); }
  .compact-pdp__detail { border-bottom: 1px solid var(--brand-line); }
  .compact-pdp__detail-title { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 0; font-weight: 600; cursor: pointer; list-style: none; }
  .compact-pdp__detail-title::-webkit-details-marker { display: none; }
  .compact-pdp__detail-title svg { flex: 0 0 auto; transition: transform .2s ease; }
  .compact-pdp__detail[open] .compact-pdp__detail-title svg { transform: rotate(45deg); }
  .compact-pdp__detail-body { padding: 0 0 16px; font-size: 15px; }
  .compact-pdp__detail-body p:last-child { margin-bottom: 0; }
  .compact-pdp__detail-body a { text-decoration: underline; }
  .compact-pdp__pair {
    display: flex; gap: 14px; align-items: center; margin-top: 18px; padding: 12px; border-radius: 12px;
    background: #fff; border: 1px solid var(--brand-line); color: var(--brand-ink); text-decoration: none;
  }
  .compact-pdp__pair:hover { border-color: var(--brand-mauve); }
  .compact-pdp__pair-image { flex: 0 0 72px; width: 72px; height: 72px; border-radius: 8px; object-fit: cover; }
  .compact-pdp__pair-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .compact-pdp__pair-heading { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brand-mauve-dark); }
  .compact-pdp__pair-title { font-weight: 600; }
  .compact-pdp__pair-copy { font-size: 14px; }
  .compact-pdp__pair-link { font-size: 14px; font-weight: 600; color: var(--brand-cta); }
  @media screen and (min-width: 900px) {
    .compact-pdp__inner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 48px; padding: 48px 32px 72px; align-items: start; }
    .compact-pdp__media { position: sticky; top: 96px; }
    .compact-pdp__title { font-size: 34px; }
  }
</style>

<script>
  (function () {
    function init(root) {
      if (!root || root.__compactPdp) return;
      root.__compactPdp = true;

      var slides = Array.prototype.slice.call(root.querySelectorAll('[data-slide]'));
      var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-thumb]'));
      var current = 0;
      function show(i) {
        if (!slides.length) return;
        current = (i + slides.length) % slides.length;
        slides.forEach(function (s, k) { s.classList.toggle('is-active', k === current); });
        thumbs.forEach(function (t, k) { t.classList.toggle('is-active', k === current); });
      }
      thumbs.forEach(function (t, k) { t.addEventListener('click', function () { show(k); }); });
      var stage = root.querySelector('[data-stage]');
      var startX = null;
      if (stage) {
        stage.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
        stage.addEventListener('touchend', function (e) {
          if (startX === null) return;
          var dx = e.changedTouches[0].clientX - startX;
          if (Math.abs(dx) > 40) show(dx < 0 ? current + 1 : current - 1);
          startX = null;
        });
      }

      var idInput = root.querySelector('[data-variant-id]');
      var price = root.querySelector('[data-price]');
      var compare = root.querySelector('[data-compare]');
      var addButton = root.querySelector('[data-add-button]');
      var addLabel = root.querySelector('[data-add-label]');
      var options = Array.prototype.slice.call(root.querySelectorAll('[data-variant]'));
      options.forEach(function (option) {
        option.addEventListener('click', function () {
          var available = option.getAttribute('data-available') === 'true';
          options.forEach(function (o) {
            var selected = o === option;
            o.classList.toggle('is-selected', selected);
            o.setAttribute('aria-pressed', selected ? 'true' : 'false');
          });
          if (idInput) idInput.value = option.getAttribute('data-variant');
          if (price) price.textContent = option.getAttribute('data-price');
          if (compare) {
            var was = option.getAttribute('data-compare');
            compare.textContent = was;
            if (was) compare.removeAttribute('hidden'); else compare.setAttribute('hidden', '');
          }
          if (addButton) addButton.disabled = !available;
          if (addLabel) addLabel.textContent = available ? addLabel.getAttribute('data-label-add') : addLabel.getAttribute('data-label-sold');
          try {
            var url = new URL(window.location.href);
            url.searchParams.set('variant', option.getAttribute('data-variant'));
            window.history.replaceState(window.history.state, '', url.toString());
          } catch (err) { /* keep the current URL */ }
        });
      });

      var qty = root.querySelector('[data-qty]');
      Array.prototype.slice.call(root.querySelectorAll('[data-qty-step]')).forEach(function (button) {
        button.addEventListener('click', function () {
          if (!qty) return;
          var next = (parseInt(qty.value, 10) || 1) + parseInt(button.getAttribute('data-qty-step'), 10);
          qty.value = Math.min(99, Math.max(1, next));
        });
      });
      if (qty) {
        qty.addEventListener('change', function () {
          qty.value = Math.min(99, Math.max(1, parseInt(qty.value, 10) || 1));
        });
      }
    }
    Array.prototype.slice.call(document.querySelectorAll('[data-compact-pdp]')).forEach(init);
    document.addEventListener('shopify:section:load', function (e) {
      init(e.target.querySelector('[data-compact-pdp]'));
    });
  })();
</script>

{% schema %}
{
  "name": "Product (compact)",
  "tag": "section",
  "class": "section-compact-pdp",
  "settings": [
    {
      "type": "paragraph",
      "content": "A short product page for products sold on their own page. Prices, sizes, stock and photos come from the product."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading above the name",
      "default": "Daily softgel"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Pumpkin seed oil in an easy daily softgel. It's the same oil as in our nightly scalp serum, taken by mouth, so it supports your hair from the inside, across your whole scalp.</p>"
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Sale tag next to the price",
      "default": "Save {percent}%",
      "info": "Shown when the size has a compare-at price. {percent} is the saving. Leave empty to hide."
    },
    {
      "type": "inline_richtext",
      "id": "deal_note",
      "label": "Deal note above the button",
      "info": "For an automatic discount, such as a Buy 2, Get 1 Free set up in Shopify → Discounts. The theme only shows this text; the discount itself is applied by Shopify in the cart. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "option_suffix",
      "label": "Text after each size",
      "info": "For example \" softgels\" turns 30 into 30 softgels. Leave empty to show the size as it is."
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "textarea",
      "id": "perks",
      "label": "Perks under the button",
      "info": "One per line, each shown with a tick.",
      "default": "Free insured shipping on every order\nPairs with the Elaren scalp serum"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#faf7f0"
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Expandable detail",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add the details here.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "pairing",
      "name": "Pairs with",
      "limit": 1,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Small heading",
          "default": "Pairs with"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "The nightly scalp serum for the areas you notice most."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to go to the buy box on the home page."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop the serum"
        }
      ]
    }
  ]
}
{% endschema %}
