{% comment %}
  Bundle fit quiz. Three questions, one result screen that matches the visitor to the Elaren bundle
  that fits how their hair is thinning and how they want to go about it. Nearly every path is a
  positive match; the one exception is the "see a doctor first" answer, which we keep on purpose.

  Blocks:
    question  - one question (order in the sidebar = order asked)
    option    - an answer; "Belongs to question" says which question it appears under and "Points to"
                the bundle it argues for (starter / core / full), "medical" for the doctor off-ramp,
                or "none" for an answer that only adds a note to the result
    result    - the screen shown for one band (starter, core, full, medical)

  How the band is decided (assets/main.js, initFitQuiz):
    1. any answer pointing to "medical" wins - those visitors are told to see a doctor, not to buy;
    2. otherwise the bundle with the most answers wins; a tie goes to "core" (the 3-month bundle).
  Every answer may carry a "note", repeated on the result under "Why this fits you", and every result
  hands the visitor to the buy box with its bundle tier pre-selected.
{% endcomment %}
{%- liquid
  assign questions = section.blocks | where: 'type', 'question'
  assign options = section.blocks | where: 'type', 'option'
  assign results = section.blocks | where: 'type', 'result'
  assign cta_target = section.settings.cta_link | default: '#product-section' | remove: '#'
  comment
    Placeholders are swapped inside this liquid tag: a literal "{" in an output tag trips Shopify's parser.
  endcomment
  assign current_placeholder = '{current}'
  assign total_placeholder = '{total}'
  assign step_text = section.settings.step_label | replace: current_placeholder, '1' | replace: total_placeholder, questions.size
-%}
<section class="shopify-section section" id="shopify-section-{{ section.id }}-fit-quiz">
<div class="s-fit-quiz custom-section{% if section.settings.background %} s-fit-quiz--background{% endif %}" data-fit-quiz data-section-id="{{ section.id }}">
  <div class="s-fit-quiz__container">
    <header class="s-fit-quiz__head">
      {%- if section.settings.eyebrow != blank -%}<p class="s-fit-quiz__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="s-fit-quiz__title section-title"><p>{{ section.settings.title }}</p></h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="s-fit-quiz__intro">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <div class="s-fit-quiz__card" data-quiz-card>
      {%- if questions.size > 0 -%}
      <div class="s-fit-quiz__progress" data-quiz-progress>
        <span class="s-fit-quiz__step" data-quiz-step>{{ step_text }}</span>
        <span class="s-fit-quiz__dots" aria-hidden="true">
          {%- for question in questions -%}<span class="s-fit-quiz__dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
        </span>
      </div>

      {%- for question in questions -%}
        <fieldset class="s-fit-quiz__question{% unless forloop.first %} is-hidden{% endunless %}" data-quiz-question="{{ forloop.index }}" {{ question.shopify_attributes }}>
          <legend class="s-fit-quiz__question-title">{{ question.settings.text }}</legend>
          {%- if question.settings.hint != blank -%}<p class="s-fit-quiz__question-hint">{{ question.settings.hint }}</p>{%- endif -%}
          <div class="s-fit-quiz__options">
            {%- for option in options -%}
              {%- if option.settings.question == forloop.parentloop.index -%}
              <button class="s-fit-quiz__option" type="button" data-quiz-option data-band="{{ option.settings.band }}" {{ option.shopify_attributes }}>
                <span class="s-fit-quiz__option-check" aria-hidden="true"></span>
                <span class="s-fit-quiz__option-label">{{ option.settings.label }}</span>
                {%- if option.settings.note != blank -%}<span class="s-fit-quiz__option-note" data-quiz-note hidden>{{ option.settings.note }}</span>{%- endif -%}
              </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endfor -%}

      <div class="s-fit-quiz__nav">
        <button class="s-fit-quiz__back" type="button" data-quiz-back hidden>{{ section.settings.back_label }}</button>
      </div>
      {%- elsif request.design_mode -%}
      <p class="s-fit-quiz__empty">Add "Question" and "Answer" blocks to build the quiz.</p>
      {%- endif -%}

      {%- for result in results -%}
        {%- liquid
          assign tier = result.settings.bundle_tier | default: 0
          assign cta_label = result.settings.cta_label
          if cta_label == blank
            assign cta_label = section.settings.cta_label
          endif
        -%}
        <div class="s-fit-quiz__result s-fit-quiz__result--{{ result.settings.band }} is-hidden" data-quiz-result="{{ result.settings.band }}" role="status" {{ result.shopify_attributes }}>
          {%- if result.settings.tag != blank -%}<span class="s-fit-quiz__result-tag">{{ result.settings.tag }}</span>{%- endif -%}
          {%- if result.settings.title != blank -%}<h3 class="s-fit-quiz__result-title">{{ result.settings.title }}</h3>{%- endif -%}
          {%- if result.settings.body != blank -%}<div class="s-fit-quiz__result-body">{{ result.settings.body }}</div>{%- endif -%}
          {%- if result.settings.expect != blank -%}
          <div class="s-fit-quiz__result-row"><span class="s-fit-quiz__result-row-label">{{ section.settings.expect_label }}</span><div class="s-fit-quiz__result-row-text">{{ result.settings.expect }}</div></div>
          {%- endif -%}
          {%- if result.settings.evidence != blank -%}
          <div class="s-fit-quiz__result-row"><span class="s-fit-quiz__result-row-label">{{ section.settings.evidence_label }}</span><div class="s-fit-quiz__result-row-text">{{ result.settings.evidence }}</div></div>
          {%- endif -%}
          {%- comment -%} Filled by assets/main.js with the "note" of every answer the visitor picked (the questions people ask on TikTok: how to use it, minoxidil, timeline, proof). {%- endcomment -%}
          <div class="s-fit-quiz__result-row s-fit-quiz__result-row--notes" data-quiz-notes hidden><span class="s-fit-quiz__result-row-label">{{ section.settings.notes_label }}</span><ul class="s-fit-quiz__notes"></ul></div>
          {%- if result.settings.show_cta and cta_label != blank -%}
          <a class="s-fit-quiz__cta custom-button" href="#{{ cta_target }}" data-scroll-to="{{ cta_target }}" data-quiz-tier="{{ tier }}">{{ cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.restart_label != blank -%}
          <button class="s-fit-quiz__restart" type="button" data-quiz-restart>{{ section.settings.restart_label }}</button>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}<p class="s-fit-quiz__footnote">{{ section.settings.footnote }}</p>{%- endif -%}
  </div>
</div>
</section>

{% schema %}
{
