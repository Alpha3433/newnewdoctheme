{% comment %}
  "Why women are switching" – images, heading, text blocks and the ingredient-level legend, all editable.
  The wrapper id is kept so the verbatim CSS in assets/sections-inline.css still applies.
{% endcomment %}
{%- liquid
  assign texts = section.blocks | where: 'type', 'text'
  assign levels = section.blocks | where: 'type', 'level'
-%}
<div class="shopify-section" id="shopify-section-template--26717513089391__custom_image_with_text_blocks_bwNcEH"><section class="s-image-with-text-blocks custom-section">
  <div class="s-image-with-text-blocks__container">

    <div class="s-image-with-text-blocks__images">
      <picture>
        {%- render 'froya-image', image: section.settings.image, fallback: 'https://froyaorganics.com/cdn/shop/files/snoesea_buckthorn_at_winter_jaak_nilson_1_06ae5332-18b6-4521-be5c-dc1008d3a728.jpg', alt: section.settings.image_alt, class: 's-image-with-text-blocks__image--desktop', width: 600, height: 1058, sizes: '(min-width: 990px) 40vw, 100vw' -%}
      </picture>
      <picture>
        {%- render 'froya-image', image: section.settings.image_small, fallback: 'https://froyaorganics.com/cdn/shop/files/desktop-small-image.png', alt: section.settings.image_alt, class: 's-image-with-text-blocks__image--desktop-small', width: 299, height: 299 -%}
      </picture>
    </div>

    <div class="s-image-with-text-blocks__content">
      <h2 class="s-image-with-text-blocks__title"><p>{{ section.settings.title | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' }}</p></h2>

      <div class="s-image-with-text-blocks__top-image">
        <picture>
          {%- render 'froya-image', image: section.settings.image_mobile_top, fallback: 'https://froyaorganics.com/cdn/shop/files/mobile-top-image.png', alt: section.settings.image_alt, width: 390, height: 271, sizes: '100vw' -%}
        </picture>
      </div>

      {%- for block in texts -%}
        <div class="s-image-with-text-blocks__text-block" {{ block.shopify_attributes }}>
          <h3 class="s-image-with-text-blocks__text-title"><p><em>{{ block.settings.title }}</em></p></h3>
          <div class="s-image-with-text-blocks__text">{{ block.settings.text }}</div>
          {%- if forloop.first and levels.size > 0 -%}
            <div class="s-image-with-text-blocks__html">
              <div>
                {%- for level in levels -%}
                  <div {{ level.shopify_attributes }}>
                    <svg fill="none" height="14" viewBox="0 0 14 14" width="14" xmlns="http://www.w3.org/2000/svg"><circle cx="7.47363" cy="7.33203" fill="{{ level.settings.color }}" r="6.5"></circle></svg>
                    <span>{{ level.settings.label }}</span>
                  </div>
                {%- endfor -%}
              </div>
              {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link_url | default: '#product-section' }}">{{ section.settings.link_label }}</a>{%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}

      <div class="s-image-with-text-blocks__bottom-image">
        <picture>
          {%- render 'froya-image', image: section.settings.image_bottom, fallback: 'https://froyaorganics.com/cdn/shop/files/image9_b22bd9ba-198e-45fc-b3e7-dc5dbb7e9c81.jpg', alt: section.settings.image_alt, width: 600, height: 417, sizes: '(min-width: 990px) 40vw, 100vw' -%}
        </picture>
      </div>
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Ingredient quality",
  "tag": "section",
  "settings": [
    { "type": "richtext", "id": "title", "label": "Heading", "default": "<p>Why women are <br><em>switching</em> to Elaren</p>" },
    { "type": "image_picker", "id": "image", "label": "Main image (desktop)", "info": "Tall portrait, about 600 × 1060 px." },
    { "type": "image_picker", "id": "image_small", "label": "Small overlay image (desktop)", "info": "Square, about 300 × 300 px." },
    { "type": "image_picker", "id": "image_mobile_top", "label": "Top image (mobile)", "info": "About 390 × 270 px." },
    { "type": "image_picker", "id": "image_bottom", "label": "Bottom image", "info": "About 600 × 420 px." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Cold-pressed pumpkin seed oil" },
    { "type": "text", "id": "link_label", "label": "Link label under the legend", "default": "LEARN MORE" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text block",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Ingredients" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The <em><strong>ingredients</strong></em> make the product.</p>" }
      ]
    },
    {
      "type": "level",
      "name": "Legend row",
      "settings": [
        { "type": "color", "id": "color", "label": "Dot colour", "default": "#7DC722" },
        { "type": "text", "id": "label", "label": "Label", "default": "level 5 - cold-pressed" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Ingredient quality", "blocks": [ { "type": "text" }, { "type": "text" }, { "type": "text" } ] } ]
}
{% endschema %}
