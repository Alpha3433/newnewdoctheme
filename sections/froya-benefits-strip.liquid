{% comment %}
  Benefits strip – four icon + text items, each an editable block.
  The wrapper ids are kept so the verbatim CSS in assets/sections-inline.css still applies.
{% endcomment %}
<section class="shopify-section section" id="shopify-section-template--26717513089391__icons_with_text_hPpB9d">
<section class="s-icons-with-text-custom custom-section" id="section-template--26717513089391__icons_with_text_hPpB9d">
  <div class="s-icons-with-text-custom__content-wrapper container"><div class="s-icons-with-text-custom__bottom" style="--small-icon-count: {{ section.blocks.size | at_least: 1 }};">
    {%- for block in section.blocks -%}
      <div class="s-icons-with-text-custom__small-icon-item" {{ block.shopify_attributes }}><div class="s-icons-with-text-custom__small-icon">
        <picture>
          {%- render 'froya-image', image: block.settings.icon, fallback: block.settings.icon_fallback, alt: block.settings.text, width: 38, height: 38 -%}
        </picture></div><div class="s-icons-with-text-custom__small-icon-text" style="--small-icon-text-color: {{ section.settings.text_color }};--small-icon-font-weight: 500;--small-icon-line-height: 1.2;"><h5>{{ block.settings.text }}</h5></div></div>
    {%- endfor -%}
  </div></div></section>
</section>

{% schema %}
{
  "name": "Benefits strip",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#1f1f1f" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "Square icon, about 38 × 38 px." },
        { "type": "text", "id": "text", "label": "Text", "default": "Shedding visibly reduced" },
        { "type": "text", "id": "icon_fallback", "label": "Fallback icon URL", "info": "Used only until an icon is uploaded." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Benefits strip",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Shedding visibly reduced" } },
        { "type": "benefit", "settings": { "text": "Follicles fed & reawakened" } },
        { "type": "benefit", "settings": { "text": "Part, crown & edges look fuller" } },
        { "type": "benefit", "settings": { "text": "Confidence back in the mirror" } }
      ]
    }
  ]
}
{% endschema %}
