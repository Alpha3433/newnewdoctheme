{% comment %}
  Comparison advertorial – side-by-side table, one row per product and up to five feature columns.
  Cell values: "yes" shows a green ✓ Yes, "no" a red ✗ No ("yes: text" or "no: text" changes the
  word), "~ text" an amber note, anything else plain text. Tick "Highlight" on the winning row.
  Each row can show a small product photo beside the name. On phones the table scrolls sideways
  with the product names pinned.
{% endcomment %}
{{ 'advertorial.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign cols = 0
  for i in (1..5)
    assign key = 'col_' | append: i
    if section.settings[key] != blank
      assign cols = i
    endif
  endfor
-%}
<section class="adv" data-anchor="{{ section.settings.anchor | default: 'comparison' | handle }}" id="adv-{{ section.id }}">
  <div class="adv__read">
    {%- if section.settings.rule -%}<hr class="adv__rule">{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="adv__h2">{{ section.settings.title }}</h2>{%- endif -%}
    <div class="adv-table__scroller">
      <table class="adv-table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col_product }}</th>
            {%- for i in (1..cols) -%}
              {%- assign key = 'col_' | append: i -%}
              <th scope="col">{{ section.settings[key] }}</th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr{% if block.settings.highlight %} class="is-win"{% endif %} {{ block.shopify_attributes }}>
              {%- liquid
                assign thumb = block.settings.image
                if thumb == blank and block.settings.product != blank
                  assign thumb = block.settings.product.featured_image
                endif
              -%}
              <th scope="row">
                <span class="adv-table__prod">
                  {%- if thumb != blank -%}
                    <span class="adv-table__thumb">{{ thumb | image_url: width: 120 | image_tag: alt: '', loading: 'lazy', sizes: '42px', widths: '60, 90, 120' }}</span>
                  {%- endif -%}
                  <span>{{ block.settings.name }}</span>
                </span>
              </th>
              {%- for i in (1..cols) -%}
                {%- liquid
                  assign key = 'v' | append: i
                  assign raw = block.settings[key] | strip
                  assign first = raw | slice: 0
                  assign parts = raw | split: ':'
                  assign word = parts[0] | strip | downcase
                  assign extra = raw | remove_first: parts[0] | remove_first: ':' | strip
                -%}
                <td>
                  {%- if first == '~' -%}
                    <span class="adv-table__v adv-table__v--partial">~ {{ raw | remove_first: '~' | strip }}</span>
                  {%- elsif word == 'yes' -%}
                    <span class="adv-table__v adv-table__v--yes">✓ {% if extra != blank %}{{ extra }}{% else %}Yes{% endif %}</span>
                  {%- elsif word == 'no' -%}
                    <span class="adv-table__v adv-table__v--no">✗ {% if extra != blank %}{{ extra }}{% else %}No{% endif %}</span>
                  {%- else -%}
                    {{ raw }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.hint != blank -%}<p class="adv-table__hint">{{ section.settings.hint }}</p>{%- endif -%}
    {%- if section.settings.note != blank -%}<p class="adv-table__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Side-by-side table",
  "tag": "section",
  "class": "shopify-section--adv",
  "settings": [
    { "type": "checkbox", "id": "rule", "label": "Line above this section", "default": true },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Side-by-Side Comparison" },
    { "type": "text", "id": "anchor", "label": "Anchor name", "default": "comparison" },
    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "col_product", "label": "First column", "default": "Product" },
    { "type": "text", "id": "col_1", "label": "Column 1", "default": "Pumpkin seed oil" },
    { "type": "text", "id": "col_2", "label": "Column 2", "default": "Caffeine" },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Women’s formula?" },
    { "type": "text", "id": "col_4", "label": "Column 4", "default": "Cold-pressed?" },
    { "type": "text", "id": "col_5", "label": "Column 5", "default": "Filler-free?" },
    { "type": "text", "id": "hint", "label": "Swipe hint (phones)", "default": "Swipe to see every column →" },
    { "type": "textarea", "id": "note", "label": "Note under the table" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Product row",
      "settings": [
        { "type": "text", "id": "name", "label": "Product", "default": "Product" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight", "default": false },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Small product photo beside the name." },
        { "type": "product", "id": "product", "label": "Use this product’s photo", "info": "Used when no photo is picked." },
        { "type": "text", "id": "v1", "label": "Column 1", "info": "yes, no, yes: text, no: text, ~ text, or plain text.", "default": "no" },
        { "type": "text", "id": "v2", "label": "Column 2", "default": "no" },
        { "type": "text", "id": "v3", "label": "Column 3", "default": "no" },
        { "type": "text", "id": "v4", "label": "Column 4", "default": "no" },
        { "type": "text", "id": "v5", "label": "Column 5", "default": "no" }
      ]
    }
  ],
  "presets": [ { "name": "Side-by-side table", "blocks": [ { "type": "row" }, { "type": "row" } ] } ]
}
{% endschema %}
