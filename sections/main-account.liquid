<div class="page-width">
  <h1 class="page-title">{{ 'customer.account.title' | t }}</h1>
  <p style="margin-bottom: 24px;"><a class="link-underline" href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a></p>
  <div class="account-grid">
    <div>
      <h2 class="product-card__title" style="margin-bottom: 12px;">{{ 'customer.account.order_history' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="cart-table">
            <thead><tr><th>Order</th><th>Date</th><th>Status</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a class="link-underline" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%B %d, %Y' }}</td>
                  <td>{{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
          {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
        {%- else -%}
          <p>{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
    <div>
      <h2 class="product-card__title" style="margin-bottom: 12px;">{{ customer.name }}</h2>
      {%- if customer.default_address -%}<div class="address-card">{{ customer.default_address | format_address }}</div>{%- endif -%}
      <a class="link-underline" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Account",
  "settings": []
}
{% endschema %}
