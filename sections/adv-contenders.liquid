{% comment %}
  Comparison advertorial – "the rest of the field". Contender blocks are white cards: rank, name,
  subtitle, write-up, product photo (shown whole on a grey tile; a soft placeholder until one is
  picked), "what it gets right" and "falls short" lists (one point per line) and a bold one-line verdict. Button blocks drop a
  "Still reading?" call to action between cards; an honourable mention closes the list.
{% endcomment %}
{{ 'advertorial.css' | asset_url | stylesheet_tag }}
<section class="adv" data-anchor="{{ section.settings.anchor | default: 'ranking' | handle }}" id="adv-{{ section.id }}">
  <div class="adv__read">
    {%- if section.settings.rule -%}<hr class="adv__rule">{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="adv__h2">{{ section.settings.title }}</h2>{%- endif -%}
    <div class="adv-field">
      {%- assign tone = 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'contender' -%}
            {%- assign tone = tone | modulo: 4 | plus: 1 -%}
            {%- assign b = block.settings -%}
            <article class="adv-field__card" {{ block.shopify_attributes }}>
              <div class="adv-field__top">
                <div>
                  {%- if b.rank != blank -%}<span class="adv-field__rank">{{ b.rank }}</span>{%- endif -%}
                  <h3 class="adv-field__name">{{ b.name }}</h3>
                  {%- if b.subtitle != blank -%}<p class="adv-field__sub">{{ b.subtitle }}</p>{%- endif -%}
                  {%- if b.text != blank -%}<div class="adv-field__text">{{ b.text }}</div>{%- endif -%}
                </div>
                <div class="adv-field__media{% if b.image != blank %} adv-field__media--photo{% endif %}">
                  {%- if b.image != blank -%}
                    {{ b.image | image_url: width: 640 | image_tag: alt: b.name, loading: 'lazy', sizes: '(min-width: 768px) 210px, 100vw', widths: '320, 480, 640' }}
                  {%- else -%}
                    {%- render 'adv-placeholder', label: b.placeholder, tone: tone -%}
                  {%- endif -%}
                </div>
              </div>

              {%- if b.pros != blank or b.cons != blank -%}
                <div class="adv-field__cols">
                  {%- if b.pros != blank -%}
                    {%- assign items = b.pros | newline_to_br | split: '<br />' -%}
                    <div class="adv-field__col">
                      <p class="adv-field__col-title">{{ section.settings.pros_title }}</p>
                      <ul class="adv-field__list">
                        {%- for item in items -%}
                          {%- assign t = item | strip -%}
                          {%- if t != blank -%}<li>{%- render 'adv-mark', value: 'yes' -%}<span>{{ t }}</span></li>{%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                  {%- if b.cons != blank -%}
                    {%- assign items = b.cons | newline_to_br | split: '<br />' -%}
                    <div class="adv-field__col adv-field__col--cons">
                      <p class="adv-field__col-title">{{ section.settings.cons_title }}</p>
                      <ul class="adv-field__list">
                        {%- for item in items -%}
                          {%- assign t = item | strip -%}
                          {%- if t != blank -%}<li>{%- render 'adv-mark', value: 'no' -%}<span>{{ t }}</span></li>{%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if b.verdict != blank -%}<p class="adv-field__verdict">{{ b.verdict }}</p>{%- endif -%}
            </article>
          {%- when 'cta' -%}
            {%- render 'adv-cta', lead: block.settings.lead, label: block.settings.label, url: block.settings.url, note: block.settings.note, attrs: block.shopify_attributes -%}
          {%- when 'mention' -%}
            <div class="adv-field__mention" {{ block.shopify_attributes }}>
              <p class="adv-field__mention-title">{{ block.settings.title }}</p>
              <p class="adv-field__mention-text">{{ block.settings.text }}</p>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rest of the field",
  "tag": "section",
  "class": "shopify-section--adv",
  "settings": [
    { "type": "checkbox", "id": "rule", "label": "Line above this section", "default": true },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Ranks 2 to 10: The Rest of the Field" },
    { "type": "text", "id": "pros_title", "label": "Good points label", "default": "What it gets right" },
    { "type": "text", "id": "cons_title", "label": "Weak points label", "default": "Falls short" },
    { "type": "text", "id": "anchor", "label": "Anchor name", "default": "ranking" }
  ],
  "blocks": [
    {
      "type": "contender",
      "name": "Product",
      "settings": [
        { "type": "text", "id": "rank", "label": "Rank", "default": "#2" },
        { "type": "text", "id": "name", "label": "Name", "default": "Rosemary oil serum" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "richtext", "id": "text", "label": "Write-up" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "A product photo works best. It is shown whole on a soft grey tile." },
        { "type": "text", "id": "placeholder", "label": "Text on the placeholder tile", "info": "Shown until a photo is uploaded." },
        { "type": "textarea", "id": "pros", "label": "What it gets right", "info": "One point per line." },
        { "type": "textarea", "id": "cons", "label": "Falls short", "info": "One point per line." },
        { "type": "text", "id": "verdict", "label": "One-line verdict" }
      ]
    },
    {
      "type": "cta",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "lead", "label": "Line above the button", "default": "Still reading?" },
        { "type": "text", "id": "label", "label": "Label", "default": "Shop the best version" },
        { "type": "text", "id": "url", "label": "Link", "default": "#shop", "info": "#shop scrolls to the buy box on this page." },
        { "type": "text", "id": "note", "label": "Guarantee line" }
      ]
    },
    {
      "type": "mention",
      "name": "Honourable mention",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Honourable mention" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [ { "name": "Rest of the field", "blocks": [ { "type": "contender" }, { "type": "contender" } ] } ]
}
{% endschema %}
