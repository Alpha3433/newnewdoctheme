{% comment %}
  Comparison advertorial – the closing pick ("here is where we'd spend our money"): coral heading,
  a photo with a soft coral glow beside the closing copy, then the button and guarantee line.
  The photo falls back to the chosen product's main image until one is uploaded.
{% endcomment %}
{{ 'advertorial.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign product = section.settings.product
  assign photo = section.settings.image
  if photo == blank
    assign photo = product.featured_image
  endif
-%}
<section class="adv adv-final" data-anchor="{{ section.settings.anchor | default: 'verdict' | handle }}" id="adv-{{ section.id }}">
  <div class="adv__read">
    {%- if section.settings.rule -%}<hr class="adv__rule">{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="adv-final__title">{{ section.settings.title }}</h2>{%- endif -%}
    <div class="adv-final__grid">
      <div class="adv-final__media">
        {%- if photo != blank -%}
          {{ photo | image_url: width: 900 | image_tag: alt: section.settings.image_alt, loading: 'lazy', sizes: '(min-width: 768px) 300px, 100vw', widths: '400, 600, 900' }}
        {%- else -%}
          {%- render 'adv-placeholder', label: section.settings.image_alt, tone: 1 -%}
        {%- endif -%}
      </div>
      <div class="adv-rte adv-final__text">{{ section.settings.text }}</div>
    </div>
    {%- if section.settings.button_label != blank -%}
      {%- render 'adv-cta', label: section.settings.button_label, url: section.settings.button_url, note: section.settings.note -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Closing pick",
  "tag": "section",
  "class": "shopify-section--adv",
  "settings": [
    { "type": "checkbox", "id": "rule", "label": "Line above this section", "default": true },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "After Comparing All 10: Here’s Where We’d Spend Our Money" },
    { "type": "text", "id": "anchor", "label": "Anchor name", "default": "verdict" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Landscape, about 900 × 500 px. The product photo is used until one is uploaded." },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "image_alt", "label": "Photo alt text", "default": "Elaren Pumpkin Seed Oil Serum" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "default": "Start today risk free" },
    { "type": "text", "id": "button_url", "label": "Link", "default": "#shop", "info": "#shop scrolls to the buy box on this page." },
    { "type": "text", "id": "note", "label": "Guarantee line", "default": "30-day money-back guarantee" }
  ],
  "presets": [ { "name": "Closing pick" } ]
}
{% endschema %}
