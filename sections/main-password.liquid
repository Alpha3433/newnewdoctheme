<h1 class="page-title">{{ shop.name }}</h1>
{%- if shop.password_message != blank -%}<p class="rte">{{ shop.password_message }}</p>{%- endif -%}
{%- form 'storefront_password' -%}
  <h2 class="product-card__title" style="margin: 24px 0 12px;">{{ 'general.password_page.login_form_heading' | t }}</h2>
  {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
  <div class="form-field">
    <label for="password">{{ 'general.password_page.login_form_password_label' | t }}</label>
    <input type="password" name="password" id="password" autocomplete="current-password">
  </div>
  <button type="submit" class="custom-button">{{ 'general.password_page.login_form_submit' | t }}</button>
{%- endform -%}

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
