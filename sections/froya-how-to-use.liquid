{% comment %}
  How to use – heading, image and a list of routine steps (each an editable block).
  The wrapper id is kept so the verbatim CSS in assets/sections-inline.css still applies.
{% endcomment %}
{%- liquid
  assign sid = 'template--26717513089391__how_to_use_Qx9RrL'
-%}
<div class="shopify-section" id="shopify-section-{{ sid }}">
<section class="s-how-to-use custom-section" data-section-id="{{ sid }}">
  <h2 class="s-how-to-use__title s-how-to-use__title--mobile section-title">
    <p></p><p>{{ section.settings.title | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' }}</p><p></p>
  </h2>

  <div class="s-how-to-use__content-wrapper">
    <div class="s-how-to-use__image-wrapper">
      <picture>
        {%- render 'froya-image', image: section.settings.image, fallback: 'https://froyaorganics.com/cdn/shop/files/Hero_9653fcf2-b13b-4472-9891-476cc9621d68.png', alt: section.settings.image_alt, width: 600, height: 416, sizes: '(min-width: 990px) 45vw, 100vw' -%}
      </picture>
    </div>

    <div class="s-how-to-use__content">
      <h2 class="s-how-to-use__title s-how-to-use__title--desktop section-title">
        <p></p><p>{{ section.settings.title | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' }}</p><p></p>
      </h2>

      {%- for block in section.blocks -%}
        <div class="s-how-to-use__text-block s-how-to-use__text-block--line{% if forloop.last %} s-how-to-use__text-block--line--last{% endif %}" {{ block.shopify_attributes }}>
          <h3 class="s-how-to-use__block-title s-how-to-use__block-title--line"><p>{{ block.settings.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' }}</p></h3>
          <div class="s-how-to-use__block-text">
            {%- if block.settings.label != blank -%}<h5>{{ block.settings.label }}</h5>{%- endif -%}
            {{ block.settings.text }}
            {%- if block.settings.label_2 != blank -%}<h5>{{ block.settings.label_2 }}</h5>{%- endif -%}
            {{ block.settings.text_2 }}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "How to use",
  "tag": "section",
  "settings": [
    { "type": "richtext", "id": "title", "label": "Heading", "default": "<p><em>Two minutes a night.</em><br>Because regrowth shouldn’t be complicated.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape image, about 600 × 420 px." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Applying Elaren Pumpkin Seed Regrowth Oil to the scalp" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "richtext", "id": "heading", "label": "Step heading", "default": "<p><em>Every night – The 2-minute scalp ritual</em></p>" },
        { "type": "text", "id": "label", "label": "Product label", "default": "REGROWTH OIL" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p><strong>Part your hair and apply a few drops directly to the scalp where it’s thinning: your part, crown, temples or edges. Massage in with your fingertips for 60 seconds to get the blood flowing, then leave it in overnight. No rinsing, no greasy residue, and a little goes a long way.</strong></p>" },
        { "type": "text", "id": "label_2", "label": "Second product label (optional)" },
        { "type": "richtext", "id": "text_2", "label": "Second text (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "How to use", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
