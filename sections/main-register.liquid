<div class="page-width page-width--narrow">
  <h1 class="page-title">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="form-field"><label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label><input type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name"></div>
    <div class="form-field"><label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label><input type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name"></div>
    <div class="form-field"><label for="RegisterEmail">{{ 'customer.register.email' | t }}</label><input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email"></div>
    <div class="form-field"><label for="RegisterPassword">{{ 'customer.register.password' | t }}</label><input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password"></div>
    <button type="submit" class="custom-button">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Register",
  "settings": []
}
{% endschema %}
