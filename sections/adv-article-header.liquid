{% comment %}
  Comparison advertorial – masthead and article header: eyebrow, headline, italic dek, byline and
  the lead photo. The photo falls back to the chosen product's main image until one is uploaded.
  "Hide the store header" removes the announcement bar and the store menu on pages that use this
  section (the cart drawer stays, so add to cart still works).
{% endcomment %}
{{ 'advertorial.css' | asset_url | stylesheet_tag }}
{%- assign product = section.settings.product -%}
{%- if section.settings.hide_store_header -%}
  <style>.froya-nav-section, .shopify-section--announcement-bar { display: none !important; }</style>
{%- endif -%}
{%- if section.settings.masthead_left != blank or section.settings.masthead_right != blank -%}
  <div class="adv adv-masthead">
    <div class="adv__read adv-masthead__inner">
      <span>{{ section.settings.masthead_left }}</span>
      <span>{{ section.settings.masthead_right }}</span>
    </div>
  </div>
{%- endif -%}
<section class="adv adv-header" id="adv-{{ section.id }}">
  <div class="adv__read">
    {%- if section.settings.eyebrow != blank -%}<p class="adv__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="adv__h1">{{ section.settings.title }}</h1>
    {%- if section.settings.dek != blank -%}<p class="adv-header__dek">{{ section.settings.dek }}</p>{%- endif -%}
    {%- if section.settings.byline != blank -%}<p class="adv-header__byline">{{ section.settings.byline }}</p>{%- endif -%}

    {%- liquid
      assign lead_image = section.settings.image
      if lead_image == blank
        assign lead_image = product.featured_image
      endif
    -%}
    {%- if lead_image != blank -%}
      <figure class="adv-header__figure">
        {{ lead_image | image_url: width: 1520 | image_tag: alt: section.settings.image_alt, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 800px) 760px, 100vw', widths: '400, 600, 800, 1000, 1200, 1520' }}
        {%- if section.settings.caption != blank -%}<figcaption class="adv-header__caption">{{ section.settings.caption }}</figcaption>{%- endif -%}
      </figure>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Article header",
  "tag": "section",
  "class": "shopify-section--adv",
  "settings": [
    { "type": "checkbox", "id": "hide_store_header", "label": "Hide the store header", "info": "Removes the announcement bar and the store menu on this page. The cart drawer still opens on add to cart.", "default": true },
    { "type": "header", "content": "Masthead" },
    { "type": "text", "id": "masthead_left", "label": "Left text", "default": "Elaren Hair Journal", "info": "Slim bar above the article. Empty both texts to hide it." },
    { "type": "text", "id": "masthead_right", "label": "Right text", "default": "Advertorial", "info": "Paid comparison pages should say they are advertising." },
    { "type": "header", "content": "Article" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Hair serum comparison · 2026" },
    { "type": "inline_richtext", "id": "title", "label": "Headline", "info": "Italic text shows in coral.", "default": "We Compared 10 Hair Growth Serums for Thinning Hair. <em>Here’s the Truth.</em>" },
    { "type": "textarea", "id": "dek", "label": "Subheadline", "default": "Most serums are selling you water and silicone in a nice bottle. One actually built a formula for women’s hair loss." },
    { "type": "text", "id": "byline", "label": "Byline", "default": "By the Elaren Hair Journal team · 5 min read" },
    { "type": "header", "content": "Lead photo" },
    { "type": "image_picker", "id": "image", "label": "Lead photo", "info": "Landscape, about 1520 × 860 px." },
    { "type": "product", "id": "product", "label": "Or use a product photo", "info": "Its main photo is shown until a lead photo is uploaded." },
    { "type": "text", "id": "image_alt", "label": "Photo alt text", "default": "Elaren Pumpkin Seed Oil Serum" },
    { "type": "text", "id": "caption", "label": "Caption" }
  ],
  "presets": [ { "name": "Article header" } ]
}
{% endschema %}
