{% comment %}
  "Backed by science" timeline – heading, the two stacked photos and each numbered step editable in the theme editor.
  The wrapper ids are kept so the verbatim CSS in assets/sections-inline.css still applies.
{% endcomment %}
{%- liquid
  assign sid = 'template--26717513089391__backed_by_science_VNNFmb'
  assign image_1_fallback = section.settings.image_1_fallback
  assign image_2_fallback = section.settings.image_2_fallback
-%}
<div class="shopify-section shopify-section-backed-by-science" data-anchor="science" id="shopify-section-{{ sid }}">
<section aria-labelledby="s-backed-by-science-title-{{ sid }}" class="s-backed-by-science" data-section-id="{{ sid }}" id="s-backed-by-science-{{ sid }}">
  <div class="s-backed-by-science__container">
    <header class="s-backed-by-science__header">
      {%- if section.settings.eyebrow != blank -%}<p class="s-backed-by-science__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="s-backed-by-science__title" id="s-backed-by-science-title-{{ sid }}"><p>{{ section.settings.title }}</p></h2>
      {%- if section.settings.subtitle != blank -%}<p class="s-backed-by-science__subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
    </header>

    <div class="s-backed-by-science__body"><div aria-hidden="true" class="s-backed-by-science__images">
        <figure class="s-backed-by-science__figure">
          {%- render 'froya-image', image: section.settings.image_1, fallback: image_1_fallback, alt: '', class: 's-backed-by-science__image', width: 1200, height: 896, sizes: '(min-width: 768px) 590px, calc(100vw - 32px)' -%}
        </figure>
        <figure class="s-backed-by-science__figure">
          {%- render 'froya-image', image: section.settings.image_2, fallback: image_2_fallback, alt: '', class: 's-backed-by-science__image', width: 1200, height: 896, sizes: '(min-width: 768px) 590px, calc(100vw - 32px)' -%}
        </figure>
      </div><ol class="s-backed-by-science__list">
        {%- for block in section.blocks -%}
          <li class="s-backed-by-science__item" {{ block.shopify_attributes }}>
            <span aria-hidden="true" class="s-backed-by-science__num">{{ forloop.index }}</span>
            <article class="s-backed-by-science__card">
              <picture class="s-backed-by-science__icon">
                {%- render 'froya-image', image: block.settings.icon, fallback: block.settings.icon_fallback, alt: '', width: 36, height: 36 -%}
              </picture>
              <h3 class="s-backed-by-science__card-title">{{ block.settings.title }}</h3>
              <p class="s-backed-by-science__card-text">{{ block.settings.text }}</p>
            </article>
          </li>
        {%- endfor -%}
      </ol></div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Backed by science",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Backed By Science" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "How Pumpkin Seed Regrowth Oil Works" },
    { "type": "textarea", "id": "subtitle", "label": "Subheading", "default": "5 research-backed ways it targets why women’s hair thins after 35. No drugs, no hormones, just pumpkin seed oil and caffeine." },
    { "type": "header", "content": "Photos", "info": "Two landscape photos stacked beside the steps (about 1200 × 900 px each, 4:3)." },
    { "type": "image_picker", "id": "image_1", "label": "Top photo" },
    { "type": "text", "id": "image_1_fallback", "label": "Fallback top photo URL", "info": "Used only until a photo is uploaded.", "default": "https://cdn.shopify.com/s/files/1/0864/8805/6165/files/science-serum-daisies.png?v=1789651243" },
    { "type": "image_picker", "id": "image_2", "label": "Bottom photo" },
    { "type": "text", "id": "image_2_fallback", "label": "Fallback bottom photo URL", "info": "Used only until a photo is uploaded.", "default": "https://cdn.shopify.com/s/files/1/0864/8805/6165/files/science-serum-held.png?v=1789651243" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "About 36 × 36 px." },
        { "type": "text", "id": "title", "label": "Title", "default": "Blocks DHT At The Follicle" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Pumpkin seed oil is rich in phytosterols shown to inhibit 5-alpha-reductase, the enzyme that turns testosterone into DHT: the hormone that shrinks follicles in female pattern hair loss." },
        { "type": "text", "id": "icon_fallback", "label": "Fallback icon URL", "info": "Used only until an icon is uploaded." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Backed by science", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] }
  ]
}
{% endschema %}
