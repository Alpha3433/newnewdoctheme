<div class="page-width page-width--narrow">
  <h1 class="page-title">{{ 'cart.general.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <table class="cart-table">
        <thead>
          <tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            {%- liquid
              comment
                Only show a variant title the shopper could have chosen. A variant that carries a
                subscription plan and prices the same as its siblings is a delivery cadence the buy
                box pinned (Monthly / Quarterly / Biannual), not a choice - printed here it reads as
                a delivery promise under a one-time purchase. The plan name below says what the
                shopper actually committed to. Mirrors the cart drawer.
              endcomment
              assign show_variant_title = false
              if item.product.has_only_default_variant == false and item.variant.title != 'Default Title'
                assign show_variant_title = true
                if item.variant.selling_plan_allocations.size > 0 and item.product.price_min == item.product.price_max
                  assign show_variant_title = false
                endif
              endif
            -%}
            <tr>
              <td>
                <div class="cart-table__item">
                  {%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy' }}{%- endif -%}
                  <div>
                    <a class="product-card__title" href="{{ routes.root_url }}#shop" data-scroll-to="shop">{{ item.product.title }}</a>
                    {%- if show_variant_title -%}<div class="cart-footer__note">{{ item.variant.title }}</div>{%- endif -%}
                    <a class="cart-footer__note link-underline" href="{{ item.url_to_remove }}">{{ 'cart.general.remove' | t }}</a>
                  </div>
                </div>
              </td>
              <td><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'customer.order.quantity' | t }}"></td>
              <td>{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      <div class="cart-footer">
        <div class="cart-footer__subtotal">{{ 'cart.general.subtotal' | t }}: {{ cart.total_price | money }}</div>
        <div class="cart-footer__note">{{ 'cart.general.taxes_and_shipping' | t }}</div>
        <div style="display: flex; gap: 10px;">
          <button type="submit" name="update" class="custom-button" style="background: #fff; color: var(--brand-ink); border: 1.5px solid var(--brand-ink);">{{ 'cart.general.update' | t }}</button>
          <button type="submit" name="checkout" class="custom-button">{{ 'cart.general.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {%- else -%}
    <p>{{ 'cart.general.empty' | t }}</p>
    <p style="margin-top: 16px;"><a class="custom-button" href="{% render 'continue-shopping-url' %}">{{ 'cart.general.continue_shopping' | t }}</a></p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
