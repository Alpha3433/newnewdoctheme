<div class="page-width">
  <h1 class="page-title">{%- if search.performed -%}{{ 'general.search.results_for' | t: terms: search.terms }}{%- else -%}{{ 'general.search.search' | t }}{%- endif -%}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
    <button type="submit" class="custom-button">{{ 'general.search.search' | t }}</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count > 0 -%}
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <div class="product-card"><a class="product-card__title" href="{{ item.url }}">{{ item.title }}</a></div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
