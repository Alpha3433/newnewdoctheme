{% comment %}
  Newsletter sign-up – posts to Shopify's customer form so subscribers land in Customers with the "newsletter" tag.
  The wrapper id is kept so the verbatim CSS in assets/sections-inline.css still applies.
{% endcomment %}
{%- liquid
  assign sid = 'template--26717513089391__custom_newsletter_d3YipT'
  assign form_id = 'newsletter-' | append: sid
-%}
<section class="shopify-section section" id="shopify-section-{{ sid }}"><section class="s-newsletter custom-section" id="shopify-section-{{ sid }}-inner">
    <div class="s-newsletter__container">
        <h2 class="s-newsletter__title section-title"><p>{{ section.settings.title }}</p></h2>
        {%- if section.settings.text != blank -%}<p class="s-newsletter__content">{{ section.settings.text }}</p>{%- endif -%}
      {%- form 'customer', class: 's-newsletter__form', id: form_id -%}
        <input name="contact[tags]" type="hidden" value="newsletter">
        <input name="contact[context]" type="hidden" value="{{ form_id }}">
        {%- if form.posted_successfully? -%}
          <p class="s-newsletter__content" role="status">{{ section.settings.success_text }}</p>
        {%- else -%}
        {%- if form.errors -%}
          <p class="s-newsletter__content" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <div class="s-newsletter__input-row">
          <div class="s-newsletter__input">
            <input aria-label="{{ section.settings.placeholder | escape }}" class="s-newsletter__input-field" id="{{ form_id }}-email" name="contact[email]" placeholder="{{ section.settings.placeholder | escape }}" required type="email" value="{{ form.email }}">
            <label class="s-newsletter__input-label" for="{{ form_id }}-email">Your e-mail</label>
          </div>

          <div class="s-newsletter__input">
            <button aria-label="{{ section.settings.button_label | escape }}" class="s-newsletter__button s-newsletter__button--primary custom-button" is="loader-button" type="submit">
<span class="loader-button__text">{{ section.settings.button_label }}</span>
<span class="loader-button__loader" hidden>
  <div class="spinner">
    <svg class="icon icon--spinner" focusable="false" height="24" viewBox="25 25 50 50" width="24">
      <circle cx="50" cy="50" fill="none" r="20" stroke="currentColor" stroke-width="5"></circle>
    </svg>
  </div>
</span>
</button>
          </div>
        </div>
        {%- endif -%}
      {%- endform -%}
    </div>
</section>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Regrowth tips & exclusive offers" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Honest regrowth timelines, scalp-care tips for every texture, and first access to our best offers. No spam, just the good stuff." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email here" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks for subscribing. Your first regrowth tips are on their way." }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
