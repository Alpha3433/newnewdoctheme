{% comment %}
  Money-back guarantee panel – badge, heading, text, links and the optional tinted background are editable.
  Used twice on the landing page (with and without the background).
  On a product page it only shows on the serum's page (the Bundled product, templates/product.json).
  The badge is drawn here (SVG): the centre text with the ring text along the top, on the soft offer
  gradient from Theme settings → Offer colours. An uploaded Badge image replaces it.
{% endcomment %}
{%- unless template.name == 'product' and product.id != settings.bundle_product.id -%}
<section class="shopify-section section"{% if section.settings.anchor %} data-anchor="guarantee"{% endif %} id="shopify-section-{{ section.id }}-guarantee"><section class="s-guarantee">
<div class="s-guarantee__top{% if section.settings.background %} s-guarantee__top--background{% endif %}">
    <div class="s-guarantee__top s-guarantee__container"><div class="s-guarantee__image">
      {%- if section.settings.image != blank -%}
      <picture>
        {%- render 'froya-image', image: section.settings.image, alt: section.settings.title, width: 247, height: 267 -%}
      </picture>
      {%- else -%}
      {%- liquid
        assign badge_id = 'guarantee-badge-' | append: section.id
        assign badge_label = section.settings.badge_center | append: ' ' | append: section.settings.badge_ring | strip | downcase | capitalize
        assign offer_soft = settings.offer_soft_strength | default: 45 | divided_by: 100.0
      -%}
      <svg class="s-guarantee__badge" viewBox="0 0 200 200" role="img" aria-label="{{ badge_label | escape }}" focusable="false" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="{{ badge_id }}-fill" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0.1" stop-color="{{ settings.offer_color_1 | default: '#dfb142' }}" stop-opacity="{{ offer_soft }}"/>
            <stop offset="0.5" stop-color="{{ settings.offer_color_2 | default: '#e98044' }}" stop-opacity="{{ offer_soft }}"/>
            <stop offset="1" stop-color="{{ settings.offer_color_3 | default: '#af8998' }}" stop-opacity="{{ offer_soft }}"/>
          </linearGradient>
          <path id="{{ badge_id }}-arc" d="M 35.91,137 A 74,74 0 1,1 164.09,137"/>
          <path id="{{ badge_id }}-star" d="M0,-5 L1.2,-1.2 L5,0 L1.2,1.2 L0,5 L-1.2,1.2 L-5,0 L-1.2,-1.2 Z"/>
        </defs>
        <circle cx="100" cy="100" r="98" fill="#fff"/>
        <circle cx="100" cy="100" r="98" fill="url(#{{ badge_id }}-fill)"/>
        <circle cx="100" cy="100" r="93" fill="none" stroke="currentColor" stroke-opacity=".28"/>
        <circle cx="100" cy="100" r="57" fill="none" stroke="currentColor" stroke-opacity=".45" stroke-width="1.25"/>
        {%- if section.settings.badge_ring != blank -%}
        <text class="s-guarantee__badge-ring"><textPath href="#{{ badge_id }}-arc" startOffset="50%" text-anchor="middle">{{ section.settings.badge_ring | escape }}</textPath></text>
        {%- endif -%}
        {%- if section.settings.badge_center != blank -%}
        <text class="s-guarantee__badge-centre" x="100" y="109.5" text-anchor="middle">{{ section.settings.badge_center | escape }}</text>
        {%- endif -%}
        <use href="#{{ badge_id }}-star" x="86" y="168"/><use href="#{{ badge_id }}-star" x="100" y="168"/><use href="#{{ badge_id }}-star" x="114" y="168"/>
      </svg>
      {%- endif -%}
      </div><div class="s-guarantee__content"><div class="s-guarantee__title">
              <p>{{ section.settings.title }}</p>
            </div><div class="s-guarantee__text">{{ section.settings.text }}</div>
            {%- if section.settings.link_label != blank -%}
            {%- assign guarantee_link = section.settings.link_url | default: '/policies/refund-policy' -%}
            <a class="s-guarantee__link" href="{{ guarantee_link }}"{% if guarantee_link contains '#' %} data-scroll-to="{{ guarantee_link | split: '#' | last }}"{% endif %}>
              {{ section.settings.link_label }}
            </a>
            {%- endif -%}
          </div>
    </div>
  </div>

  {%- if section.settings.button_label != blank -%}
  {%- assign guarantee_button = section.settings.button_url | default: '#shop' -%}
  <div class="s-guarantee__container"><a class="s-guarantee__button custom-button" href="{{ guarantee_button }}"{% if guarantee_button contains '#' %} data-scroll-to="{{ guarantee_button | split: '#' | last }}"{% endif %}>
      {{ section.settings.button_label }}
    </a></div>
  {%- endif -%}
</section>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "Guarantee",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "background", "label": "Show tinted background", "default": true },
    { "type": "checkbox", "id": "anchor", "label": "Menu \"Guarantee\" links scroll here", "info": "Tick on one guarantee section only.", "default": false },
    { "type": "image_picker", "id": "image", "label": "Badge image", "info": "About 250 × 270 px. Leave empty for the drawn badge: the two texts below on the offer gradient (Theme settings → Offer colours)." },
    { "type": "text", "id": "badge_center", "label": "Badge centre text", "default": "30-DAY" },
    { "type": "text", "id": "badge_ring", "label": "Badge ring text", "default": "MONEY-BACK GUARANTEE" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Fuller hair in 30 days or your money back" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hair grows in cycles, so we ask for a little patience: use Elaren every night for 30 days. Still shedding, still no baby hairs along your part or hairline?<br>Tell us and we’ll refund every cent. No photos required, no awkward questions. Hair loss is personal, and so is our promise.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn More" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Use /#faq to scroll to the FAQ." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "TRY IT RISK-FREE" },
    { "type": "url", "id": "button_url", "label": "Button link", "info": "Leave empty to scroll to the buy box." }
  ],
  "presets": [ { "name": "Guarantee" } ]
}
{% endschema %}
