<div class="page-width">
  <h1 class="page-title">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="blog-grid">
      {%- for article in blog.articles -%}
        <a class="blog-card" href="{{ article.url }}">
          {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy' }}{%- endif -%}
          <span class="blog-card__title">{{ article.title }}</span>
          <span class="blog-card__meta">{{ article.published_at | date: '%B %d, %Y' }}</span>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
