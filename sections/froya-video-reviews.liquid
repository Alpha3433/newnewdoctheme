{% comment %}
  Video review slider – each block is a customer video (uploaded video or mp4 URL + poster) with a product card.
  The wrapper id is kept so the verbatim CSS in assets/sections-inline.css still applies.
{% endcomment %}
<div class="shopify-section" id="shopify-section-template--26717513089391__videos_slider_r6HaLL">
<s-videos-slider class="s-videos-slider custom-section">
  <div class="s-videos-slider__container" style="--slides-to-show: 5.5; --slide-gap: 20px;">
    <h2 class="s-videos-slider__title s-videos-slider__title--desktop section-title"><p>{{ section.settings.title }}</p></h2>
    <h2 class="s-videos-slider__title s-videos-slider__title--mobile section-title"><p>{{ section.settings.title }}</p></h2>
    <div class="blaze-slider s-videos-slider__slider" id="videos-slider">
      <div class="blaze-container">
        <div class="blaze-track-container">
          <div class="blaze-track">
            {%- for block in section.blocks -%}
              {%- assign product = block.settings.product -%}
              <div class="s-videos-slider__slide" {{ block.shopify_attributes }}>
                <div class="s-videos-slider__video">
                  <div class="s-videos-slider__video-item">
                    <div class="s-videos-slider__video-item--preview">
                      <picture>{%- render 'froya-image', image: block.settings.poster, fallback: block.settings.poster_fallback, alt: '', width: 200, height: 356 -%}</picture>
                    </div>
                    <span class="s-videos-slider__video-item--play-video" data-play-button>
                      <svg fill="none" height="45" viewBox="0 0 249 249" width="45" xmlns="http://www.w3.org/2000/svg"><circle cx="124.5" cy="124.5" fill="#D9D9D9" fill-opacity="0.5" r="124.5"></circle><path d="M188 124L93.5 178.56L93.5 69.4404L188 124Z" fill="white"></path></svg>
                    </span>
                    {%- if block.settings.video != blank -%}
                      {{ block.settings.video | video_tag: controls: true, preload: 'none' }}
                    {%- else -%}
                      <video aria-label="Customer testimonial video" controls data-sources="{{ block.settings.video_url }}" data-types="video/mp4" loading="lazy" preload="none">Your browser does not support the video tag.</video>
                    {%- endif -%}
                  </div>
                  <div class="s-videos-slider__video-content">
                    <div class="s-videos-slider__video-top">
                      <div class="s-videos-slider__video-top-left">
                        <span class="s-videos-slider__name">{{ block.settings.name }}</span>
                        {%- if block.settings.date != blank -%}<span class="s-videos-slider__date">{{ block.settings.date }}</span>{%- endif -%}
                      </div>
                      <div class="s-videos-slider__stars">
                        <picture>{%- render 'froya-image', image: section.settings.stars_image, fallback: 'https://froyaorganics.com/cdn/shop/files/stars.svg', alt: '5 stars', width: 71, height: 16 -%}</picture>
                      </div>
                    </div>
                    {%- if product != blank -%}
                    <div class="s-videos-slider__product-wrapper">
                      <a class="s-videos-slider__product-image" href="{{ product.url }}">
                        <picture>{%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 240, height: 240, crop: 'center' | image_tag: alt: product.title, loading: 'lazy' }}{%- endif -%}</picture>
                      </a>
                      <div class="s-videos-slider__product-info">
                        <div class="s-videos-slider__product-title">{{ block.settings.product_title | default: product.title }}</div>
                        <div class="s-videos-slider__product-price"><span>{{ section.settings.from_label }} <span class="product_price">{{ product.price_min | money }}</span></span></div>
                        <a class="s-videos-slider__product-button custom-button" href="{{ product.url }}">{{ section.settings.shop_label }}</a>
                      </div>
                    </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
        <div class="blaze-pagination"></div>
      </div>
    </div>
  </div>
</s-videos-slider>
</div>

{% schema %}
{
  "name": "Video reviews",
  "tag": "section",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Regrowth Stories From Women Like You" },
    { "type": "image_picker", "id": "stars_image", "label": "Star rating image", "info": "About 71 × 16 px; shown on every card." },
    { "type": "text", "id": "from_label", "label": "Price prefix", "default": "From" },
    { "type": "text", "id": "shop_label", "label": "Product button label", "default": "Shop now" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video review",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Upload a portrait video. If empty, the video URL below is used." },
        { "type": "text", "id": "video_url", "label": "Video URL (mp4)" },
        { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "About 200 × 356 px." },
        { "type": "text", "id": "name", "label": "Name", "default": "Verified Elaren customer" },
        { "type": "text", "id": "date", "label": "Date / source", "default": "Video review" },
        { "type": "product", "id": "product", "label": "Product shown under the video" },
        { "type": "text", "id": "product_title", "label": "Product name override" },
        { "type": "text", "id": "poster_fallback", "label": "Fallback poster URL", "info": "Used only until a poster is uploaded." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [ { "name": "Video reviews", "blocks": [ { "type": "video" }, { "type": "video" }, { "type": "video" } ] } ]
}
{% endschema %}
