{% comment %}
  Logo + quote slider – heading and every slide (logo image + quote) editable in the theme editor.
  The wrapper ids are kept so the verbatim CSS in assets/sections-inline.css still applies.
{% endcomment %}
<section class="shopify-section section" id="shopify-section-template--26717513089391__icons_slider_Nt3UqE"><s-icons-slider class="s-icons-slider custom-section" data-section-id="template--26717513089391__icons_slider_Nt3UqE" data-section-type="icons-slider">
  {%- if section.settings.title != blank -%}<h2 class="s-icons-slider__title" id="slider-title-template--26717513089391__icons_slider_Nt3UqE">{{ section.settings.title }}</h2>{%- endif -%}
  <div class="s-icons-slider__container">
    <div class="blaze-slider s-icons-slider__slider" id="icons-slider" style="--slides-to-show: 6.1; --slide-gap: 20px;">
      <div class="blaze-container">
        <div class="blaze-track-container">
          <div class="blaze-track">
            {%- for block in section.blocks -%}
              <div class="s-icons-slider__slide" {{ block.shopify_attributes }}>
                <div class="s-icons-slider__slide-content">
                  <div class="s-icons-slider__slide-icon">
                    {%- if block.settings.logo != blank or block.settings.logo_fallback != blank -%}
                      {%- render 'froya-image', image: block.settings.logo, fallback: block.settings.logo_fallback, alt: block.settings.logo_alt, width: 200, height: 70, loading: 'eager', sizes: '(min-width: 768px) 200px, 100px' -%}
                    {%- endif -%}
                  </div>
                  {%- if block.settings.quote != blank -%}
                    <div class="s-icons-slider__slide-text s-icons-slider__slide-text--desktop"><p>{{ block.settings.quote }}</p></div>
                    <div class="s-icons-slider__slide-text s-icons-slider__slide-text--mobile"><p>{{ block.settings.quote }}</p></div>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
        <div class="blaze-pagination"></div>
      </div>
    </div>
  </div>
</s-icons-slider>
</section>

{% schema %}
{
  "name": "Logo & quote slider",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "\"Finally, a regrowth oil formulated for women’s hair loss, not adapted from men’s\"" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Press or badge logo, about 200 × 70 px. Leave empty for a text-only slide." },
        { "type": "text", "id": "logo_alt", "label": "Logo alt text" },
        { "type": "text", "id": "quote", "label": "Quote", "default": "\"Pumpkin seed oil naturally blocks DHT, the hormone behind female pattern thinning.\"" },
        { "type": "text", "id": "logo_fallback", "label": "Fallback logo URL", "info": "Used only until a logo is uploaded." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Logo & quote slider",
      "blocks": [
        { "type": "slide" }, { "type": "slide" }, { "type": "slide" }, { "type": "slide" }, { "type": "slide" }, { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
