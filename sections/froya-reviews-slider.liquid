{% comment %}
  Review slider – each card is a block: photo review (image, name, tags, quote, full review) or video
  review (video + poster). The product card under each review comes from a product picker.
  The wrapper ids are kept so the verbatim CSS in assets/sections-inline.css still applies.
{% endcomment %}
{%- liquid
  assign sid = 'template--26717513089391__reviews_slider_hyUAzq'
-%}
<section class="shopify-section section-reviews-slider" id="shopify-section-{{ sid }}">
<s-reviews-slider class="s-reviews-slider custom-section">
  <div class="s-reviews-slider__container"><h2 class="s-reviews-slider__title section-title">
        <p>{{ section.settings.title }}</p>
      </h2><div class="blaze-slider s-reviews-slider__slider" id="reviews-slider-{{ sid }}" style="--slides-to-show: 5.5; --slide-gap: 20px;">
      <div class="blaze-container">
        <div class="blaze-track-container">
          <div class="blaze-track">
            {%- for block in section.blocks -%}
              {%- liquid
                assign product = block.settings.product
                assign is_video = false
                if block.type == 'video'
                  assign is_video = true
                endif
              -%}
              <div class="s-reviews-slider__slide" {{ block.shopify_attributes }}>
<c-review-card class="c-review-card" data-media-type="{% if is_video %}video{% else %}image{% endif %}">
  <div class="c-review-card__review">
    {%- if is_video -%}
      <div class="c-review-card__video-wrapper" style="--review-video-aspect-ratio: 0.75;">
        <div class="c-review-card__preview js-review-card__preview">
          <picture>{%- render 'froya-image', image: block.settings.poster, fallback: block.settings.poster_fallback, alt: '', width: 380, height: 380 -%}</picture>
          <span class="c-review-card__play">
            <svg fill="none" height="45" viewBox="0 0 249 249" width="45" xmlns="http://www.w3.org/2000/svg"><circle cx="124.5" cy="124.5" fill="#D9D9D9" fill-opacity="0.5" r="124.5"></circle><path d="M188 124L93.5 178.56L93.5 69.4404L188 124Z" fill="white"></path></svg>
          </span>
        </div>
        {%- if block.settings.video != blank -%}
          {{ block.settings.video | video_tag: controls: true, preload: 'none', class: 'c-review-card__video js-review-card__video' }}
        {%- else -%}
          <video aria-label="Customer review video" class="c-review-card__video js-review-card__video" controls data-sources="{{ block.settings.video_url }}" data-types="video/mp4" preload="none">Your browser does not support the video tag.</video>
        {%- endif -%}
      </div>
    {%- elsif block.settings.image != blank or block.settings.image_fallback != blank -%}
      <div class="c-review-card__review-image">
        <picture>{%- render 'froya-image', image: block.settings.image, fallback: block.settings.image_fallback, alt: block.settings.image_alt, width: 380, height: 225, sizes: '380px' -%}</picture>
      </div>
    {%- endif -%}
    <div class="c-review-card__review-content">
      <div class="c-review-card__review-top">
        <div class="c-review-card__name-wrapper">
          <span class="c-review-card__name">{{ block.settings.name }}</span>
          {%- if is_video and block.settings.date != blank -%}<span class="c-review-card__date">{{ block.settings.date }}</span>{%- endif -%}
        </div>
        <div class="c-review-card__stars">
          <picture>{%- render 'froya-image', image: section.settings.stars_image, fallback: 'https://froyaorganics.com/cdn/shop/files/stars.svg', alt: '5 stars', width: 71, height: 16 -%}</picture>
        </div>
      </div>
      {%- unless is_video -%}
        {%- if block.settings.tag_1 != blank or block.settings.tag_2 != blank -%}
        <div class="c-review-card__top-icons">
          {%- if block.settings.tag_1 != blank -%}<div><div class="c-review-card__icon"><picture>{%- render 'froya-image', image: block.settings.tag_1_icon, fallback: 'https://froyaorganics.com/cdn/shop/files/tag_icon_1.svg', alt: '', width: 26, height: 16 -%}</picture></div><span class="c-review-card__icon-text">{{ block.settings.tag_1 }}</span></div>{%- endif -%}
          {%- if block.settings.tag_2 != blank -%}<div><div class="c-review-card__icon"><picture>{%- render 'froya-image', image: block.settings.tag_2_icon, fallback: 'https://froyaorganics.com/cdn/shop/files/tag_icon_6.svg', alt: '', width: 26, height: 24 -%}</picture></div><span class="c-review-card__icon-text">{{ block.settings.tag_2 }}</span></div>{%- endif -%}
        </div>
        {%- endif -%}
        <div class="c-review-card__text-wrapper"><h3 class="c-review-card__block-title">{{ block.settings.quote }}</h3>
          {%- if block.settings.text != blank -%}
            <div class="c-review-card__text js-review-card__text">
              <div data-text="truncated">{{ block.settings.text | strip_html | truncate: 120 }} <span class="c-review-card__read-more-btn js-review-card__read-more">{{ section.settings.read_more }}</span></div>
              <div class="is-hidden" data-text="full">{{ block.settings.text }} <span class="c-review-card__read-more-btn js-review-card__read-less">{{ section.settings.read_less }}</span></div>
            </div>
          {%- endif -%}
        </div>
        <div class="c-review-card__line"></div>
      {%- endunless -%}
      {%- if product != blank -%}
      <div class="c-review-card__product-wrapper">
        <a class="c-review-card__product-image" href="{{ product.url }}">
          <picture>{%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 240, height: 240, crop: 'center' | image_tag: alt: product.title, loading: 'lazy' }}{%- endif -%}</picture>
        </a>
        <div class="c-review-card__product-info">
          <div class="c-review-card__product-title">{{ block.settings.product_title | default: product.title }}</div>
          <div class="c-review-card__product-price"><span>{{ section.settings.from_label }} <span class="product_price">{{ product.price_min | money }}</span></span></div>
          <a class="c-review-card__product-button custom-button" href="{{ product.url }}">{{ section.settings.shop_label }}</a>
        </div>
      </div>
      {%- endif -%}
    </div>
  </div>
</c-review-card>
              </div>
            {%- endfor -%}
          </div>
        </div>
        <div class="blaze-pagination"></div>
      </div>
    </div>
  </div>
</s-reviews-slider>
</section>

{% schema %}
{
  "name": "Review slider",
  "tag": "section",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Verified Reviews From Real Elaren Customers" },
    { "type": "image_picker", "id": "stars_image", "label": "Star rating image", "info": "About 71 × 16 px; shown on every card." },
    { "type": "text", "id": "from_label", "label": "Price prefix", "default": "From" },
    { "type": "text", "id": "shop_label", "label": "Product button label", "default": "Shop now" },
    { "type": "text", "id": "read_more", "label": "Read more label", "default": "Read more" },
    { "type": "text", "id": "read_less", "label": "Read less label", "default": "Read less" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Photo review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Before/after or customer photo, about 380 × 225 px." },
        { "type": "text", "id": "image_alt", "label": "Photo alt text" },
        { "type": "text", "id": "name", "label": "Name", "default": "Verified buyer" },
        { "type": "text", "id": "tag_1", "label": "Tag 1", "default": "less shedding" },
        { "type": "image_picker", "id": "tag_1_icon", "label": "Tag 1 icon" },
        { "type": "text", "id": "tag_2", "label": "Tag 2", "default": "non-greasy" },
        { "type": "image_picker", "id": "tag_2_icon", "label": "Tag 2 icon" },
        { "type": "text", "id": "quote", "label": "Headline quote", "default": "\"It really does what it says.\"" },
        { "type": "richtext", "id": "text", "label": "Full review (optional)" },
        { "type": "product", "id": "product", "label": "Product shown under the review" },
        { "type": "text", "id": "product_title", "label": "Product name override" },
        { "type": "text", "id": "image_fallback", "label": "Fallback photo URL", "info": "Used only until a photo is uploaded." }
      ]
    },
    {
      "type": "video",
      "name": "Video review",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Upload a portrait video (3:4). If empty, the video URL below is used." },
        { "type": "text", "id": "video_url", "label": "Video URL (mp4)" },
        { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Shown before playback, about 380 × 500 px." },
        { "type": "text", "id": "name", "label": "Name", "default": "Verified Elaren customer" },
        { "type": "text", "id": "date", "label": "Date / source", "default": "Video review" },
        { "type": "product", "id": "product", "label": "Product shown under the review" },
        { "type": "text", "id": "product_title", "label": "Product name override" },
        { "type": "text", "id": "poster_fallback", "label": "Fallback poster URL", "info": "Used only until a poster is uploaded." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [ { "name": "Review slider", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
