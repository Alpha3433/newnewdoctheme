        { "type": "color", "id": "color", "label": "Dot colour", "default": "#4A90E2" },
        { "type": "text", "id": "label", "label": "Label", "default": "CAFFEINE COMPLEX" }
      ]
    },
    {
      "type": "active",
      "name": "Key active (modal)",
      "settings": [
        { "type": "color", "id": "color", "label": "Dot colour", "default": "#5A9512" },
        { "type": "text", "id": "label", "label": "Label", "default": "COLD-PRESSED CUCURBITA PEPO (PUMPKIN) SEED OIL" }
      ]
    },
    {
      "type": "tag",
      "name": "Benefit tag",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "About 24 × 24 px." },
        { "type": "text", "id": "text", "label": "Text", "default": "reduce shedding" },
        { "type": "text", "id": "icon_fallback", "label": "Fallback icon URL", "info": "Used only until an icon is uploaded." }
      ]
    },
    {
      "type": "usp",
      "name": "USP under the button",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "About 32 × 28 px." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>fuller hair in 90 days or your money back</p>" },
        { "type": "text", "id": "icon_fallback", "label": "Fallback icon URL", "info": "Used only until an icon is uploaded." }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    { "name": "Featured product", "blocks": [ { "type": "tag" }, { "type": "tag" }, { "type": "tag" }, { "type": "usp" }, { "type": "usp" }, { "type": "usp" } ] }
  ]
}
{% endschema %}
