{% comment %}
  Featured product / buy box. Pick the product in the theme editor: the gallery, prices, subscription
  plan (subscribe & save), variant and add-to-cart form all come from that product. Every piece of copy
  around it is an editable setting or block. Adding to cart is done in-page and opens the cart drawer.
  The wrapper id is kept so the verbatim CSS in assets/sections-inline.css still applies.
{% endcomment %}
{%- liquid
  assign product = section.settings.product
  assign ingredients = section.blocks | where: 'type', 'ingredient'
  assign legend = section.blocks | where: 'type', 'legend'
  assign actives = section.blocks | where: 'type', 'active'
  assign tags = section.blocks | where: 'type', 'tag'
  assign usps = section.blocks | where: 'type', 'usp'
  assign bundles = section.blocks | where: 'type', 'bundle'
  assign percent_placeholder = '{percent}'
  assign count_placeholder = '{count}'
  assign amount_placeholder = '{amount}'
  assign total_placeholder = '{total}'

  assign fallback_images = 'IMG_1_8c681b46-2a29-4394-8f0b-a4d7759e9a48.jpg,IMG_2.png,nikki-reed-desktop_2x_2970174c-c49b-4943-8807-ab853fe8e55c.png,IMG_3.png,IMG_4_51e90354-5a8f-4469-9287-d1746d6736e0.png,IMG_5.png,IMG_6_corrected.png,IMG_7.png,IMG_8.png,IMG_9.png,IMG_10.png' | split: ','
  assign fallback_alts = 'Elaren Pumpkin Seed Regrowth Oil with Caffeine Complex bottle|Woman applying Elaren Pumpkin Seed Regrowth Oil to her scalp along her part|Pumpkin Seed Regrowth Oil|Elaren Pumpkin Seed Regrowth Oil held in hand with key benefit callouts|Grid of customer before and after photos showing fuller parts, crowns and edges|Star rating and two verified customer reviews|Published research results for pumpkin seed oil and caffeine|Cold-pressed pumpkin seed oil and Caffeine Complex ingredients|Regrowth timeline at 2 weeks, 30 days and 30 days|Nightly two-minute scalp routine guide|Woman holding Elaren Pumpkin Seed Regrowth Oil with the 30-day money-back promise' | split: '|'

  if product != blank
    assign variant = product.selected_or_first_available_variant
    assign product_title = section.settings.product_title | default: product.title
    assign otp_price = variant.price
    assign otp_compare = variant.compare_at_price
    assign plan = blank
    assign plan_group = product.selling_plan_groups | first
    if product.selling_plan_groups.size > 0
      assign plan = plan_group.selling_plans | first
    endif
    assign sub_price = otp_price
    assign sub_percent = 0
    if plan != blank
      for allocation in variant.selling_plan_allocations
        if allocation.selling_plan.id == plan.id
          assign sub_price = allocation.price
          break
        endif
      endfor
      assign adjustment = plan.price_adjustments | first
      if adjustment.value_type == 'percentage'
        assign sub_percent = adjustment.value
      elsif otp_price > 0
        assign sub_percent = otp_price | minus: sub_price | times: 100 | divided_by: otp_price
      endif
    endif
    assign saving = otp_price | minus: sub_price
    assign media_count = product.media.size

    comment
      Bundle tiers (quantity breaks, mirroring the Kaching Bundles set-up). Every tier is priced off the
      product's own price: the tier discount comes off the unit price, so the per-bottle price falls as the
      bundle grows. The quantity is what gets added to cart - the Kaching Bundles discount applies the
      matching quantity break at checkout.
    endcomment
    assign base_compare = otp_price
    if otp_compare > otp_price
      assign base_compare = otp_compare
    endif
    assign default_bundle = blank
    assign default_qty = 1
    assign display_unit_sub = sub_price
    assign display_unit_otp = otp_price
    assign display_total_sub = sub_price
    assign display_total_otp = otp_price
    assign display_compare_unit = base_compare
    assign display_compare_total = base_compare
    assign display_save = saving
    if bundles.size > 0
      assign default_bundle = bundles.first
      for tier in bundles
        if tier.settings.selected
          assign default_bundle = tier
          break
        endif
      endfor
      assign default_qty = default_bundle.settings.quantity | at_least: 1
      assign default_keep = 100 | minus: default_bundle.settings.discount
      assign display_unit_sub = sub_price | times: default_keep | divided_by: 100
      assign display_unit_otp = otp_price | times: default_keep | divided_by: 100
      assign display_total_sub = display_unit_sub | times: default_qty
      assign display_total_otp = display_unit_otp | times: default_qty
      assign display_compare_total = base_compare | times: default_qty
      assign display_save = display_compare_total | minus: display_total_sub
      if plan == blank
        assign display_save = display_compare_total | minus: display_total_otp
      endif
    endif

    assign show_button_compare = false
    if plan != blank
      if display_compare_total > display_total_sub
        assign show_button_compare = true
      endif
    elsif display_compare_total > display_total_otp
      assign show_button_compare = true
    endif
    if bundles.size > 0
      assign show_button_compare = true
    endif

    assign show_congrats = false
    if section.settings.congrats_text != blank
      if saving > 0 or bundles.size > 0
        assign show_congrats = true
      endif
    endif
  endif
-%}
<div class="shopify-section" id="shopify-section-template--26717513089391__custom_featured_product_m69X4b">
{%- if product == blank -%}
  {%- if request.design_mode -%}
    <div style="max-width:720px;margin:48px auto;padding:24px;border:1px dashed #af8998;text-align:center;font-family:sans-serif;">
      <strong>Featured product:</strong> select a product in the section settings to render the buy box.
    </div>
  {%- endif -%}
{%- else -%}
<s-featured-product class="s-featured-product custom-section s-featured-product--badge-title s-featured-product--mobile-head" data-section-id="{{ section.id }}">
  <div class="s-featured-product__container" id="product-section" style="scroll-margin-top: calc(var(--header-height, 0px) * var(--enable-sticky-header) + var(--announcement-bar-height, 0px) * var(--enable-sticky-announcement-bar) + 10px)">
    {%- if section.settings.badge_text != blank -%}
    <h2 class="s-featured-product__title s-featured-product__title--badge section-title" style="--badge-bg: {{ section.settings.badge_bg }}; --badge-text-color: {{ section.settings.badge_color }};">
      <p class="s-featured-product__badge-text"><span aria-hidden="true">✨ </span>{{ section.settings.badge_text }}{% if section.settings.badge_underline != blank %} <span class="s-featured-product__badge-underline">{{ section.settings.badge_underline }}</span>{% endif %}</p>
    </h2>
    {%- endif -%}

    {%- capture product_head -%}
      <div class="s-featured-product__product-info-labels">
        {%- if section.settings.label_1 != blank -%}<span>{{ section.settings.label_1 }}</span>{%- endif -%}
        {%- if section.settings.label_1 != blank and section.settings.label_2 != blank -%}<span>·</span>{%- endif -%}
        {%- if section.settings.label_2 != blank -%}<span>{{ section.settings.label_2 }}</span>{%- endif -%}
      </div>
      <h3 class="s-featured-product__product-name">{{ product_title }}</h3>
      {%- if section.settings.reviews_count > 0 -%}
      <div class="custom_loox_star_rating">
        <a data-scroll-to="reviews-section" href="#reviews-section">
          <div aria-label="{{ section.settings.reviews_count }} reviews" class="loox-rating" data-raters="{{ section.settings.reviews_count }}" data-rating="{{ section.settings.rating }}" role="figure" title="{{ section.settings.reviews_count }} reviews"><div class="loox-rating-content">
            {%- for i in (1..5) -%}<svg aria-hidden="true" class="loox-icon" data-lx-fill="full" viewBox="0 0 24 24"><use href="#looxicons-rating-icon"></use></svg>{%- endfor -%}
            <span aria-hidden="true" class="loox-rating-label">&nbsp;({{ section.settings.reviews_count }})</span>
          </div></div>
          {%- if section.settings.rating_text != blank -%}<div class="loox-rating__text">{{ section.settings.rating_text }}</div>{%- endif -%}
        </a>
      </div>
      {%- endif -%}
    {%- endcapture -%}

    <div class="s-featured-product__content"><div class="s-featured-product__mobile-head">{{ product_head }}</div><div class="s-featured-product__gallery-wrapper">
        <div class="s-featured-product__gallery js-featured-product__gallery s-featured-product__gallery--stage s-featured-product__gallery--video-crop-up">
          <div class="s-featured-product__gallery-arrow s-featured-product__gallery-arrow--prev js-arrow-prev">
            <svg aria-hidden="true" fill="none" height="21" viewBox="0 0 17 21" width="17" xmlns="http://www.w3.org/2000/svg"><path d="M12.6 0.23a.77.77 0 0 1 1.12 0l.03.03a.8.8 0 0 1 0 1.1L4.9 10.17l8.85 8.84a.8.8 0 0 1 0 1.11.77.77 0 0 1-1.12 0L3.2 10.72a.8.8 0 0 1 0-1.1L12.6.23z" fill="currentColor"/></svg>
          </div>
          <div class="s-featured-product__gallery-tags">
            {%- if section.settings.save_tag != blank -%}<span class="s-featured-product__gallery-tag s-featured-product__gallery-tag--type-3 js-gallery-save-tag">{{ section.settings.save_tag | replace: percent_placeholder, sub_percent }}</span>{%- endif -%}
          </div>
          {%- if media_count > 0 -%}
            {%- for media in product.media -%}
              <div class="s-featured-product__slide{% if forloop.first %} is-active{% endif %}" data-media-type="{{ media.media_type }}">
                {%- case media.media_type -%}
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, preload: 'none', loop: false, muted: false, class: 's-featured-product__video' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag: class: 's-featured-product__video' }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag }}
                  {%- else -%}
                    {%- if forloop.first -%}
                      <picture>{{ media | image_url: width: 1200 | image_tag: alt: media.alt, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200' }}</picture>
                    {%- else -%}
                      <picture>{{ media | image_url: width: 1200 | image_tag: alt: media.alt, loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200' }}</picture>
                    {%- endif -%}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for src in fallback_images -%}
              <div class="s-featured-product__slide{% if forloop.first %} is-active{% endif %}">
                <picture><img alt="{{ fallback_alts[forloop.index0] | escape }}" decoding="async" height="600" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" src="https://froyaorganics.com/cdn/shop/files/{{ src }}" width="600"></picture>
              </div>
            {%- endfor -%}
          {%- endif -%}
          <div class="s-featured-product__gallery-arrow s-featured-product__gallery-arrow--next js-arrow-next">
            <svg aria-hidden="true" fill="none" height="21" viewBox="0 0 17 21" width="17" xmlns="http://www.w3.org/2000/svg"><path d="M4.4.23a.77.77 0 0 1 1.12 0l9.51 9.39a.8.8 0 0 1 0 1.1l-9.51 9.4a.77.77 0 0 1-1.12 0 .8.8 0 0 1 0-1.11l8.95-8.84L4.4 1.34a.8.8 0 0 1 0-1.1z" fill="currentColor"/></svg>
          </div>
        </div>

        <div class="s-featured-product__thumbnails s-featured-product__thumbnails--strip js-featured-product__thumbnails is-stage-ready">
          {%- if media_count > 0 -%}
            {%- for media in product.media -%}
              <div class="s-featured-product__thumbnail{% if forloop.first %} is-active{% endif %}">
                <picture>{{ media.preview_image | image_url: width: 240, height: 240, crop: 'center' | image_tag: alt: media.alt, loading: 'lazy' }}</picture>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for src in fallback_images -%}
              <div class="s-featured-product__thumbnail{% if forloop.first %} is-active{% endif %}">
                <picture><img alt="" decoding="async" height="600" loading="lazy" src="https://froyaorganics.com/cdn/shop/files/{{ src }}" width="600"></picture>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if ingredients.size > 0 -%}
        <button aria-controls="ingredients-modal" aria-haspopup="dialog" class="s-main-product__view-ingredients js-view-ingredients" type="button">{{ section.settings.ingredients_button }}</button>

        <div aria-labelledby="ingredients-modal-title" aria-modal="true" class="s-main-product__modal" hidden id="ingredients-modal" role="dialog">
          <div class="s-main-product__modal-overlay"></div>
          <div class="s-main-product__modal-container">
            <button aria-label="Close ingredients modal" class="s-main-product__modal-close" type="button">
              <svg fill="none" height="24" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            </button>
            <div class="s-main-product__modal-wrapper">
              <div class="s-main-product__modal-ingredients product-ingredients">
                <div class="s-main-product__modal-content-title section-title" id="ingredients-modal-title"><p></p><p>{{ section.settings.ingredients_title }}</p><p></p></div>
                <ul class="product-ingredients__list" role="list">
                  {%- for block in ingredients -%}
                    <li class="product-ingredients__item" role="listitem" {{ block.shopify_attributes }}>
                      <div class="product-ingredients__media">
                        {%- render 'froya-image', image: block.settings.icon, fallback: block.settings.icon_fallback, alt: block.settings.title, class: 'product-ingredients__icon', width: 240, height: 240 -%}
                      </div>
                      <div class="product-ingredients__body">
                        {%- if block.settings.tag != blank -%}<span class="product-ingredients__tag">{{ block.settings.tag }}</span>{%- endif -%}
                        <h3 class="product-ingredients__title">{{ block.settings.title }}</h3>
                        <div class="product-ingredients__text"><span class="metafield-multi_line_text_field">{{ block.settings.text }}</span></div>
                      </div>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
              {%- capture badge_row -%}
                <div class="product-content__tags-items">
                  {%- for i in (1..4) -%}
                    {%- assign key = 'badge_' | append: i -%}
                    {%- if section.settings[key] != blank -%}
                    <div class="product-content__tags-item">
                      <svg fill="none" height="26" viewBox="0 0 26 26" width="26" xmlns="http://www.w3.org/2000/svg"><circle cx="13" cy="13" r="11.5" stroke="currentColor" stroke-width="1.5"/><path d="M8 13.5l3.2 3.2L18 10" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/></svg>
                      <p> {{ section.settings[key] }}</p>
                    </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endcapture -%}
              <div class="product-content__tags tags-mobile">{{ badge_row }}</div>
              <div class="product-content__info">
                <div class="product-content__info-content">
                  <div class="product-content__info-content-text">
                    <div class="s-main-product__info-content-text-faq">
                      <div>
                        <div>
                          {%- if legend.size > 0 -%}
                          <h3 class="product-content__info-content-text-faq-title">{{ section.settings.legend_title }}</h3>
                          {%- for block in legend -%}
                            <div {{ block.shopify_attributes }}><svg fill="none" height="7" viewBox="0 0 14 14" width="7" xmlns="http://www.w3.org/2000/svg"><circle cx="7.47363" cy="7.33203" fill="{{ block.settings.color }}" r="6.5"></circle></svg><span>{{ block.settings.label }}</span></div>
                          {%- endfor -%}
                          {%- endif -%}
                          {%- if actives.size > 0 -%}
                          <h3 class="product-content__info-content-text-faq-title">{{ section.settings.actives_title }}</h3>
                          {%- for block in actives -%}
                            <div {{ block.shopify_attributes }}><svg fill="none" height="7" viewBox="0 0 14 14" width="7" xmlns="http://www.w3.org/2000/svg"><circle cx="7.47363" cy="7.33203" fill="{{ block.settings.color }}" r="6.5"></circle></svg><span>{{ block.settings.label }}</span></div>
                          {%- endfor -%}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="product-content__tags-button-wrapper">
                    <button class="product-content__tags-button js-close-ingredients-modal" type="button"><p> {{ section.settings.ingredients_close }} </p></button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="product-content__tags tags-desktop">{{ badge_row }}</div>
        {%- endif -%}
      </div>

      <div class="s-featured-product__info" id="ProductInfo-{{ section.id }}">
        {%- capture ships_free -%}
          {%- if section.settings.ships_free_text != blank -%}
          <div class="igsf igsf--d" data-igsf="d"><svg aria-hidden="true" class="igsf__icon" fill="none" focusable="false" height="20" viewBox="0 0 32 20" width="32" xmlns="http://www.w3.org/2000/svg"><path d="M22.1 15.75V1.76c0-.56-.45-1.01-1-1.01H6.33c-.56 0-1.01.45-1.01 1.01v12.99c0 .56.45 1 1.01 1h1.88" stroke="#05AC2E" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M13.71 15.75h8.4" stroke="#05AC2E" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M27.57 15.75h2.42c.56 0 1.01-.45 1.01-1.01v-5c0-.35-.18-.67-.47-.85l-2.56-1.61a1 1 0 0 1-.4-.49l-1.41-3.6a1.01 1.01 0 0 0-.94-.64h-3.11" stroke="#05AC2E" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><circle cx="10.96" cy="15.75" r="2.75" stroke="#05AC2E" stroke-width="1.5"/><circle cx="24.84" cy="15.75" r="2.75" stroke="#05AC2E" stroke-width="1.5"/><path d="M1 5.5h6M2.5 9h4.5" stroke="#05AC2E" stroke-linecap="round" stroke-width="1.5"/></svg><p class="igsf__text">{{ section.settings.ships_free_text }}</p></div>
          {%- endif -%}
        {%- endcapture -%}
        {{ ships_free | replace: 'igsf--d', 'igsf--m' | replace: 'data-igsf="d"', 'data-igsf="m"' }}
        <div class="s-featured-product__desktop-head">{{ product_head }}</div>
        {{ ships_free }}
        {%- if section.settings.includes != blank -%}<div class="s-featured-product__product-description">{{ section.settings.includes }}</div>{%- endif -%}

        {%- if tags.size > 0 -%}
        <div class="s-featured-product__product-tags">
          {%- for block in tags -%}
            <div class="s-featured-product__product-tag" {{ block.shopify_attributes }}>
              {%- render 'froya-image', image: block.settings.icon, fallback: block.settings.icon_fallback, alt: block.settings.text, class: 'product-tag__icon', width: 24, height: 24 -%}
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
        </div>
        {%- endif -%}

        <div class="c-product-form js-product-form">
          <c-subscription class="c-subscribtion c-subscribtion--buybox-toggle igcp-on{% if plan == blank %} c-subscribtion--no-plan{% endif %}{% if bundles.size > 0 %} c-subscribtion--bundles{% endif %}" data-default-selling-plan="{{ plan.id }}" data-product-handle="{{ product.handle }}" data-product-id="{{ product.id }}" data-variant-id="{{ variant.id }}">
            {%- form 'product', product, class: 'c-subscribtion__subscription-form js-subscribtion__subscription-form js-ajax-add', id: 'featured-product-form' -%}
              <div class="c-buybox-toggle__priceline">
                <span class="c-buybox-toggle__price c-buybox-toggle__price--sub">
                  <span class="c-buybox-toggle__price-main"><span class="product_price">{{ display_unit_sub | money }}</span></span>{% if display_compare_unit > display_unit_sub %}<span class="c-buybox-toggle__price-compare"><span class="product_price">{{ display_compare_unit | money }}</span></span>{% endif %}</span>
                <span class="c-buybox-toggle__price c-buybox-toggle__price--otp">
                  <span class="c-buybox-toggle__price-main"><span class="product_price">{{ display_unit_otp | money }}</span></span>{% if display_compare_unit > display_unit_otp %}<span class="c-buybox-toggle__price-compare"><span class="product_price">{{ display_compare_unit | money }}</span></span>{% endif %}</span>
                {%- if bundles.size > 0 and section.settings.unit_suffix != blank -%}<span class="c-buybox-toggle__price-unit">{{ section.settings.unit_suffix }}</span>{%- endif -%}
              </div>
              <input name="id" type="hidden" value="{{ variant.id }}">
              <input class="js-bundle-quantity" name="quantity" type="hidden" value="{{ default_qty }}">

              {%- if plan != blank -%}
              <div class="c-buybox-toggle__box">
                <button aria-checked="true" class="c-buybox-toggle__head js-bbt-toggle" role="switch" type="button">
                  <span aria-hidden="true" class="c-buybox-toggle__switch"><span class="c-buybox-toggle__knob"></span></span>
                  <span class="c-buybox-toggle__head-text">
                    <span class="c-buybox-toggle__head-title">{{ section.settings.toggle_title | replace: percent_placeholder, sub_percent }}</span>
                    <span class="c-buybox-toggle__head-sub">{{ section.settings.toggle_sub }}</span>
                  </span>
                </button>
                <div class="c-buybox-toggle__benefits">
                  {%- for col in (1..2) -%}
                    <div class="c-buybox-toggle__col">
                      {%- for row in (1..3) -%}
                        {%- liquid
                          assign n = col | minus: 1 | times: 3 | plus: row
                          assign key = 'benefit_' | append: n
                        -%}
                        {%- if section.settings[key] != blank -%}
                        <div class="c-buybox-toggle__row">
                          <span aria-hidden="true" class="c-buybox-toggle__check"><svg fill="none" viewBox="0 0 11.5 10.5" xmlns="http://www.w3.org/2000/svg"><path d="M10.25 1.25L4.0625 9.25L1.25 6.368" stroke="#E98044" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" vector-effect="non-scaling-stroke"></path></svg></span>
                          <p>{{ section.settings[key] | replace: percent_placeholder, sub_percent }}</p>
                        </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
              {%- endif -%}

              {%- if bundles.size > 0 -%}
              <fieldset class="c-bundle" id="bundle-fieldset-{{ section.id }}">
                {%- if section.settings.bundle_title != blank -%}<legend class="c-bundle__legend">{{ section.settings.bundle_title }}</legend>{%- endif -%}
                {%- for block in bundles -%}
                  {%- liquid
                    assign qty = block.settings.quantity | at_least: 1
                    assign keep = 100 | minus: block.settings.discount
                    assign unit_otp = otp_price | times: keep | divided_by: 100
                    assign unit_sub = sub_price | times: keep | divided_by: 100
                    assign total_otp = unit_otp | times: qty
                    assign total_sub = unit_sub | times: qty
                    assign tier_compare = base_compare | times: qty
                    assign tier_save_otp = tier_compare | minus: total_otp
                    assign tier_save_sub = tier_compare | minus: total_sub
                    assign tier_name = block.settings.title | default: qty
                    assign total_sub_money = total_sub | money
                    assign total_otp_money = total_otp | money
                    assign save_sub_money = tier_save_sub | money
                    assign save_otp_money = tier_save_otp | money
                  -%}
                  <label class="c-bundle__card js-bundle-card{% if block.settings.highlight %} c-bundle__card--highlight{% endif %}{% if block.id == default_bundle.id %} is-selected{% endif %}" data-compare-total="{{ tier_compare | money }}" data-compare-total-cents="{{ tier_compare }}" data-qty="{{ qty }}" data-save-otp="{{ tier_save_otp | money }}" data-save-otp-cents="{{ tier_save_otp }}" data-save-sub="{{ tier_save_sub | money }}" data-save-sub-cents="{{ tier_save_sub }}" data-total-otp="{{ total_otp | money }}" data-total-otp-cents="{{ total_otp }}" data-total-sub="{{ total_sub | money }}" data-total-sub-cents="{{ total_sub }}" data-unit-otp="{{ unit_otp | money }}" data-unit-sub="{{ unit_sub | money }}" {{ block.shopify_attributes }}>
                    <input class="c-bundle__radio" name="bundle_tier" type="radio" value="{{ qty }}"{% if block.id == default_bundle.id %} checked{% endif %}>
                    <span class="c-bundle__main">
                      <span aria-hidden="true" class="c-bundle__dot"></span>
                      <span class="c-bundle__text">
                        {%- if block.settings.badge != blank -%}<span class="c-bundle__badge">{{ block.settings.badge }}</span>{%- endif -%}
                        <span class="c-bundle__name">{{ tier_name }}</span>
                        {%- if block.settings.subtitle != blank -%}<span class="c-bundle__sub">{{ block.settings.subtitle }}</span>{%- endif -%}
                      </span>
                      <span class="c-bundle__pricing">
                        <span class="c-bundle__unit c-bundle__unit--sub"><span class="product_price">{{ unit_sub | money }}</span></span>
                        <span class="c-bundle__unit c-bundle__unit--otp"><span class="product_price">{{ unit_otp | money }}</span></span>
                        {%- if base_compare > unit_sub -%}<span class="c-bundle__unit-compare c-bundle__unit-compare--sub"><span class="product_price">{{ base_compare | money }}</span></span>{%- endif -%}
                        {%- if base_compare > unit_otp -%}<span class="c-bundle__unit-compare c-bundle__unit-compare--otp"><span class="product_price">{{ base_compare | money }}</span></span>{%- endif -%}
                        {%- if section.settings.unit_suffix != blank -%}<span class="c-bundle__unit-label">{{ section.settings.unit_suffix }}</span>{%- endif -%}
                      </span>
                    </span>
                    <span class="c-bundle__meta">
                      {%- if section.settings.total_text != blank -%}
                      <span class="c-bundle__total c-bundle__total--sub">{{ section.settings.total_text | replace: total_placeholder, total_sub_money }}</span>
                      <span class="c-bundle__total c-bundle__total--otp">{{ section.settings.total_text | replace: total_placeholder, total_otp_money }}</span>
                      {%- endif -%}
                      {%- if block.settings.discount > 0 and section.settings.save_text != blank -%}
                      <span class="c-bundle__save c-bundle__save--sub">{{ section.settings.save_text | replace: amount_placeholder, save_sub_money | replace: percent_placeholder, block.settings.discount }}</span>
                      <span class="c-bundle__save c-bundle__save--otp">{{ section.settings.save_text | replace: amount_placeholder, save_otp_money | replace: percent_placeholder, block.settings.discount }}</span>
                      {%- endif -%}
                    </span>
                    {%- if block.settings.gift != blank -%}<span class="c-bundle__gift">{{ block.settings.gift }}</span>{%- endif -%}
                    {%- if block.settings.perks != blank -%}<span class="c-bundle__perks">{{ block.settings.perks }}</span>{%- endif -%}
                  </label>
                {%- endfor -%}
              </fieldset>
              {%- endif -%}

              {%- if show_congrats -%}
              <div class="c-buybox-toggle__congrats"{% if display_save <= 0 %} hidden{% endif %}>
                <span aria-hidden="true">🎉</span><span>{{ section.settings.congrats_text }} <span class="product_price">{{ display_save | money }}</span></span>
              </div>
              {%- endif -%}

              {%- if plan != blank -%}
              <fieldset class="c-subscribtion__buttons-wrapper c-subscribtion__buttons-wrapper--column" id="purchase-type-fieldset">
                <label>
                  <input checked name="purchase_type" type="radio" value="subscription">
                  {%- if section.settings.sub_badge != blank -%}<span class="c-subscribtion__discount-label c-subscribtion__discount-label--orange">{{ section.settings.sub_badge | replace: percent_placeholder, sub_percent }}</span>{%- endif -%}
                  <span class="c-subscribtion__option-name">{{ section.settings.sub_name }}</span>
                  <div class="c-subscribtion__option-price js-subscribtion__option-price">
                    <span class="js-subscribtion__main-price"><span class="product_price">{{ sub_price | money }}</span></span>
                    {%- if saving > 0 -%}<span class="js-subscribtion__compare-at-price"><span class="product_price">{{ otp_price | money }}</span></span>{%- endif -%}
                  </div>
                  {%- if section.settings.sub_perks != blank -%}
                  <div class="c-subscribtion__button-info-wrapper"><div><div class="metafield-rich_text_field">{{ section.settings.sub_perks | replace: percent_placeholder, sub_percent }}</div></div></div>
                  {%- endif -%}
                </label>
                <label>
                  <input name="purchase_type" type="radio" value="one_time">
                  {%- if section.settings.otp_badge != blank -%}<span class="c-subscribtion__discount-label">{{ section.settings.otp_badge }}</span>{%- endif -%}
                  <span class="c-subscribtion__option-name">{{ section.settings.otp_name }}</span>
                  <div class="c-subscribtion__option-price js-subscribtion__option-price">
                    <span class="js-subscribtion__main-price"><span class="product_price">{{ otp_price | money }}</span></span>
                    {%- if otp_compare > otp_price -%}<span class="js-subscribtion__compare-at-price"><span class="product_price">{{ otp_compare | money }}</span></span>{%- endif -%}
                  </div>
                </label>
                <fieldset class="c-subscribtion__buttons-wrapper c-subscribtion__buttons-wrapper--no-marign c-subscribtion__buttons-wrapper--fixed-plan" id="selling-plan-fieldset">
                  {%- if section.settings.delivery_label != blank -%}<div class="c-subscribtion__fixed-plan-label">{{ section.settings.delivery_label }}</div>{%- endif -%}
                  <input class="js-default-selling-plan" name="selling_plan" type="hidden" value="{{ plan.id }}">
                  <div class="c-subscribtion__subscription-info-wrapper">
                    {%- if section.settings.info_1 != blank -%}<div class="s-main-product__subscription-info"><svg fill="none" height="11" viewBox="0 0 9 11" width="9" xmlns="http://www.w3.org/2000/svg"><path d="M1.00049 6.8125L3.50049 9.8125L7.99951 0.8125" stroke="black" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>{{ section.settings.info_1 }}</span></div>{%- endif -%}
                    {%- if section.settings.info_2 != blank -%}<div class="s-main-product__subscription-info"><svg fill="none" height="11" viewBox="0 0 9 11" width="9" xmlns="http://www.w3.org/2000/svg"><path d="M1.00049 6.8125L3.50049 9.8125L7.99951 0.8125" stroke="black" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>{{ section.settings.info_2 }}</span></div>{%- endif -%}
                  </div>
                </fieldset>
              </fieldset>
              {%- endif -%}

              <button class="c-subscribtion__add-to-cart js-subscribtion__add-to-cart custom-button" data-redirect-to-checkout="false" is="loader-button" type="submit"{% unless variant.available %} disabled{% endunless %}>
                <span class="loader-button__text">
                  <span class="c-subscribtion__button-text js-subscribtion__button-text">{% if variant.available %}{{ section.settings.button_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</span>
                  {%- if variant.available -%}
                  <span class="js-subscribtion__price-wrapper">
                    <span class="c-subscribtion__price js-subscribtion__main-price"><span class="product_price">{% if plan != blank %}{{ display_total_sub | money }}{% else %}{{ display_total_otp | money }}{% endif %}</span></span>{% if show_button_compare %}<s class="igcp">{{ display_compare_total | money }}</s>{% endif %}
                  </span>
                  {%- endif -%}
                </span>
                <span class="loader-button__loader" hidden>
                  <div class="spinner"><svg class="icon icon--spinner" focusable="false" height="24" viewBox="25 25 50 50" width="24"><circle cx="50" cy="50" fill="none" r="20" stroke="currentColor" stroke-width="5"></circle></svg></div>
                </span>
              </button>
              <p class="c-subscribtion__error" data-form-error hidden></p>
            {%- endform -%}
          </c-subscription>
        </div>

        {%- if usps.size > 0 -%}
        <div class="s-featured-product__product-icons igsf-icons--trimmed">
          {%- for block in usps -%}
            <div class="s-featured-product__product-icon-wrapper" {{ block.shopify_attributes }}>
              <div class="s-featured-product__product-icon"><picture>{%- render 'froya-image', image: block.settings.icon, fallback: block.settings.icon_fallback, alt: '', width: 32, height: 28 -%}</picture></div>
              <div class="s-featured-product__product-icon-text">{{ block.settings.text | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' }}</div>
            </div>
          {%- endfor -%}
        </div>
        {%- endif -%}

        {%- if section.settings.show_low_stock and variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= section.settings.low_stock_threshold -%}
        <div class="c-low-stock"><div class="c-low-stock__inner">
          <span aria-hidden="true" class="c-low-stock__flame">🔥</span>
          <span class="c-low-stock__text">{{ section.settings.low_stock_text | replace: count_placeholder, variant.inventory_quantity }}</span>
        </div></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</s-featured-product>
{%- endif -%}
</div>

{% schema %}
{
  "name": "Featured product",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Gallery, prices, subscription plan and the add-to-cart form come from this product. Edit its images in Products." },
    { "type": "text", "id": "product_title", "label": "Displayed name", "info": "Leave empty to use the product title.", "default": "Pumpkin Seed Regrowth Oil" },
    { "type": "header", "content": "Badge above the product" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Formulated for women’s hair loss," },
    { "type": "text", "id": "badge_underline", "label": "Underlined part", "default": "not adapted from men’s" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#e5f3fa" },
    { "type": "color", "id": "badge_color", "label": "Badge text colour", "default": "#54585a" },
    { "type": "header", "content": "Labels & rating" },
    { "type": "text", "id": "label_1", "label": "Label 1", "default": "Pumpkin Seed Oil + Caffeine Complex" },
    { "type": "text", "id": "label_2", "label": "Label 2", "default": "30-day supply" },
    { "type": "number", "id": "reviews_count", "label": "Review count", "default": 43 },
    { "type": "range", "id": "rating", "label": "Star rating", "min": 0, "max": 5, "step": 0.1, "default": 4.8 },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.77/5 FROM VERIFIED BUYERS" },
    { "type": "text", "id": "save_tag", "label": "Gallery save tag", "default": "Save {percent}%", "info": "{percent} is replaced with the subscription discount." },
    { "type": "text", "id": "ships_free_text", "label": "Shipping banner", "default": "THIS ORDER SHIPS FREE" },
    { "type": "richtext", "id": "includes", "label": "What you get", "default": "<p>What you get (30-day supply):<br>· Pumpkin Seed Regrowth Oil with Caffeine Complex<br>· Precision applicator for scalp-only, no-waste application<br>· Scalp massager to boost circulation at the root<br>· Free insured shipping and a 30-day money-back guarantee</p>" },
    { "type": "header", "content": "Ingredients modal" },
    { "type": "text", "id": "ingredients_button", "label": "Open button label", "default": "View Ingredients" },
    { "type": "text", "id": "ingredients_title", "label": "Modal heading", "default": "6 Key Actives, Chosen to Work Together" },
    { "type": "text", "id": "ingredients_close", "label": "Close button label", "default": "Close" },
    { "type": "text", "id": "badge_1", "label": "Badge 1", "default": "0 minoxidil" },
    { "type": "text", "id": "badge_2", "label": "Badge 2", "default": "0 hormones" },
    { "type": "text", "id": "badge_3", "label": "Badge 3", "default": "100% natural" },
    { "type": "text", "id": "badge_4", "label": "Badge 4", "default": "3rd party tested" },
    { "type": "text", "id": "legend_title", "label": "Legend heading", "default": "INGREDIENT LEVELS" },
    { "type": "text", "id": "actives_title", "label": "Actives heading", "default": "KEY ACTIVES – PUMPKIN SEED REGROWTH OIL" },
    { "type": "header", "content": "Bundles" },
    { "type": "text", "id": "bundle_title", "label": "Bundle heading", "default": "Choose your bundle", "info": "Add \"Bundle tier\" blocks below. The tier discount comes off the price per bottle; the quantity is what is added to cart, so the Kaching Bundles quantity break applies the same discount at checkout. Keep the tiers and discounts identical to the ones set in Kaching Bundles." },
    { "type": "text", "id": "unit_suffix", "label": "Per-unit label", "default": "per bottle" },
    { "type": "text", "id": "total_text", "label": "Total line", "default": "{total} total", "info": "{total} is replaced with the bundle total." },
    { "type": "text", "id": "save_text", "label": "Savings line", "default": "Save {amount} ({percent}% off)", "info": "{amount} is the money saved, {percent} the tier discount." },
    { "type": "header", "content": "Subscribe & save" },
    { "type": "text", "id": "toggle_title", "label": "Toggle title", "default": "Save {percent}% with our flexible plan" },
    { "type": "text", "id": "toggle_sub", "label": "Toggle subtitle", "default": "No contracts. Cancel with ease." },
    { "type": "inline_richtext", "id": "benefit_1", "label": "Benefit 1", "default": "<strong>Free Insured Shipping</strong> Every Order" },
    { "type": "inline_richtext", "id": "benefit_2", "label": "Benefit 2", "default": "<strong>{percent}% Off</strong> Every Order" },
    { "type": "inline_richtext", "id": "benefit_3", "label": "Benefit 3", "default": "30-Day <strong>Money-Back Guarantee</strong>" },
    { "type": "inline_richtext", "id": "benefit_4", "label": "Benefit 4", "default": "<strong>Skip</strong>, <strong>Pause</strong> or <strong>Cancel</strong> Anytime" },
    { "type": "inline_richtext", "id": "benefit_5", "label": "Benefit 5", "default": "Consistency Is <strong>What Regrows Hair</strong>" },
    { "type": "inline_richtext", "id": "benefit_6", "label": "Benefit 6", "default": "<strong>Never Miss</strong> a Night of Regrowth" },
    { "type": "text", "id": "congrats_text", "label": "Savings line", "default": "Congrats! You’re saving" },
    { "type": "text", "id": "sub_badge", "label": "Subscription badge", "default": "SAVE {percent}% ON EVERY ORDER" },
    { "type": "text", "id": "sub_name", "label": "Subscription option name", "default": "Subscribe & save" },
    { "type": "richtext", "id": "sub_perks", "label": "Subscription perks", "default": "<p><strong>LOWEST PRICE</strong> every month<br><strong>{percent}% OFF</strong> every order<br><strong>FREE INSURED SHIPPING</strong> always<br><strong>CANCEL, PAUSE, EDIT</strong> anytime<br><strong>RESERVED</strong> stock<br><strong>LONG-TERM</strong> fuller hair</p>" },
    { "type": "text", "id": "otp_badge", "label": "One-time badge", "default": "NO COMMITMENT" },
    { "type": "text", "id": "otp_name", "label": "One-time option name", "default": "One-Time Purchase" },
    { "type": "text", "id": "delivery_label", "label": "Delivery frequency label", "default": "Delivered every 30 days" },
    { "type": "text", "id": "info_1", "label": "Info line 1", "default": "FREE insured shipping on every order" },
    { "type": "text", "id": "info_2", "label": "Info line 2", "default": "Cancel online anytime" },
    { "type": "header", "content": "Button & stock" },
    { "type": "text", "id": "button_label", "label": "Add to cart label", "default": "Add to Cart -" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "checkbox", "id": "show_low_stock", "label": "Show low-stock notice", "default": true, "info": "Uses the variant's tracked inventory." },
    { "type": "range", "id": "low_stock_threshold", "label": "Low-stock threshold", "min": 5, "max": 500, "step": 5, "default": 150 },
    { "type": "text", "id": "low_stock_text", "label": "Low-stock text", "default": "Low Stock: only {count} left" }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle tier",
      "settings": [
        { "type": "range", "id": "quantity", "label": "Bottles in this bundle", "min": 1, "max": 6, "step": 1, "default": 1, "info": "Added to cart as this quantity." },
        { "type": "range", "id": "discount", "label": "Discount off the price per bottle", "min": 0, "max": 60, "step": 1, "unit": "%", "default": 0, "info": "Must match the quantity break configured in Kaching Bundles, which applies the real discount at checkout." },
        { "type": "text", "id": "title", "label": "Tier name", "default": "1 Bottle" },
        { "type": "text", "id": "subtitle", "label": "Tier subtitle", "default": "30-day supply" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "For example MOST POPULAR or BEST VALUE. Leave empty for no badge." },
        { "type": "text", "id": "gift", "label": "Free gift line", "info": "For example + FREE Scalp Massager. Leave empty to hide." },
        { "type": "inline_richtext", "id": "perks", "label": "Perks line" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this tier", "default": false },
        { "type": "checkbox", "id": "selected", "label": "Selected by default", "default": false }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient (modal)",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "Square, about 240 × 240 px." },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Blocks DHT" },
        { "type": "text", "id": "title", "label": "Title", "default": "Pumpkin seed phytosterols" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Beta-sitosterol and delta-7-sterine, the plant sterols in pumpkin seed oil, help inhibit 5-alpha-reductase so less testosterone becomes follicle-shrinking DHT." },
        { "type": "text", "id": "icon_fallback", "label": "Fallback icon URL", "info": "Used only until an icon is uploaded." }
      ]
    },
    {
      "type": "legend",
      "name": "Legend row (modal)",
      "settings": [
        { "type": "color", "id": "color", "label": "Dot colour", "default": "#4A90E2" },
        { "type": "text", "id": "label", "label": "Label", "default": "CAFFEINE COMPLEX" }
      ]
    },
    {
      "type": "active",
      "name": "Key active (modal)",
      "settings": [
        { "type": "color", "id": "color", "label": "Dot colour", "default": "#5A9512" },
        { "type": "text", "id": "label", "label": "Label", "default": "COLD-PRESSED CUCURBITA PEPO (PUMPKIN) SEED OIL" }
      ]
    },
    {
      "type": "tag",
      "name": "Benefit tag",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "About 24 × 24 px." },
        { "type": "text", "id": "text", "label": "Text", "default": "reduce shedding" },
        { "type": "text", "id": "icon_fallback", "label": "Fallback icon URL", "info": "Used only until an icon is uploaded." }
      ]
    },
    {
      "type": "usp",
      "name": "USP under the button",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "About 32 × 28 px." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>fuller hair in 30 days or your money back</p>" },
        { "type": "text", "id": "icon_fallback", "label": "Fallback icon URL", "info": "Used only until an icon is uploaded." }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    { "name": "Featured product", "blocks": [ { "type": "bundle" }, { "type": "bundle" }, { "type": "bundle" }, { "type": "tag" }, { "type": "tag" }, { "type": "tag" }, { "type": "usp" }, { "type": "usp" }, { "type": "usp" } ] }
  ]
}
{% endschema %}
