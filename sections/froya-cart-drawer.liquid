{% comment %}
  Cart drawer – slides in from the right when the header cart button is clicked or a product is added.
  Rendered from the cart object; assets/main.js re-renders it through the Section Rendering API after
  every cart change (add, quantity, remove, subscribe & save toggle).
{% endcomment %}
{%- liquid
  assign badges = section.blocks | where: 'type', 'badge'
  assign upsells = section.settings.upsells
  assign amount_placeholder = '{amount}'
-%}
{%- liquid
  comment
    The free subscription gift the buy box advertises. assets/main.js adds it (one unit, tagged with a
    _free_gift line property) whenever a line on the pinned plan is in the cart and takes it out again
    when the last such line goes. The theme cannot price it: the gift is only $0 once a free-gift
    discount exists (Kaching Subscriptions > free gift on the plan, or a Shopify automatic discount).
  endcomment
  assign gift_product = section.settings.gift_product
  assign gift_variant = blank
  if gift_product != blank
    assign gift_variant = gift_product.selected_or_first_available_variant
  endif
  assign pinned_plan_id = section.settings.selling_plan_id | default: '' | strip
-%}
<cart-drawer id="mini-cart" class="mini-cart s-mini-cart drawer drawer--large" role="dialog" aria-modal="true" aria-labelledby="mini-cart-title" data-section-id="{{ section.id }}" data-root-url="{{ routes.root_url }}" data-cart-count="{{ cart.item_count }}"{% if gift_variant != blank %} data-gift-variant-id="{{ gift_variant.id }}" data-gift-plan-id="{{ pinned_plan_id }}"{% endif %} hidden>
  <span class="drawer__overlay" data-cart-close></span>
  <div class="drawer__panel">
    <header class="drawer__header">
      <span id="mini-cart-title" class="s-mini-cart__title" data-cart-title>{{ section.settings.title }} · {{ cart.item_count }}</span>
      <button type="button" class="drawer__close-button tap-area" data-cart-close aria-label="Close cart">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 16 16" fill="none"><path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.1"/></svg>
      </button>
    </header>
    <div class="visually-hidden" aria-live="polite" data-cart-status></div>

    <div class="drawer__content{% if cart.item_count == 0 %} drawer__content--empty{% endif %}" data-cart-content>
      {%- if cart.item_count == 0 -%}
        {%- liquid
          assign empty_product = section.settings.empty_product
          if empty_product == blank
            assign empty_product = upsells | first
          endif
          assign threshold = section.settings.shipping_threshold | default: 0 | times: 100
          assign remaining = threshold | minus: cart.total_price
          assign remaining_money = remaining | money_without_trailing_zeros
          assign amount_placeholder = '{amount}'
          assign progress = 0
          if threshold > 0
            assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
          endif
        -%}
        {%- if section.settings.show_shipping_bar and threshold > 0 -%}
        <div class="s-mini-cart__empty-shipping free-shipping">
          <p class="free-shipping__text">
            {%- if remaining > 0 -%}
              {{ section.settings.shipping_text | replace: amount_placeholder, remaining_money }} <span>{{ section.settings.shipping_highlight }}</span>
            {%- else -%}
              {{ section.settings.shipping_unlocked }}
            {%- endif -%}
          </p>
          <div class="free-shipping__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}">
            <div class="free-shipping__progress" style="width: {{ progress }}%;"></div>
            <span class="free-shipping__dot free-shipping__dot--start" aria-hidden="true"></span>
            <span class="free-shipping__dot free-shipping__dot--end{% if progress >= 100 %} is-reached{% endif %}" aria-hidden="true"></span>
          </div>
          {%- if section.settings.shipping_label != blank -%}<span class="free-shipping__label">{{ section.settings.shipping_label }}</span>{%- endif -%}
        </div>
        {%- endif -%}
        {%- if section.settings.reviews_banner != blank -%}
        <div class="s-mini-cart__reviews-banner">
          <span class="s-mini-cart__reviews-stars" aria-hidden="true">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 1.8l3.1 6.6 7.2.9-5.3 5 1.4 7.1L12 17.9l-6.4 3.5L7 14.3l-5.3-5 7.2-.9z"/></svg>{%- endfor -%}</span>
          <span>{{ section.settings.reviews_banner }}</span>
        </div>
        {%- endif -%}
        <div class="s-mini-cart__empty">
          <p class="s-mini-cart__empty-title">{{ section.settings.empty_title }}</p>
          {%- if section.settings.empty_text != blank -%}<p class="s-mini-cart__empty-text">{{ section.settings.empty_text }}</p>{%- endif -%}
          {%- if empty_product != blank -%}
            {%- liquid
              comment
                A plain "+ Add To Cart" adds a plain one-time line. This card used to attach the
                product's first selling plan, which enrolled the shopper in a recurring order they
                were never shown - they opt in afterwards with the line's subscribe & save toggle.
              endcomment
              assign empty_variant = empty_product.selected_or_first_available_variant
            -%}
            <div class="drawer__product drawer__product--empty">
              <div class="drawer__product-image">
                <a href="{{ empty_product.url }}" class="drawer__product-link">
                  {%- if empty_product.featured_image != blank -%}
                    {{ empty_product.featured_image | image_url: width: 320, height: 320, crop: 'center' | image_tag: class: 'drawer__product-image', alt: empty_product.title, loading: 'lazy' }}
                  {%- endif -%}
                </a>
              </div>
              <div class="drawer__product-content">
                <a href="{{ empty_product.url }}" class="drawer__product-title">{{ empty_product.title }}</a>
                <div class="drawer__product-price">{{ section.settings.from_label }} <strong>{{ empty_product.price_min | money_without_trailing_zeros }}</strong></div>
                {%- form 'product', empty_product, class: 'drawer__product-form js-ajax-add' -%}
                  <input type="hidden" name="id" value="{{ empty_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="drawer__product-button"{% unless empty_variant.available %} disabled{% endunless %}>{% if empty_variant.available %}{{ section.settings.empty_add_label }}{% else %}SOLD OUT{% endif %}</button>
                {%- endform -%}
              </div>
            </div>
          {%- endif -%}
          <a class="custom-button s-mini-cart__empty-button" href="{{ section.settings.empty_url | default: '/collections/all' }}">{{ section.settings.empty_button }}</a>
        </div>
      {%- else -%}
        <form id="mini-cart-form" action="{{ routes.cart_url }}" method="post" novalidate>
          <input type="hidden" name="checkout">
          {%- for item in cart.items -%}
            {%- liquid
              assign line = forloop.index
              comment
                Offer the cheapest plan the VARIANT itself allocates, the same way the buy box does.
                A product's selling plan groups are one-per-cadence in an order Liquid does not
                define, so the product's first group is often a plan this variant cannot use - the
                toggle would then hand the cart a selling plan it rejects.
              endcomment
              assign plan_id = blank
              assign plan_price = item.variant.price
              assign plan_saving = 0
              for allocation in item.variant.selling_plan_allocations
                if plan_id == blank or allocation.price < plan_price
                  assign plan_id = allocation.selling_plan.id
                  assign plan_price = allocation.price
                endif
              endfor
              comment
                Every cadence carries the same discount, so "cheapest" is a tie and the toggle would
                enrol the shopper in whichever plan Liquid lists first - possibly the six-monthly one.
                The "Subscription plan ID" setting pins the toggle to the plan the buy box sells.
              endcomment
              if pinned_plan_id != blank
                for allocation in item.variant.selling_plan_allocations
                  assign candidate_id = allocation.selling_plan.id | append: ''
                  if candidate_id == pinned_plan_id
                    assign plan_id = allocation.selling_plan.id
                    assign plan_price = allocation.price
                    break
                  endif
                endfor
              endif
              if plan_id != blank
                assign plan_saving = item.variant.price | minus: plan_price
              endif
              comment
                A line the theme added as the free subscription gift: no toggle, no quantity, and
                priced as FREE once the free-gift discount has zeroed it.
              endcomment
              assign is_gift = false
              if item.properties._free_gift != blank
                assign is_gift = true
              endif
              comment
                The switch acts on the whole product, not this one line: a bundle's free bottle sits
                on its own $0 line (the quantity-break discount splits it off), and the toggle merges
                every line of the variant back into one before adding the plan. So the saving shown
                is what the plan takes off everything the shopper is paying for this product right
                now: the per-unit plan discount, scaled by what each line actually costs after the
                bundle discount (a free bottle saves nothing more; a discounted one saves less).
              endcomment
              assign variant_saving = 0
              if plan_id != blank and item.selling_plan_allocation == blank
                for other in cart.items
                  if other.variant_id == item.variant_id and other.selling_plan_allocation == blank and other.properties._free_gift == blank and other.original_line_price > 0
                    assign other_saving = plan_saving | times: other.quantity | times: other.final_line_price | divided_by: other.original_line_price
                    assign variant_saving = variant_saving | plus: other_saving
                  endif
                endfor
              endif
              comment
                The cadence variants (Monthly / Quarterly / Biannual) exist only to hang a
                subscription plan on, and the buy box pins one, so the shopper never chooses
                between them. Printed under the line that title reads as a delivery promise -
                "Monthly" sitting under a one-time purchase - so only show a variant title the
                shopper could have picked: one that prices differently, or one with no plan of its
                own. What the shopper actually committed to comes from the plan name below.
              endcomment
              assign show_variant_title = false
              if item.product.has_only_default_variant == false and item.variant.title != 'Default Title'
                assign show_variant_title = true
                if plan_id != blank and item.product.price_min == item.product.price_max
                  assign show_variant_title = false
                endif
              endif
            -%}
            <line-item class="line-item{% if is_gift %} line-item--gift{% endif %}" data-line="{{ line }}" data-key="{{ item.key }}"{% if is_gift %} data-gift{% endif %}>
              <div class="line-item__content-wrapper">
                <button type="button" class="s-mini-cart__remove-btn" data-cart-remove="{{ line }}" aria-label="Remove {{ item.product.title | escape }}">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
                </button>
                <a href="{{ item.url }}" class="line-item__image-wrapper" tabindex="-1" aria-hidden="true">
                  {%- if item.image != blank -%}
                    {{ item.image | image_url: width: 184, height: 184, crop: 'center' | image_tag: class: 'line-item__image', alt: item.product.title, loading: 'lazy' }}
                  {%- endif -%}
                </a>
                <div class="line-item__info">
                  <div class="product-item-meta">
                    <a href="{{ item.url }}" class="product-item-meta__title text--small">{{ item.product.title }}</a>
                    {%- if is_gift and section.settings.gift_label != blank -%}
                      <span class="product-item-meta__variant line-item__gift-label">{{ section.settings.gift_label }}</span>
                    {%- elsif show_variant_title -%}
                      <span class="product-item-meta__variant text--xsmall text--subdued">{{ item.variant.title }}</span>
                    {%- endif -%}
                    {%- comment -%}
                      The selling plan's own name ("Delivery: every month | 10% off") is not repeated
                      here: the Subscribe & save switch below already shows what the line is.
                    {%- endcomment -%}
                    {%- if plan_id != blank and section.settings.show_subscribe_toggle and is_gift == false -%}
                      <div class="line-item__subscription">
                        <label class="subscription-toggle" role="switch" aria-checked="{% if item.selling_plan_allocation %}true{% else %}false{% endif %}">
                          <input type="checkbox" class="subscription-checkbox" data-cart-plan-toggle data-line="{{ line }}" data-variant-id="{{ item.variant_id }}" data-selling-plan-id="{{ plan_id }}"{% if item.selling_plan_allocation %} checked{% endif %}>
                          {%- liquid
                            assign saving_money = variant_saving | money
                            assign saving_line = section.settings.subscribe_saving_text | replace: amount_placeholder, saving_money
                          -%}
                          <span class="subscription-text">
                            {{ section.settings.subscribe_label }}
                            {%- if item.selling_plan_allocation == blank and variant_saving > 0 and saving_line != blank %} <span class="subscription-saving product_price">{{ saving_line }}</span>{%- endif -%}
                          </span>
                          <span class="subscription-toggle-switch" aria-hidden="true"><span class="subscription-toggle-knob"></span></span>
                        </label>
                      </div>
                    {%- endif -%}
                    <div class="product-item-meta__info">
                      {%- if is_gift -%}
                      <span class="line-item__gift-quantity">{{ item.quantity }} ×</span>
                      {%- else -%}
                      <line-item-quantity class="line-item__quantity"><div class="custom-quantity-selector custom-quantity-selector--small">
                        <button type="button" class="custom-quantity-selector__button custom-quantity-selector__button--icon" data-cart-qty="{{ line }}" data-cart-qty-value="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity"><svg aria-hidden="true" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="9" cy="9" r="8"/><path d="M5.5 9h7" stroke-linecap="round"/></svg></button>
                        <span class="custom-quantity-selector__text">{{ item.quantity }}</span>
                        <button type="button" class="custom-quantity-selector__button custom-quantity-selector__button--icon" data-cart-qty="{{ line }}" data-cart-qty-value="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity"><svg aria-hidden="true" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="9" cy="9" r="8"/><path d="M5.5 9h7M9 5.5v7" stroke-linecap="round"/></svg></button>
                      </div></line-item-quantity>
                      {%- endif -%}
                      <div class="product-item-meta__price-list-container text--small"><div class="price-list">
                        {%- if is_gift and item.final_line_price == 0 and section.settings.gift_free_text != blank -%}
                        <span class="price price--highlight price--free">{{ section.settings.gift_free_text }}</span>
                        <span class="price price--compare"><span class="product_price">{{ item.original_price | money }}</span></span>
                        {%- else -%}
                        <span class="price price--highlight"><span class="product_price">{{ item.final_price | money }}</span></span>
                        {%- if item.original_price > item.final_price -%}
                          <span class="price price--compare"><span class="product_price">{{ item.original_price | money }}</span></span>
                        {%- elsif item.selling_plan_allocation and item.selling_plan_allocation.compare_at_price > item.final_price -%}
                          <span class="price price--compare"><span class="product_price">{{ item.selling_plan_allocation.compare_at_price | money }}</span></span>
                        {%- endif -%}
                        {%- endif -%}
                      </div></div>
                    </div>
                  </div>
                </div>
              </div>
            </line-item>
          {%- endfor -%}
        </form>

        {%- if upsells.size > 0 and section.settings.upsell_title != blank -%}
          <div class="mini-cart__recommendations">
            <div class="mini-cart__recommendations-inner">
              <div class="s-mini-cart__rec-header">
                <p>{{ section.settings.upsell_title }}</p>
                <div class="s-mini-cart__rec-arrows">
                  <button type="button" class="s-mini-cart__rec-arrow s-mini-cart__rec-arrow--prev" data-rec-prev aria-label="Previous recommendation"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></button>
                  <button type="button" class="s-mini-cart__rec-arrow s-mini-cart__rec-arrow--next" data-rec-next aria-label="Next recommendation"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
                </div>
              </div>
              <div class="scroller" data-rec-scroller>
                <div class="mini-cart__recommendations-list">
                  {%- for product in upsells -%}
                    {%- liquid
                      assign in_cart = false
                      for item in cart.items
                        if item.product_id == product.id
                          assign in_cart = true
                        endif
                      endfor
                    -%}
                    {%- unless in_cart -%}
                    {%- assign upsell_variant = product.selected_or_first_available_variant -%}
                    <div class="drawer__product">
                      <div class="drawer__product-image">
                        <a href="{{ product.url }}" class="drawer__product-link">
                          {%- if product.featured_image != blank -%}
                            {{ product.featured_image | image_url: width: 200, height: 200, crop: 'center' | image_tag: class: 'drawer__product-image', alt: product.title, loading: 'lazy' }}
                          {%- endif -%}
                        </a>
                      </div>
                      <div class="drawer__product-content">
                        <a href="{{ product.url }}" class="drawer__product-title">{{ product.title }}</a>
                        <div class="drawer__product-price">From <strong>{{ product.price_min | money }}</strong></div>
                        {%- form 'product', product, class: 'drawer__product-form js-ajax-add' -%}
                          <input type="hidden" name="id" value="{{ upsell_variant.id }}">
                          <input type="hidden" name="quantity" value="1">
                          <button type="submit" class="drawer__product-button"{% unless upsell_variant.available %} disabled{% endunless %}>{% if upsell_variant.available %}{{ section.settings.upsell_button }}{% else %}SOLD OUT{% endif %}</button>
                        {%- endform -%}
                      </div>
                    </div>
                    {%- endunless -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <footer class="mini-cart__drawer-footer drawer__footer drawer__footer--tight drawer__footer--bordered" data-cart-footer{% if cart.item_count == 0 %} hidden{% endif %}>
      <div class="drawer__footer__content">
        {%- liquid
          comment
            Currency follows the storefront's current country, and the cart carries that currency
            through to checkout. The theme sets that country from Shopify's own GeoIP guess on a
            visitor's first page view (Theme settings > Localization), which is wrong often enough
            - a VPN, a corporate proxy, a trip - and the totals below are where the theme first
            spells the currency out, so offer the correction here instead of making the shopper
            hunt for the selector at the bottom of the footer. Submitting reloads the page, which
            is what /localization needs to re-price the cart.
          endcomment
          assign show_market_picker = false
          if section.settings.show_country_selector and localization.available_countries.size > 1
            assign show_market_picker = true
          endif
        -%}
        {%- if show_market_picker -%}
        <div class="s-mini-cart__market">
          {%- form 'localization', id: 'localization_form_cart', class: 's-mini-cart__market-form' -%}
            <label class="s-mini-cart__market-label" for="cart-country-selector">{{ section.settings.country_label }}</label>
            <div class="custom-select">
              <select id="cart-country-selector" class="custom-select__select" name="country_code" onchange="this.form.submit()">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endform -%}
        </div>
        {%- endif -%}
        <div class="drawer__footer-total-info">
          {%- if cart.total_discount > 0 -%}
          <div class="total-info__row total-info__row--savings">
            <span class="total-info__label">{{ section.settings.discount_label }}</span>
            <span class="total-info__price total-info__price--savings">- <span class="product_price">{{ cart.total_discount | money }}</span></span>
          </div>
          {%- endif -%}
          <div class="total-info__row total-info__row--estimated">
            <span class="total-info__label">{{ section.settings.subtotal_label }}</span>
            <span class="total-info__prices"><span class="total-info__price total-info__price--highlight"><span class="product_price">{% if settings.currency_code_enable %}{{ cart.total_price | money_with_currency }}{% else %}{{ cart.total_price | money }}{% endif %}</span></span></span>
          </div>
        </div>
        <button form="mini-cart-form" type="submit" class="checkout-button button button--primary button--full" name="checkout">
          <span class="checkout-button__lock"><svg aria-hidden="true" width="16" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
          <span class="checkout-button__label">{{ section.settings.checkout_label }}</span>{% if section.settings.show_total_on_button %} - <span class="product_price">{{ cart.total_price | money }}</span>{% endif %}
        </button>
        {%- if badges.size > 0 -%}
        <div class="s-mini-cart__guarantee-badges">
          {%- for block in badges -%}
            <div class="s-mini-cart__guarantee-badge" {{ block.shopify_attributes }}>
              <div class="s-mini-cart__badge-icon">
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 64 | image_tag: alt: '', loading: 'lazy' }}
                {%- else -%}
                  {%- case block.settings.default_icon -%}
                    {%- when 'bag' -%}
                      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h12l1 13H5L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                    {%- when 'truck' -%}
                      <svg aria-hidden="true" width="24" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
                    {%- else -%}
                      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M14.5 9.5c0-1-1.1-1.5-2.5-1.5S9.5 8.6 9.5 9.8c0 2.4 5 1.2 5 3.9 0 1.2-1.1 1.8-2.5 1.8s-2.5-.6-2.5-1.6"/></svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>
              <span>{{ block.settings.text | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' }}</span>
            </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>
    </footer>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Cart" },
    { "type": "header", "content": "Empty cart" },
    { "type": "checkbox", "id": "show_shipping_bar", "label": "Show free-shipping progress bar", "default": true },
    { "type": "number", "id": "shipping_threshold", "label": "Free-shipping threshold (in your store currency)", "default": 30 },
    { "type": "text", "id": "shipping_text", "label": "Progress text", "default": "Spend {amount} and get", "info": "{amount} is replaced with what is left to spend." },
    { "type": "text", "id": "shipping_highlight", "label": "Progress text highlight", "default": "FREE SHIPPING" },
    { "type": "text", "id": "shipping_unlocked", "label": "Text once the threshold is reached", "default": "You’ve unlocked FREE SHIPPING" },
    { "type": "text", "id": "shipping_label", "label": "Bar label", "default": "Free shipping" },
    { "type": "text", "id": "reviews_banner", "label": "Reviews banner", "default": "RATED 4.77/5 BY VERIFIED CUSTOMERS", "info": "Shown with five stars under the shipping bar. Leave empty to hide." },
    { "type": "text", "id": "empty_title", "label": "Empty cart title", "default": "Your cart is empty" },
    { "type": "text", "id": "empty_text", "label": "Empty cart text", "info": "Optional line under the title." },
