{% comment %}
  Cart drawer – slides in from the right when the header cart button is clicked or a product is added.
  Rendered from the cart object; assets/main.js re-renders it through the Section Rendering API after
  every cart change (add, quantity, remove, subscribe & save toggle).
{% endcomment %}
{%- liquid
  assign badges = section.blocks | where: 'type', 'badge'
  assign upsells = section.settings.upsells
  assign amount_placeholder = '{amount}'
  assign count_placeholder = '{count}'
-%}
{%- liquid
  comment
    The free subscription gift the buy box advertises. assets/main.js adds it (one unit, tagged with a
    _free_gift line property) whenever a line on the pinned plan is in the cart and takes it out again
    when the last such line goes. The shopper can add more with the quantity buttons: only the first
    one is free, the rest are charged. The theme cannot price it: the gift is $0 through the free-gift
    discount in Kaching Subscriptions (free gift on the plan, quantity 1), which only recognises a
    line that also carries Kaching's __kaching_subs_gift property naming the plan - main.js adds it.
  endcomment
  assign gift_product = section.settings.gift_product
  assign gift_variant = blank
  if gift_product != blank
    assign gift_variant = gift_product.selected_or_first_available_variant
  endif
  assign pinned_plan_id = section.settings.selling_plan_id | default: '' | strip
-%}
<cart-drawer id="mini-cart" class="mini-cart s-mini-cart drawer drawer--large" role="dialog" aria-modal="true" aria-labelledby="mini-cart-title" data-section-id="{{ section.id }}" data-root-url="{{ routes.root_url }}" data-cart-count="{{ cart.item_count }}"{% if gift_variant != blank %} data-gift-variant-id="{{ gift_variant.id }}" data-gift-plan-id="{{ pinned_plan_id }}"{% endif %} hidden>
  <span class="drawer__overlay" data-cart-close></span>
  <div class="drawer__panel">
    <header class="drawer__header">
      <span id="mini-cart-title" class="s-mini-cart__title" data-cart-title>{{ section.settings.title }} · {{ cart.item_count }}</span>
      <button type="button" class="drawer__close-button tap-area" data-cart-close aria-label="Close cart">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 16 16" fill="none"><path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.1"/></svg>
      </button>
    </header>
    <div class="visually-hidden" aria-live="polite" data-cart-status></div>
    {%- comment -%}
      Stays put while the drawer's content is redrawn after every change (a live region that is
      itself replaced is not reliably read out): assets/main.js reads the shipping goal and the
      next-tier nudge into it whenever a change alters them.
    {%- endcomment -%}
    <div class="visually-hidden" aria-live="polite" aria-atomic="true" data-cart-live></div>
    <p class="s-mini-cart__error" role="alert" data-cart-error hidden></p>

    <div class="drawer__content{% if cart.item_count == 0 %} drawer__content--empty{% endif %}" data-cart-content>
      {%- liquid
        comment
          Free express shipping goal. Standard shipping is always free; Express Shipping is free once
          the order total after discounts (cart.total_price, what Shopify's price-based rate checks)
          reaches the threshold, which is in US dollars like the rate in Shopify's shipping settings.
          Shown in both states so it is the first thing the shopper sees after an add to cart.
          Liquid cannot convert dollars into the shopper's currency, so assets/main.js
          (expressGoal) compares the two with Shopify.currency.rate after every render: it writes
          the copy (the amount in the store's money format, taken from data-money), fills the bar,
          animates it from where it stood and orders the add-ons below by it.
        endcomment
        assign express_threshold = section.settings.express_free_threshold | default: 0 | times: 100 | round
      -%}
      {%- if section.settings.show_shipping_bar and express_threshold > 0 -%}
      <div class="s-mini-cart__shipping free-shipping{% if cart.item_count == 0 %} s-mini-cart__shipping--empty{% endif %}" data-cart-shipping data-threshold="{{ express_threshold }}" data-total="{{ cart.total_price }}" data-money="{{ 123456789 | money | escape }}" data-text="{{ section.settings.express_progress_text | escape }}" data-text-reached="{{ section.settings.express_unlocked_text | escape }}" data-progress="0" data-reached="false">
        <p class="free-shipping__text" data-cart-shipping-text></p>
        <div class="free-shipping__bar" role="progressbar" aria-label="Free express shipping" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="free-shipping__progress" style="width: 0%;"></div>
          <span class="free-shipping__dot free-shipping__dot--start" aria-hidden="true"></span>
          <span class="free-shipping__dot free-shipping__dot--end" aria-hidden="true"></span>
        </div>
        {%- if section.settings.express_standard_text != blank -%}
          <p class="free-shipping__note" data-cart-shipping-note hidden>{{ section.settings.express_standard_text }}</p>
        {%- endif -%}
      </div>
      {%- endif -%}
      {%- if cart.item_count == 0 -%}
        {%- liquid
          assign empty_product = section.settings.empty_product
          if empty_product == blank
            assign empty_product = upsells | first
          endif
        -%}
        {%- if section.settings.reviews_banner != blank -%}
        <div class="s-mini-cart__reviews-banner">
          <span class="s-mini-cart__reviews-stars" aria-hidden="true">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 1.8l3.1 6.6 7.2.9-5.3 5 1.4 7.1L12 17.9l-6.4 3.5L7 14.3l-5.3-5 7.2-.9z"/></svg>{%- endfor -%}</span>
          <span>{{ section.settings.reviews_banner }}</span>
        </div>
        {%- endif -%}
        <div class="s-mini-cart__empty">
          <p class="s-mini-cart__empty-title">{{ section.settings.empty_title }}</p>
          {%- if section.settings.empty_text != blank -%}<p class="s-mini-cart__empty-text">{{ section.settings.empty_text }}</p>{%- endif -%}
          {%- if empty_product != blank -%}
            {%- liquid
              comment
                A plain "+ Add To Cart" adds a plain one-time line. This card used to attach the
                product's first selling plan, which enrolled the shopper in a recurring order they
                were never shown - they opt in afterwards with the line's subscribe & save toggle.
              endcomment
              assign empty_variant = empty_product.selected_or_first_available_variant
            -%}
            <div class="drawer__product drawer__product--empty">
              <div class="drawer__product-image">
                <a href="{{ routes.root_url }}#shop" data-scroll-to="shop" class="drawer__product-link">
                  {%- if empty_product.featured_image != blank -%}
                    {{ empty_product.featured_image | image_url: width: 320, height: 320, crop: 'center' | image_tag: class: 'drawer__product-image', alt: empty_product.title, loading: 'lazy' }}
                  {%- endif -%}
                </a>
              </div>
              <div class="drawer__product-content">
                <a href="{{ routes.root_url }}#shop" data-scroll-to="shop" class="drawer__product-title">{{ empty_product.title }}</a>
                <div class="drawer__product-price">{{ section.settings.from_label }} <strong>{{ empty_product.price_min | money_without_trailing_zeros }}</strong></div>
                {%- form 'product', empty_product, class: 'drawer__product-form js-ajax-add' -%}
                  <input type="hidden" name="id" value="{{ empty_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="drawer__product-button"{% unless empty_variant.available %} disabled{% endunless %}>{% if empty_variant.available %}{{ section.settings.empty_add_label }}{% else %}SOLD OUT{% endif %}</button>
                {%- endform -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        <form id="mini-cart-form" action="{{ routes.cart_url }}" method="post" novalidate>
          <input type="hidden" name="checkout">
          {%- liquid
            comment
              The gift can sit on two lines: once the free-gift discount covers one unit and the
              shopper has added more, Shopify splits the line into the $0 unit and the paid extras,
              both still tagged _free_gift. The gift's quantity buttons act on all of it at once,
              so they work from the gift's total quantity.
            endcomment
            assign gift_total_qty = 0
            assign gift_discounted = false
            for item in cart.items
              if item.properties._free_gift != blank
                assign gift_total_qty = gift_total_qty | plus: item.quantity
                if item.final_line_price < item.original_line_price
                  assign gift_discounted = true
                endif
              endif
            endfor
            comment
              One row per bundle. Once a bundle tier applies, Shopify lists the bundle as two lines
              with their own keys - the free bottles at $0 (carrying the discount) and the paid ones -
              and on a subscription Kaching's layout tags the two halves differently (assets/main.js,
              reconcileBundles). The drawer shows every line of the Bundled product (Theme settings >
              Bundle tiers) that shares a variant, a plan and the shopper's own properties as one
              row; Kaching's __kaching_bundles tag is the layout's, not the shopper's, so it is left
              out of that identity. line_group_keys holds each cart line's identity ('-' for any
              other line), and a row is drawn at the first line of its bundle.
            endcomment
            assign bundle_product_id = 0
            if settings.bundle_product != blank
              assign bundle_product_id = settings.bundle_product.id
            endif
            assign line_group_keys = ''
            for item in cart.items
              assign group_key = '-'
              if item.product_id == bundle_product_id and item.properties._free_gift == blank
                assign group_key = item.variant_id | append: '|'
                if item.selling_plan_allocation
                  assign group_key = group_key | append: item.selling_plan_allocation.selling_plan.id
                endif
                assign group_key = group_key | append: '|'
                for property in item.properties
                  if property.first != '__kaching_bundles' and property.last != blank
                    assign group_key = group_key | append: property.first | append: '=' | append: property.last | append: ';'
                  endif
                endfor
              endif
              unless forloop.first
                assign line_group_keys = line_group_keys | append: '~~~'
              endunless
              assign line_group_keys = line_group_keys | append: group_key
            endfor
            assign line_group_keys = line_group_keys | split: '~~~'
            assign shown_groups = '~'
            comment
              An order-level percentage code (EXTRA10) takes the same share off anything added, so
              what a nudge or the add-ons say the order changes by is scaled by the share it leaves,
              in parts per million. The share is read off the cart's own discount and rounded to a
              hundredth of a percent, which drops the cent Shopify rounds each discount to (10% of
              $69.98 is $7.00). Fixed-amount codes take the same off either way and change nothing.
            endcomment
            assign order_keep = 1000000
            if cart.items_subtotal_price > 0
              assign percent_off = 0
              for application in cart.cart_level_discount_applications
                if application.value_type == 'percentage'
                  assign percent_off = percent_off | plus: application.total_allocated_amount
                endif
              endfor
              assign order_keep = cart.items_subtotal_price | minus: percent_off | times: 20000 | plus: cart.items_subtotal_price | divided_by: cart.items_subtotal_price | divided_by: 2 | times: 100
            endif
            assign nudge_shown = false
            assign onetime_total = 0
            assign upgrade_item = blank
            comment
              The serum's rows come first, then everything else (the free gift, add-ons): Shopify
              lists the newest line first, so the gift added with a subscription used to sit above
              the serum. Two passes over the cart keep each line's position (forloop.index), which
              the quantity and remove buttons address.
            endcomment
          -%}
          {%- for pass in (1..2) -%}
          {%- for item in cart.items -%}
            {%- liquid
              assign serum_line = false
              if item.product_id == bundle_product_id and item.properties._free_gift == blank
                assign serum_line = true
              endif
              if pass == 1 and serum_line == false
                continue
              elsif pass == 2 and serum_line
                continue
              endif
              assign line = forloop.index
              assign group_key = line_group_keys[forloop.index0] | default: '-'
              assign is_bundle = false
              if group_key != '-'
                assign group_marker = '~' | append: group_key | append: '~'
                if shown_groups contains group_marker
                  continue
                endif
                assign shown_groups = shown_groups | append: group_key | append: '~'
                assign is_bundle = true
              endif
              comment
                Offer the cheapest plan the VARIANT itself allocates, the same way the buy box does.
                A product's selling plan groups are one-per-cadence in an order Liquid does not
                define, so the product's first group is often a plan this variant cannot use - the
                toggle would then hand the cart a selling plan it rejects.
              endcomment
              assign plan_id = blank
              assign plan_price = item.variant.price
              assign plan_saving = 0
              for allocation in item.variant.selling_plan_allocations
                if plan_id == blank or allocation.price < plan_price
                  assign plan_id = allocation.selling_plan.id
                  assign plan_price = allocation.price
                endif
              endfor
              comment
                Every cadence carries the same discount, so "cheapest" is a tie and the toggle would
                enrol the shopper in whichever plan Liquid lists first - possibly the six-monthly one.
                The "Subscription plan ID" setting pins the toggle to the plan the buy box sells.
              endcomment
              if pinned_plan_id != blank
                for allocation in item.variant.selling_plan_allocations
                  assign candidate_id = allocation.selling_plan.id | append: ''
                  if candidate_id == pinned_plan_id
                    assign plan_id = allocation.selling_plan.id
                    assign plan_price = allocation.price
                    break
                  endif
                endfor
              endif
              if plan_id != blank
                assign plan_saving = item.variant.price | minus: plan_price
              endif
              comment
                A line the theme added as the free subscription gift: no subscribe toggle, and priced as
                FREE once the free-gift discount has zeroed it. Extra units cost the normal price: a line
                that is only partly free shows its total with the full price struck through, and the
                paid half of a split gift is labelled like any other product. Until a free-gift discount
                exists nothing in the cart is discounted, so the label stays on the one gift line.
              endcomment
              assign is_gift = false
              assign gift_has_free_unit = false
              assign show_gift_label = false
              if item.properties._free_gift != blank
                assign is_gift = true
                if item.final_line_price < item.original_line_price
                  assign gift_has_free_unit = true
                  assign show_gift_label = true
                elsif gift_discounted == false
                  assign show_gift_label = true
                endif
              endif
              comment
                The switch acts on the whole product, not this one line: a bundle's free bottle sits
                on its own $0 line (the quantity-break discount splits it off), and the toggle merges
                every line of the variant back into one before adding the plan. So the saving shown
                is what the plan takes off everything the shopper is paying for this product right
                now: the per-unit plan discount, scaled by what each line actually costs after the
                bundle discount (a free bottle saves nothing more; a discounted one saves less).
              endcomment
              assign variant_saving = 0
              if plan_id != blank and item.selling_plan_allocation == blank
                for other in cart.items
                  if other.variant_id == item.variant_id and other.selling_plan_allocation == blank and other.properties._free_gift == blank and other.original_line_price > 0
                    assign other_saving = plan_saving | times: other.quantity | times: other.final_line_price | divided_by: other.original_line_price
                    assign variant_saving = variant_saving | plus: other_saving
                  endif
                endfor
              endif
              comment
                The cadence variants (Monthly / Quarterly / Biannual) exist only to hang a
                subscription plan on, and the buy box pins one, so the shopper never chooses
                between them. Printed under the line that title reads as a delivery promise -
                "Monthly" sitting under a one-time purchase - so only show a variant title the
                shopper could have picked: one that prices differently, or one with no plan of its
                own. What the shopper actually committed to comes from the plan name below.
              endcomment
              assign show_variant_title = false
              if item.product.has_only_default_variant == false and item.variant.title != 'Default Title'
                assign show_variant_title = true
                if plan_id != blank and item.product.price_min == item.product.price_max
                  assign show_variant_title = false
                endif
              endif
              comment
                A bundle row adds up every line of its bundle: the bottles, what they cost together,
                and the bottles the cart prices at $0. The tier's name is the discount's own title
                from the cart. With a discount applied, the strike-through is every bottle at the
                one-time price (the anchor the buy box's "Save" figures use), never the compare-at
                price. The grey line names the supply (snippets/bundle-supply.liquid).
              endcomment
              if is_bundle
                assign row_plan = ''
                if item.selling_plan_allocation
                  assign row_plan = item.selling_plan_allocation.selling_plan.id | append: ''
                endif
                assign row_qty = 0
                assign row_price = 0
                assign row_free = 0
                assign row_tier = ''
                for other in cart.items
                  assign other_key = line_group_keys[forloop.index0]
                  if other_key == group_key
                    assign row_qty = row_qty | plus: other.quantity
                    assign row_price = row_price | plus: other.final_line_price
                    if other.final_line_price == 0 and other.original_line_price > 0
                      assign row_free = row_free | plus: other.quantity
                    endif
                    if row_tier == blank
                      for allocation in other.line_level_discount_allocations
                        if allocation.discount_application.type == 'automatic' and allocation.amount > 0
                          assign row_tier = allocation.discount_application.title
                          break
                        endif
                      endfor
                    endif
                  endif
                endfor
                assign row_compare = item.variant.price | times: row_qty
                capture row_supply
                  render 'bundle-supply', quantity: row_qty
                endcapture
              endif
            -%}
            <line-item class="line-item{% if is_gift %} line-item--gift{% endif %}{% if is_bundle %} line-item--bundle{% endif %}" data-line="{{ line }}" data-key="{{ item.key }}"{% if is_gift %} data-gift{% endif %}{% if is_bundle %} data-group-variant="{{ item.variant_id }}" data-group-plan="{{ row_plan }}" data-group-properties="{{ item.properties | json | escape }}"{% endif %}>
              <div class="line-item__content-wrapper">
                <button type="button" class="s-mini-cart__remove-btn" {% if is_gift %}data-cart-gift-qty="{{ gift_total_qty | minus: item.quantity }}"{% elsif is_bundle %}data-cart-group-set="0"{% else %}data-cart-remove="{{ line }}"{% endif %} aria-label="Remove {{ item.product.title | escape }}">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
                </button>
                <a href="{{ routes.root_url }}#shop" data-scroll-to="shop" class="line-item__image-wrapper" tabindex="-1" aria-hidden="true">
                  {%- if item.image != blank -%}
                    {{ item.image | image_url: width: 184, height: 184, crop: 'center' | image_tag: class: 'line-item__image', alt: item.product.title, loading: 'lazy' }}
                  {%- endif -%}
                </a>
                <div class="line-item__info">
                  <div class="product-item-meta">
                    <a href="{{ routes.root_url }}#shop" data-scroll-to="shop" class="product-item-meta__title text--small">{{ item.product.title }}</a>
                    {%- if show_gift_label and section.settings.gift_label != blank -%}
                      <span class="product-item-meta__variant line-item__gift-label">{{ section.settings.gift_label }}</span>
                      {%- if gift_has_free_unit and gift_total_qty > 1 and section.settings.gift_extra_text != blank -%}
                        <span class="product-item-meta__variant text--xsmall line-item__gift-note">{{ section.settings.gift_extra_text }}</span>
                      {%- endif -%}
                    {%- elsif show_variant_title -%}
                      <span class="product-item-meta__variant text--xsmall text--subdued">{{ item.variant.title }}</span>
                    {%- endif -%}
                    {%- if is_bundle -%}
                      <span class="line-item__bundle-meta">{{ row_supply }}{% if row_tier != blank %} · {{ row_tier }}{% endif %}</span>
                    {%- endif -%}
                    {%- comment -%}
                      The selling plan's own name ("Delivery: every month | 10% off") is not repeated
                      here: the Subscribe & save switch below already shows what the line is.
                    {%- endcomment -%}
                    {%- if plan_id != blank and section.settings.show_subscribe_toggle and is_gift == false -%}
                      <div class="line-item__subscription">
                        <label class="subscription-toggle" role="switch" aria-checked="{% if item.selling_plan_allocation %}true{% else %}false{% endif %}">
                          <input type="checkbox" class="subscription-checkbox" data-cart-plan-toggle data-line="{{ line }}" data-variant-id="{{ item.variant_id }}" data-selling-plan-id="{{ plan_id }}"{% if item.selling_plan_allocation %} checked{% endif %}>
                          {%- liquid
                            assign saving_money = variant_saving | money
                            assign saving_line = section.settings.subscribe_saving_text | replace: amount_placeholder, saving_money
                          -%}
                          <span class="subscription-text">
                            {{ section.settings.subscribe_label }}
                            {%- if item.selling_plan_allocation == blank and variant_saving > 0 and saving_line != blank %} <span class="subscription-saving product_price">{{ saving_line }}</span>{%- endif -%}
                          </span>
                          <span class="subscription-toggle-switch" aria-hidden="true"><span class="subscription-toggle-knob"></span></span>
                        </label>
                      </div>
                    {%- endif -%}
                    <div class="product-item-meta__info">
                      <line-item-quantity class="line-item__quantity"><div class="custom-quantity-selector custom-quantity-selector--small">
                        <button type="button" class="custom-quantity-selector__button custom-quantity-selector__button--icon" {% if is_gift %}data-cart-gift-qty="{{ gift_total_qty | minus: 1 }}"{% elsif is_bundle %}data-cart-group-step="-1"{% else %}data-cart-qty="{{ line }}" data-cart-qty-value="{{ item.quantity | minus: 1 }}"{% endif %} aria-label="Decrease quantity"><svg aria-hidden="true" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="9" cy="9" r="8"/><path d="M5.5 9h7" stroke-linecap="round"/></svg></button>
                        <span class="custom-quantity-selector__text">{% if is_bundle %}{{ row_qty }}{% else %}{{ item.quantity }}{% endif %}</span>
                        <button type="button" class="custom-quantity-selector__button custom-quantity-selector__button--icon" {% if is_gift %}data-cart-gift-qty="{{ gift_total_qty | plus: 1 }}"{% elsif is_bundle %}data-cart-group-step="1"{% else %}data-cart-qty="{{ line }}" data-cart-qty-value="{{ item.quantity | plus: 1 }}"{% endif %} aria-label="Increase quantity"><svg aria-hidden="true" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="9" cy="9" r="8"/><path d="M5.5 9h7M9 5.5v7" stroke-linecap="round"/></svg></button>
                      </div></line-item-quantity>
                      <div class="product-item-meta__price-list-container text--small"><div class="price-list">
                        {%- if is_gift and item.final_line_price == 0 and section.settings.gift_free_text != blank -%}
                        <span class="price price--highlight price--free">{{ section.settings.gift_free_text }}</span>
                        <span class="price price--compare"><span class="product_price">{{ item.original_line_price | money }}</span></span>
                        {%- elsif gift_has_free_unit -%}
                        <span class="price price--highlight"><span class="product_price">{{ item.final_line_price | money }}</span></span>
                        <span class="price price--compare"><span class="product_price">{{ item.original_line_price | money }}</span></span>
                        {%- elsif is_bundle -%}
                        <span class="price price--highlight"><span class="product_price">{{ row_price | money }}</span></span>
                        {%- if row_compare > row_price -%}
                          <span class="price price--compare"><span class="product_price">{{ row_compare | money }}</span></span>
                        {%- endif -%}
                        {%- if row_free > 0 and section.settings.free_tag_text != blank -%}
                          <span class="line-item__free-tag">{{ section.settings.free_tag_text | replace: count_placeholder, row_free }}</span>
                        {%- endif -%}
                        {%- else -%}
                        {%- comment -%}
                          Every other line shows its line total, so the rows add up to the subtotal; the
                          unit price follows underneath once there is more than one.
                        {%- endcomment -%}
                        <span class="price price--highlight"><span class="product_price">{{ item.final_line_price | money }}</span></span>
                        {%- if item.original_line_price > item.final_line_price -%}
                          <span class="price price--compare"><span class="product_price">{{ item.original_line_price | money }}</span></span>
                        {%- elsif item.selling_plan_allocation and item.selling_plan_allocation.compare_at_price > item.final_price -%}
                          <span class="price price--compare"><span class="product_price">{{ item.selling_plan_allocation.compare_at_price | times: item.quantity | money }}</span></span>
                        {%- endif -%}
                        {%- if item.quantity > 1 and section.settings.unit_price_text != blank -%}
                          {%- liquid
                            assign unit_money = item.final_price | money
                            assign unit_line = section.settings.unit_price_text | replace: amount_placeholder, unit_money
                          -%}
                          <span class="price price--unit">{{ unit_line }}</span>
                        {%- endif -%}
                        {%- endif -%}
                      </div></div>
                    </div>
                  </div>
                </div>
              </div>
              {%- liquid
                comment
                  The next-tier nudge (snippets/cart-drawer-nudge.liquid), under one-time bundle rows
                  only: on a subscription the bottle count also sets how often it renews (KACHING_DEAL
                  in assets/main.js), which a "Make it 3" button would change without saying so.
                endcomment
                if is_bundle and row_plan == blank
                  capture row_nudge
                    render 'cart-drawer-nudge', quantity: row_qty, unit: item.original_price, order_keep: order_keep, free_one: section.settings.nudge_free_one, free_many: section.settings.nudge_free_many, save: section.settings.nudge_save, button: section.settings.nudge_button
                  endcapture
                  echo row_nudge
                  if row_nudge != blank
                    assign nudge_shown = true
                  endif
                  comment
                    The one-time bottles and the first one-time bundle, for the upgrade card below.
                  endcomment
                  assign onetime_total = onetime_total | plus: row_qty
                  if upgrade_item == blank
                    assign upgrade_item = item
                  endif
                endif
              -%}
            </line-item>
          {%- endfor -%}
          {%- endfor -%}
        </form>

        {%- liquid
          comment
            Add-ons: the "Products to recommend" list, without anything already in the cart or sold
            out. assets/main.js (expressGoal) orders them by the free express shipping goal after
            every render: below it, the ones that close the gap on their own lead, cheapest first,
            each saying so, under the goal heading; otherwise they run cheapest first under the
            routine heading. The price shown is the price of the variant the button adds - the one
            that test uses - scaled there by an order-level percentage code (data-order-keep).
            The upgrade card (snippets/cart-drawer-upgrade.liquid) leads when it applies and no
            next-tier nudge is showing.
          endcomment
          assign addon_count = 0
          for product in upsells
            assign addon_variant = product.selected_or_first_available_variant
            assign in_cart = false
            for item in cart.items
              if item.product_id == product.id
                assign in_cart = true
                break
              endif
            endfor
            if in_cart == false and addon_variant.available
              assign addon_count = addon_count | plus: 1
            endif
          endfor
          assign upgrade_card = ''
          if upgrade_item != blank and nudge_shown == false
            capture upgrade_card
              render 'cart-drawer-upgrade', item: upgrade_item, quantity: onetime_total, order_keep: order_keep, title: section.settings.upgrade_title, text: section.settings.upgrade_text, button: section.settings.upgrade_button
            endcapture
          endif
        -%}
        {%- if addon_count > 0 or upgrade_card != blank -%}
          <div class="mini-cart__recommendations">
            {{- upgrade_card -}}
            {%- if addon_count > 0 -%}
            <div class="mini-cart__recommendations-inner">
              <div class="s-mini-cart__rec-header">
                <p data-addon-heading data-heading="{{ section.settings.addon_heading | escape }}" data-heading-goal="{{ section.settings.addon_goal_heading | escape }}">{{ section.settings.addon_heading }}</p>
                <div class="s-mini-cart__rec-arrows">
                  <button type="button" class="s-mini-cart__rec-arrow s-mini-cart__rec-arrow--prev" data-rec-prev aria-label="Previous recommendation"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></button>
                  <button type="button" class="s-mini-cart__rec-arrow s-mini-cart__rec-arrow--next" data-rec-next aria-label="Next recommendation"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
                </div>
              </div>
              <div class="scroller" data-rec-scroller>
                <div class="mini-cart__recommendations-list" data-addon-list data-order-keep="{{ order_keep }}">
                  {%- for product in upsells -%}
                    {%- liquid
                      assign addon_variant = product.selected_or_first_available_variant
                      assign in_cart = false
                      for item in cart.items
                        if item.product_id == product.id
                          assign in_cart = true
                          break
                        endif
                      endfor
                      if in_cart or addon_variant.available == false
                        continue
                      endif
                    -%}
                    <div class="drawer__product" data-addon data-price="{{ addon_variant.price }}" data-index="{{ forloop.index0 }}">
                      <div class="drawer__product-image">
                        <a href="{{ routes.root_url }}#shop" data-scroll-to="shop" class="drawer__product-link">
                          {%- if product.featured_image != blank -%}
                            {{ product.featured_image | image_url: width: 200, height: 200, crop: 'center' | image_tag: class: 'drawer__product-image', alt: product.title, loading: 'lazy' }}
                          {%- endif -%}
                        </a>
                      </div>
                      <div class="drawer__product-content">
                        <a href="{{ routes.root_url }}#shop" data-scroll-to="shop" class="drawer__product-title">{{ product.title }}</a>
                        <div class="drawer__product-price"><strong>{{ addon_variant.price | money }}</strong></div>
                        {%- if section.settings.addon_goal_reason != blank -%}
                          <p class="drawer__product-reason" data-addon-reason hidden>{{ section.settings.addon_goal_reason }}</p>
                        {%- endif -%}
                        {%- form 'product', product, class: 'drawer__product-form js-ajax-add' -%}
                          <input type="hidden" name="id" value="{{ addon_variant.id }}">
                          <input type="hidden" name="quantity" value="1">
                          <button type="submit" class="drawer__product-button">{{ section.settings.upsell_button }}</button>
                        {%- endform -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <footer class="mini-cart__drawer-footer drawer__footer drawer__footer--tight drawer__footer--bordered" data-cart-footer{% if cart.item_count == 0 %} hidden{% endif %}>
      <div class="drawer__footer__content">
        {%- liquid
          comment
            Currency follows the storefront's current country, and the cart carries that currency
            through to checkout. The theme sets that country from Shopify's own GeoIP guess on a
            visitor's first page view (Theme settings > Localization), which is wrong often enough
            - a VPN, a corporate proxy, a trip - and the totals below are where the theme first
            spells the currency out, so offer the correction here instead of making the shopper
            hunt for the selector at the bottom of the footer. Submitting reloads the page, which
            is what /localization needs to re-price the cart.
          endcomment
          assign show_market_picker = false
          if section.settings.show_country_selector and localization.available_countries.size > 1
            assign show_market_picker = true
          endif
        -%}
        {%- if show_market_picker -%}
        <div class="s-mini-cart__market">
          {%- form 'localization', id: 'localization_form_cart', class: 's-mini-cart__market-form' -%}
            <label class="s-mini-cart__market-label" for="cart-country-selector">{{ section.settings.country_label }}</label>
            <div class="custom-select">
              <select id="cart-country-selector" class="custom-select__select" name="country_code" onchange="this.form.submit()">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endform -%}
        </div>
        {%- endif -%}
        <div class="drawer__footer-total-info">
          {%- if cart.total_discount > 0 -%}
          <div class="total-info__row total-info__row--savings">
            <span class="total-info__label">{{ section.settings.discount_label }}</span>
            <span class="total-info__price total-info__price--savings">- <span class="product_price">{{ cart.total_discount | money }}</span></span>
          </div>
          {%- endif -%}
          <div class="total-info__row total-info__row--estimated">
            <span class="total-info__label">{{ section.settings.subtotal_label }}</span>
            <span class="total-info__prices"><span class="total-info__price total-info__price--highlight"><span class="product_price">{% if settings.currency_code_enable %}{{ cart.total_price | money_with_currency }}{% else %}{{ cart.total_price | money }}{% endif %}</span></span></span>
          </div>
        </div>
        <button form="mini-cart-form" type="submit" class="checkout-button button button--primary button--full" name="checkout">
          <span class="checkout-button__lock"><svg aria-hidden="true" width="16" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
          <span class="checkout-button__label">{{ section.settings.checkout_label }}</span>{% if section.settings.show_total_on_button %} - <span class="product_price">{{ cart.total_price | money }}</span>{% endif %}
        </button>
        {%- comment -%}
          The payment methods checkout accepts, read from the store's payment settings, so the strip
          follows whatever is switched on there. The drawer has no accelerated checkout buttons under
          the button (Shop Pay stays off as a drawer button), so the strip sits right under it.
        {%- endcomment -%}
        {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="cart-drawer__payment-icons" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
          {%- endfor -%}
        </ul>
        {%- endif -%}
        {%- if badges.size > 0 -%}
        <div class="s-mini-cart__guarantee-badges">
          {%- for block in badges -%}
            <div class="s-mini-cart__guarantee-badge" {{ block.shopify_attributes }}>
              <div class="s-mini-cart__badge-icon">
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 64 | image_tag: alt: '', loading: 'lazy' }}
                {%- else -%}
                  {%- case block.settings.default_icon -%}
                    {%- when 'bag' -%}
                      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h12l1 13H5L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                    {%- when 'truck' -%}
                      <svg aria-hidden="true" width="24" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
                    {%- else -%}
                      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M14.5 9.5c0-1-1.1-1.5-2.5-1.5S9.5 8.6 9.5 9.8c0 2.4 5 1.2 5 3.9 0 1.2-1.1 1.8-2.5 1.8s-2.5-.6-2.5-1.6"/></svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>
              <span>{{ block.settings.text | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' }}</span>
            </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>
    </footer>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Cart" },
    { "type": "header", "content": "Free express shipping goal", "info": "Standard shipping is always free and Express Shipping is free from the amount below. The bar compares it with the order total after discounts, converted into the shopper's currency, and orders the add-ons by it." },
    { "type": "checkbox", "id": "show_shipping_bar", "label": "Show the free express shipping goal", "default": true },
    { "type": "number", "id": "express_free_threshold", "label": "Free express shipping from (USD)", "default": 50, "info": "Must match the free-over amount on the Express Shipping rate in Shopify shipping settings." },
    { "type": "text", "id": "express_progress_text", "label": "Text below the amount", "default": "You’re {amount} away from FREE express shipping", "info": "{amount} is what is left to spend, in the shopper's currency." },
    { "type": "text", "id": "express_standard_text", "label": "Line under it", "default": "Standard shipping is always free", "info": "Shown below the amount only. Leave empty to hide." },
    { "type": "text", "id": "express_unlocked_text", "label": "Text once reached", "default": "You’ve unlocked FREE express shipping\u00a0✓" },
    { "type": "header", "content": "Empty cart" },
    { "type": "text", "id": "reviews_banner", "label": "Reviews banner", "default": "RATED 4.77/5 BY VERIFIED CUSTOMERS", "info": "Shown with five stars under the shipping bar. Leave empty to hide." },
    { "type": "text", "id": "empty_title", "label": "Empty cart title", "default": "Your cart is empty" },
    { "type": "text", "id": "empty_text", "label": "Empty cart text", "info": "Optional line under the title." },
    { "type": "product", "id": "empty_product", "label": "Bestseller to suggest", "info": "Falls back to the first recommended product below." },
    { "type": "text", "id": "from_label", "label": "Price prefix", "default": "From" },
    { "type": "text", "id": "empty_add_label", "label": "Add button label", "default": "+ Add To Cart" },
    { "type": "header", "content": "Line items" },
    { "type": "checkbox", "id": "show_subscribe_toggle", "label": "Show subscribe & save toggle on line items", "default": true },
    { "type": "text", "id": "selling_plan_id", "label": "Subscription plan ID", "info": "Optional. The plan the line toggle switches a one-time line to. Use the same ID as the Featured product section so the drawer sells the cadence the buy box promised. Leave blank to use the cheapest plan the variant offers." },
    { "type": "text", "id": "subscribe_label", "label": "Subscribe toggle label", "default": "SUBSCRIBE & SAVE" },
    { "type": "text", "id": "subscribe_saving_text", "label": "Saving shown next to the toggle", "default": "Save {amount}", "info": "{amount} is what the plan takes off everything the shopper is paying for that product (all its lines, a free bundle bottle counting for nothing). Leave empty to show no amount." },
    { "type": "text", "id": "free_tag_text", "label": "Free bottles tag on a bundle row", "default": "{count} FREE", "info": "The Bundled product (Theme settings → Bundle tiers) shows as one row per bundle, priced at its total. {count} is the number of bottles the cart charges nothing for. Leave empty to hide the tag." },
    { "type": "text", "id": "unit_price_text", "label": "Unit price under a line total", "default": "{amount} each", "info": "Lines show their total; with more than one unit this line follows underneath. Leave empty to hide it." },
    { "type": "header", "content": "Next-tier nudge", "info": "Shown under a one-time bundle row when the next tier in Theme settings → Bundle tiers costs the same as the bottles in the cart or less (2 bottles cost what 3 do, 5 cost more than 6). Its button tops the row up to that tier. {count} is the number of bottles to add, {amount} what the order total drops by, {total} the tier's bottle count." },
    { "type": "text", "id": "nudge_free_one", "label": "One more bottle, free", "default": "Add {count} more bottle — it’s free" },
    { "type": "text", "id": "nudge_free_many", "label": "More bottles, free", "default": "Add {count} more bottles — they’re free" },
    { "type": "text", "id": "nudge_save", "label": "More bottles for less", "default": "Add {count} more and pay {amount} less" },
    { "type": "text", "id": "nudge_button", "label": "Button", "default": "Make it {total}" },
    { "type": "header", "content": "Free subscription gift", "info": "The gift the Featured product section advertises with Subscribe & save. It is added to the cart (one unit, tagged as a free gift) as soon as a line on the plan above is in the cart, and removed when the last such line goes. The shopper can raise its quantity: the first one is free, the rest are charged. The theme cannot make it $0 on its own: in Kaching Subscriptions, add this product as a free gift (quantity 1) on the plan above, so the cart and checkout charge nothing for the first one." },
    { "type": "product", "id": "gift_product", "label": "Gift product", "info": "Pick the same product as Featured product → Free subscription gift. Leave empty to add nothing." },
    { "type": "text", "id": "gift_label", "label": "Gift line label", "default": "FREE GIFT" },
    { "type": "text", "id": "gift_free_text", "label": "Price shown once the gift is free", "default": "FREE" },
    { "type": "text", "id": "gift_extra_text", "label": "Note when extras are added", "default": "First one free · extras full price", "info": "Shown under the gift label once the shopper has more than one and the first is free." },
    { "type": "header", "content": "Add-ons", "info": "The products below, without any already in the cart or sold out. Below the free express shipping goal, those that reach it on their own lead (cheapest first) under the first heading, each with the line below; otherwise they run cheapest first under the second heading." },
    { "type": "product_list", "id": "upsells", "label": "Products to recommend", "limit": 6 },
    { "type": "text", "id": "addon_goal_heading", "label": "Heading while one reaches the goal", "default": "Add one to get FREE express shipping" },
    { "type": "text", "id": "addon_goal_reason", "label": "Line on each product that reaches it", "default": "Unlocks free express shipping" },
    { "type": "text", "id": "addon_heading", "label": "Heading otherwise", "default": "Complete your routine" },
    { "type": "text", "id": "upsell_button", "label": "Add button label", "default": "ADD TO CART" },
    { "type": "header", "content": "Upgrade card", "info": "Leads the add-ons once the free express shipping goal is met, when the one-time bottles in the cart are exactly a bundle tier other than the smallest and a bigger tier exists (3 bottles: the 6-month supply). Not shown while a next-tier nudge is. {supply} is the bigger tier's supply line, {amount} what it adds to the order, {count} the bottles it adds, {price} the price per bottle and {total} its bottle count." },
    { "type": "text", "id": "upgrade_title", "label": "Title", "default": "Upgrade to {supply}" },
    { "type": "text", "id": "upgrade_text", "label": "Text", "default": "+{amount} for {count} more bottles · {price} a bottle" },
    { "type": "text", "id": "upgrade_button", "label": "Button", "default": "Make it {total}" },
    { "type": "header", "content": "Footer" },
    { "type": "checkbox", "id": "show_country_selector", "label": "Show country / currency selector", "default": true, "info": "Lets a shopper whose country Shopify guessed from their IP switch before checkout - the cart keeps its currency all the way through. Only appears when more than one market is enabled." },
    { "type": "text", "id": "country_label", "label": "Country selector label", "default": "Ship to" },
    { "type": "text", "id": "discount_label", "label": "Discount row label", "default": "DISCOUNT" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal row label", "default": "SUBTOTAL" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button label", "default": "SECURE CHECKOUT" },
    { "type": "checkbox", "id": "show_total_on_button", "label": "Show total on the checkout button", "default": true }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        { "type": "select", "id": "default_icon", "label": "Icon", "options": [ { "value": "dollar", "label": "Money-back" }, { "value": "bag", "label": "Bag" }, { "value": "truck", "label": "Shipping" } ], "default": "dollar" },
        { "type": "image_picker", "id": "icon", "label": "Custom icon", "info": "Optional, about 64 × 64 px. Overrides the icon above." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>30-Day<br>Money-Back</p>" }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
