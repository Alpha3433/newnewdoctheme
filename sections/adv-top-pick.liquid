{% comment %}
  Comparison advertorial – "Our top pick" summary near the top of the article: product photo,
  name, star rating and score, reason blocks with ticks and a button that scrolls on (to the
  comparison table or the buy box). Photo and name come from the product unless overridden.
{% endcomment %}
{{ 'advertorial.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign product = section.settings.product
  assign name = section.settings.name | default: product.title
  assign btn_href = section.settings.button_url | default: '#shop'
-%}
<section class="adv adv--{{ section.settings.background }}" id="adv-{{ section.id }}">
  <div class="adv__read">
    <div class="adv-pick">
      {%- if section.settings.ribbon != blank -%}<span class="adv-pick__ribbon">{{ section.settings.ribbon }}</span>{%- endif -%}
      <div class="adv-pick__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 520 | image_tag: alt: name, loading: 'lazy', sizes: '260px' }}
        {%- elsif product.featured_image != blank -%}
          {{ product.featured_image | image_url: width: 520 | image_tag: alt: name, loading: 'lazy', sizes: '260px' }}
        {%- endif -%}
      </div>
      <div>
        <h2 class="adv-pick__title">{{ name }}</h2>
        <p class="adv-pick__rating">
          {%- render 'adv-stars', rating: section.settings.rating -%}
          {%- if section.settings.rating_text != blank -%}<span>{{ section.settings.rating_text }}</span>{%- endif -%}
          {%- if section.settings.score != blank -%}<span class="adv-pick__score">{{ section.settings.score }}</span>{%- endif -%}
        </p>
        {%- if section.blocks.size > 0 -%}
          <ul class="adv-pick__list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{%- render 'adv-mark', value: 'yes' -%}<span>{{ block.settings.text }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="adv-btn adv-btn--full" href="{{ btn_href }}"{% if btn_href contains '#' %} data-scroll-to="{{ btn_href | split: '#' | last }}"{% endif %}>
            {{ section.settings.button_label }} <span class="adv-btn__arrow" aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Top pick summary",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "tint", "label": "Mauve tint" } ], "default": "white" },
    { "type": "text", "id": "ribbon", "label": "Ribbon", "default": "Our #1 pick" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Photo override", "info": "Square, about 520 × 520 px. The product's main photo is used when empty." },
    { "type": "text", "id": "name", "label": "Name override", "info": "The product title is used when empty." },
    { "type": "text", "id": "rating", "label": "Star rating (out of 5)", "default": "4.77" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.77/5 from verified buyers" },
    { "type": "text", "id": "score", "label": "Score badge", "default": "9.8/10" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See how it compares" },
    { "type": "text", "id": "button_url", "label": "Button link", "default": "#comparison", "info": "#comparison scrolls to the table, #shop to the buy box. A full URL also works." }
  ],
  "blocks": [
    { "type": "reason", "name": "Reason", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Cold-pressed pumpkin seed oil with a Caffeine Complex" } ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Top pick summary", "blocks": [ { "type": "reason" } ] } ]
}
{% endschema %}
