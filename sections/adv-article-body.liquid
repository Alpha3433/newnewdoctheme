{% comment %}
  Comparison advertorial – article copy in the reading column. Everything is a block: story box
  (coral bar on the left), key-insight banner, heading, paragraph, photo, button and footnote.
  Add the section as many times as the article needs between the other sections.
{% endcomment %}
{{ 'advertorial.css' | asset_url | stylesheet_tag }}
<section class="adv{% if section.settings.flush_top %} adv--flush-top{% endif %}{% if section.settings.flush_bottom %} adv--flush-bottom{% endif %}"{% if section.settings.anchor != blank %} data-anchor="{{ section.settings.anchor | handle }}"{% endif %} id="adv-{{ section.id }}">
  <div class="adv__read">
    {%- if section.settings.rule -%}<hr class="adv__rule">{%- endif -%}
    <div class="adv-body">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'story' -%}
            <div class="adv-story" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'insight' -%}
            <div class="adv-insight" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}<span class="adv-insight__label">{{ block.settings.label }}</span>{%- endif -%}
              <p class="adv-insight__text">{{ block.settings.text }}</p>
            </div>
          {%- when 'heading' -%}
            <h2 class="adv-body__heading" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
          {%- when 'text' -%}
            <div class="adv-rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'image' -%}
            {%- liquid
              assign photo = block.settings.image
              if photo == blank
                assign photo = block.settings.product.featured_image
              endif
            -%}
            {%- if photo != blank -%}
              <figure class="adv-body__figure" {{ block.shopify_attributes }}>
                {{ photo | image_url: width: 1520 | image_tag: alt: block.settings.alt, loading: 'lazy', sizes: '(min-width: 800px) 760px, 100vw', widths: '400, 600, 800, 1000, 1200, 1520' }}
                {%- if block.settings.caption != blank -%}<figcaption class="adv-body__caption">{{ block.settings.caption }}</figcaption>{%- endif -%}
              </figure>
            {%- endif -%}
          {%- when 'button' -%}
            {%- render 'adv-cta', lead: block.settings.lead, label: block.settings.label, url: block.settings.url, note: block.settings.note, attrs: block.shopify_attributes -%}
          {%- when 'footnote' -%}
            <div class="adv-body__footnote" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Article text",
  "tag": "section",
  "class": "shopify-section--adv",
  "settings": [
    { "type": "checkbox", "id": "rule", "label": "Line above this section", "default": false },
    { "type": "checkbox", "id": "flush_top", "label": "No space above", "default": false },
    { "type": "checkbox", "id": "flush_bottom", "label": "No space below", "default": false },
    { "type": "text", "id": "anchor", "label": "Anchor name", "info": "Optional. Links to #name scroll here." }
  ],
  "blocks": [
    { "type": "story", "name": "Story box", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p><strong>Your hair is thinning.</strong> Nothing has worked.</p>" } ] },
    {
      "type": "insight",
      "name": "Key insight",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Key insights" },
        { "type": "inline_richtext", "id": "text", "label": "Statement", "default": "The formula is what actually matters." }
      ]
    },
    { "type": "heading", "name": "Heading", "settings": [ { "type": "inline_richtext", "id": "text", "label": "Heading", "info": "Italic text shows in coral.", "default": "Heading" } ] },
    { "type": "text", "name": "Paragraph", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Write the article copy here.</p>" } ] },
    {
      "type": "image",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Landscape, about 1520 × 860 px." },
        { "type": "product", "id": "product", "label": "Or use a product photo", "info": "Its main photo is shown when no photo is uploaded." },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "lead", "label": "Line above the button", "info": "Optional, for example: Still reading?" },
        { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
        { "type": "text", "id": "url", "label": "Link", "default": "#shop", "info": "#shop scrolls to the buy box on this page." },
        { "type": "text", "id": "note", "label": "Guarantee line", "default": "30-day money-back guarantee" }
      ]
    },
    { "type": "footnote", "name": "Footnote", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>*Footnote.</p>" } ] }
  ],
  "presets": [ { "name": "Article text", "blocks": [ { "type": "heading" }, { "type": "text" } ] } ]
}
{% endschema %}
