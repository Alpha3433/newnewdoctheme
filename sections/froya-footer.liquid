{% comment %}
  Footer – guarantee headline, manifesto, link list, contact block, social links, payment icons,
  disclaimer and Shopify's country/language selectors. Everything is editable in the theme editor.
  The wrapper id is kept so the verbatim CSS in assets/sections-inline.css still applies.
{% endcomment %}
{%- liquid
  assign links = section.blocks | where: 'type', 'link'
-%}
<div class="shopify-section shopify-section--footer" id="shopify-section-footer"><footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__item-list"><div class="footer__item footer__item--guarantee-poem is-first"><div class="flex h100 column">
          <h3 class="footer-headline white-text">{{ section.settings.headline }}</h3>
          <div class="white-text">{{ section.settings.manifesto }}</div>
        </div></div>
        <div class="footer__item footer__item--links"><p class="footer__item-title">{{ section.settings.links_title }}</p>
          <div class="footer__item-content">
            <ul class="linklist list--unstyled" role="list">
              {%- for block in links -%}
                <li class="linklist__item" {{ block.shopify_attributes }}><a class="link--faded" href="{{ block.settings.url | default: '/' }}">{{ block.settings.label }}</a></li>
              {%- endfor -%}
            </ul>
          </div></div>
        <div class="footer__item footer__item--text"><p class="footer__item-title">{{ section.settings.contact_title }}</p><div class="footer__item-content">{{ section.settings.contact_text }}</div></div>
        <div class="footer__item footer__item--social-media"><p class="footer__item-title">{{ section.settings.social_title }}</p><ul class="social-media list--unstyled" role="list">
          {%- if section.settings.facebook_url != blank -%}
          <li class="social-media__item social-media__item--facebook">
            <a aria-label="Follow us on Facebook" class="social-media__link" href="{{ section.settings.facebook_url }}" rel="noopener" target="_blank">
              <picture>{%- render 'froya-image', image: section.settings.facebook_icon, fallback: 'https://froyaorganics.com/cdn/shop/files/social_media_icons-02.svg', alt: 'Facebook', width: 29, height: 29 -%}</picture>
            </a>
          </li>
          {%- endif -%}
          {%- if section.settings.instagram_url != blank -%}
          <li class="social-media__item social-media__item--instagram">
            <a aria-label="Follow us on Instagram" class="social-media__link" href="{{ section.settings.instagram_url }}" rel="noopener" target="_blank">
              <picture>{%- render 'froya-image', image: section.settings.instagram_icon, fallback: 'https://froyaorganics.com/cdn/shop/files/social_media_icons-03.svg', alt: 'Instagram', width: 29, height: 29 -%}</picture>
            </a>
          </li>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
          <li class="social-media__item social-media__item--tiktok">
            <a aria-label="Follow us on TikTok" class="social-media__link" href="{{ section.settings.tiktok_url }}" rel="noopener" target="_blank">
              <picture>{%- render 'froya-image', image: section.settings.tiktok_icon, fallback: 'https://froyaorganics.com/cdn/shop/files/social_media_icons-04.svg', alt: 'TikTok', width: 29, height: 29 -%}</picture>
            </a>
          </li>
          {%- endif -%}
        </ul></div>
      </div>
    </div>
  </div>
  <div class="footer__aside">
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
    <div class="payment-methods">
      <ul class="payment-methods__list">
        {%- for type in shop.enabled_payment_types -%}
          <li class="payment-methods__icon">{{ type | payment_type_svg_tag: class: 'payment-methods__svg' }}</li>
        {%- endfor -%}
      </ul>
    </div>
    {%- endif -%}
  </div>
  {%- if section.settings.disclaimer != blank -%}
  <div class="disclaimer-container">
    <div class="disclaimer-content white-text">{{ section.settings.disclaimer }}</div>
  </div>
  {%- endif -%}
  {%- liquid
    assign show_localization = false
    if section.settings.show_localization
      if localization.available_countries.size > 1 or localization.available_languages.size > 1
        assign show_localization = true
      endif
    endif
  -%}
  {%- if show_localization -%}
  <div class="footer__legacy-selectors">
    {%- form 'localization', id: 'localization_form_footer', class: 'shopify-localization-form' -%}
      {%- if localization.available_countries.size > 1 -%}
      <div class="custom-select">
        <select aria-label="Country/region" class="custom-select__select" name="country_code" onchange="this.form.submit()">
          {%- for country in localization.available_countries -%}
            <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
          {%- endfor -%}
        </select>
      </div>
      {%- endif -%}
      {%- if localization.available_languages.size > 1 -%}
      <div class="custom-select">
        <select aria-label="Language" class="custom-select__select" name="locale_code" onchange="this.form.submit()">
          {%- for language in localization.available_languages -%}
            <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
          {%- endfor -%}
        </select>
      </div>
      {%- endif -%}
    {%- endform -%}
  </div>
  {%- endif -%}
</footer></div>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "inline_richtext", "id": "headline", "label": "Guarantee headline", "default": "Not satisfied?<br>Get your money<br>back in 90 days" },
    { "type": "richtext", "id": "manifesto", "label": "Manifesto", "default": "<p>Hair loss isn’t just about hair.<br>It’s the photo you didn’t post,<br>the ponytail that keeps getting thinner,<br>the mirror you stopped looking in.<br><br>We’ve been where you are.<br>So we went back to the research,<br>found what actually works,<br>and put it in a bottle made for you.<br><br>Cold-pressed pumpkin seed oil.<br>A Caffeine Complex that wakes the root.<br>Two minutes a night, every night.<br>And 10% of every order to hair-loss research.</p>" },
    { "type": "text", "id": "links_title", "label": "Links column title", "default": "About" },
    { "type": "text", "id": "contact_title", "label": "Contact column title", "default": "Contact" },
    { "type": "richtext", "id": "contact_text", "label": "Contact details", "default": "<p><strong>Customer Support</strong><br>support@shopelaren.com</p><p><strong>Address</strong><br>Elaren<br>5 Clarke Street, Prahran VIC 3181, Australia</p><p><strong>Shipping</strong><br>Free insured shipping on every order. Free express shipping on orders over $50.</p><p><br>© 2026 Elaren.<br>All Rights Reserved.</p>" },
    { "type": "header", "content": "Social" },
    { "type": "text", "id": "social_title", "label": "Social column title", "default": "Follow us" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "image_picker", "id": "facebook_icon", "label": "Facebook icon", "info": "About 29 × 29 px, white on transparent." },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "image_picker", "id": "instagram_icon", "label": "Instagram icon" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "image_picker", "id": "tiktok_icon", "label": "TikTok icon" },
    { "type": "header", "content": "Bottom" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "Show country / language selectors", "default": true, "info": "Only appears when more than one market or language is enabled." },
    { "type": "richtext", "id": "disclaimer", "label": "Disclaimer", "default": "<p>Disclaimer: Elaren Pumpkin Seed Regrowth Oil is a cosmetic scalp treatment, not a medicine, and is not intended to diagnose, treat, cure or prevent any disease, including alopecia areata or other medical conditions. Studies referenced were conducted on the ingredients, not on this finished product. Individual results vary and depend on the cause of hair loss and consistent nightly use: most customers notice reduced shedding within the first weeks and fuller-looking hair after 90 days. If you are pregnant, breastfeeding or under medical treatment for hair loss, check with your doctor first. Not seeing results? Contact support@shopelaren.com within 90 days of purchase for a full refund.</p>" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop all" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 30
}
{% endschema %}
