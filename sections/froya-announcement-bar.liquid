{% comment %}
  Announcement bar – the message is editable in the theme editor.
  The wrapper id is kept so the verbatim CSS in assets/sections-inline.css still applies.
{% endcomment %}
<div class="shopify-section shopify-section-group-header-group shopify-section--announcement-bar" id="shopify-section-sections--26717504897391__announcement-bar">
<section class="bw-slider-bar">
  <announcement-bar class="announcement-bar"><div class="announcement-bar__list"><announcement-bar-item class="announcement-bar__item"><div class="announcement-bar__message text--small"><div>
    <p>{%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{%- else -%}{{ section.settings.text }}{%- endif -%}</p>
  </div></div></announcement-bar-item></div></announcement-bar>
</section>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "inline_richtext", "id": "text", "label": "Message", "default": "FREE INSURED SHIPPING 🌱 90-DAY MONEY-BACK GUARANTEE" },
    { "type": "url", "id": "link", "label": "Link (optional)" }
  ]
}
{% endschema %}
